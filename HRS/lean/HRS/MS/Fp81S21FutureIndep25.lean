import HRS.MS.Fp81S21FutureIndep24
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut

set_option autoImplicit false
set_option maxHeartbeats 400000
noncomputable section
open MeasureTheory ProbabilityTheory Filter Topology Set Classical
open scoped ENNReal NNReal BigOperators
namespace HRS.Fp81.S21

/-- Conditional factorization for any integrable increment measurable with
respect to the sigma-algebra generated by the complete retained past source. -/
theorem fp81s21_independent_future_conditional
    {Ω A B : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace A] [MeasurableSpace B]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (past : Ω → A) (future : Ω → B) (hpast : Measurable past) (hfuture : Measurable future)
    (hind : IndepFun past future P) (γ : Measure B) (hlaw : P.map future = γ)
    (f : B → ℝ) (hf : Measurable f) (C : ℝ) (hC : ∀ x, ‖f x‖ ≤ C)
    (D : Ω → ℝ) (hD : Integrable D P)
    (hDpast : AEStronglyMeasurable[MeasurableSpace.comap past inferInstance] D P) :
    Integrable (fun ω => D ω * f (future ω)) P ∧
    P[fun ω => D ω * f (future ω) | MeasurableSpace.comap past inferInstance] =ᵐ[P]
      fun ω => D ω * ∫ x, f x ∂γ := by
  let mPast : MeasurableSpace Ω := MeasurableSpace.comap past inferInstance
  let mFuture : MeasurableSpace Ω := MeasurableSpace.comap future inferInstance
  let g : Ω → ℝ := fun ω => f (future ω)
  have hgm : @Measurable Ω ℝ mΩ _ g := hf.comp hfuture
  have hgmPast : StronglyMeasurable[mFuture] g :=
    (hf.comp (comap_measurable future)).stronglyMeasurable
  have hg : Integrable g P := by
    refine (integrable_const C).mono' hgm.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall fun ω => by simpa [g] using hC (future ω)
  have hDg : Integrable (fun ω => D ω * g ω) P := by
    simpa only [mul_comm] using
      hD.bdd_mul hgm.aestronglyMeasurable (Filter.Eventually.of_forall fun ω => hC (future ω))
  have hInd : Indep mFuture mPast P := ((IndepFun_iff_Indep past future P).1 hind).symm
  have hcond : P[g | mPast] =ᵐ[P] fun _ => ∫ ω, g ω ∂P :=
    condExp_indep_eq hfuture.comap_le hpast.comap_le hgmPast hInd
  have hmul : P[(fun ω => D ω * g ω) | mPast] =ᵐ[P] D * P[g | mPast] :=
    condExp_mul_of_aestronglyMeasurable_left hDpast hDg hg
  have hIntegral : (∫ ω, g ω ∂P) = ∫ x, f x ∂γ := by
    rw [← hlaw]
    exact (integral_map hfuture.aemeasurable hf.aestronglyMeasurable).symm
  refine ⟨hDg, ?_⟩
  filter_upwards [hmul, hcond] with ω hmulω hcondω
  simpa [g, hIntegral] using hmulω.trans (congrArg (D ω * ·) hcondω)

#print axioms fp81s21_independent_future_conditional
end HRS.Fp81.S21
end
