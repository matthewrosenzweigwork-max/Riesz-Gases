import HRS.MS.LcFlowAux1
import HRS.Stochastic.Brownian
import HRS.Stochastic.Filtration
import HRS.Stochastic.BDG
import HRS.MD.EQLawPath1

/-!
# LC-3, part 1: the time-changed noise `lcNoise`, its path/independence/Gaussian structure,
measurability of the running supremum, and the pathwise bound for `lcU`

Setting (supplement S4.11/S4.12, "engine").  `W : ℝ≥0 → Ω → Fin d → ℝ` is a Brownian filtration
(`IsBrownianFiltration P ℱ W`), `ν : ℝ → ℝ` continuous with `0 ≤ ν`.  The time change is
`lcTau ν v = ∫_0^v 2 ν` and the noise is `lcNoise W ν v ω = W_{τ(v)}(ω)` (with `τ(v)` replaced by
`0` for `τ(v) < 0`, i.e. `Real.toNNReal`).  Since `W` is a Brownian motion this is a continuous
process starting at `0` with independent Gaussian increments of variance `τ(v) - τ(u)`; no Wiener
integral is needed.

Contents.
* `lc_noise_cont`, `lc_noise_zero`: continuity of every path and `G_0 = 0`.
* `lc_noise_indep`: for `u ≤ v` the increment `G_v - G_u` is independent of the time-changed
  filtration `ℱ_{τ(u)}` and hence of `σ(G_s : 0 ≤ s ≤ u)` (`lcNoisePast`).
* `lc_noise_law`: for `0 ≤ u ≤ v` the increment is `N(0, (τ v - τ u) I)`, its coordinates are
  independent `N(0, τ v - τ u)`, with second moments `τ v - τ u`; `lc_noise_cov` gives the covariance.
* `lc_noise_shift`: for `r ≥ 0` the path restarted at `r`, `s ↦ G_{r+s} - G_r`, is again of the same
  form: it equals `lcNoise W' ν'` with `W' = W_{τ(r)+·} - W_{τ(r)}` a Brownian filtration
  (`isBrownianFiltration_shift`) and `ν' = ν(r + ·)`.
* `lc_measurable_sup_norm`, `lc_noise_sup_measurable`: `ω ↦ ⨆ v ∈ Icc 0 T, ‖G v ω‖` is measurable
  (continuity plus a countable dyadic grid).
* `lc_U_bound`, `lc_U_sup_bound`, `lcKappa_le`: pathwise bound `‖lcU Q g r v‖ ≤ C(Q,T) sup_{[0,T]}‖g‖`
  (and for `κ = sup_{r ≤ v ≤ T}‖lcU‖`), deterministic.

Statement adjustments relative to the plan sketch: the hypotheses on `ν` are the global ones of
`HRS.Whole.local_decay` (`ν` continuous, `0 ≤ ν`, `ν ≤ ν*` for all arguments); `lcNoise` takes values
in `Fin d → ℝ` and `lcNoiseE` in `Euc d` (the type of the noise path of `lcFlow`); the Gaussian law of
increments needs `0 ≤ u` (for `u < 0` the clamped time `max (τ u) 0` breaks the variance formula).
Helper lemmas carry the prefix `lc3_`.
-/

open MeasureTheory Set Filter Topology ProbabilityTheory
open scoped NNReal ENNReal
open HRS HRS.MD.EQLawPath

noncomputable section

namespace HRS.MS.Lc

variable {d : ℕ} {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ### Definitions -/

/-- The time change `τ(v) = ∫_0^v 2 ν`. -/
def lcTau (ν : ℝ → ℝ) (v : ℝ) : ℝ := ∫ u in (0 : ℝ)..v, 2 * ν u

/-- The time-changed noise `G_v = W_{τ(v)}` (a path in `Fin d → ℝ`). -/
def lcNoise (W : ℝ≥0 → Ω → Fin d → ℝ) (ν : ℝ → ℝ) (v : ℝ) (ω : Ω) : Fin d → ℝ :=
  fun k => W (lcTau ν v).toNNReal ω k

/-- The same noise as a path in `Euc d`, the type of the noise path `g` of `lcFlow`. -/
def lcNoiseE (W : ℝ≥0 → Ω → Fin d → ℝ) (ν : ℝ → ℝ) (v : ℝ) (ω : Ω) : Euc d :=
  WithLp.toLp 2 (lcNoise W ν v ω)

set_option warn.classDefReducibility false in
/-- The σ-algebra generated by the noise on `[0,u]`. -/
def lcNoisePast (W : ℝ≥0 → Ω → Fin d → ℝ) (ν : ℝ → ℝ) (u : ℝ) : MeasurableSpace Ω :=
  ⨆ s ∈ Icc (0 : ℝ) u, MeasurableSpace.comap (lcNoise W ν s) inferInstance

theorem lcNoise_eq (W : ℝ≥0 → Ω → Fin d → ℝ) (ν : ℝ → ℝ) (v : ℝ) (ω : Ω) :
    lcNoise W ν v ω = W (lcTau ν v).toNNReal ω := rfl

theorem lcNoise_eq_ofNNRealTime (W : ℝ≥0 → Ω → Fin d → ℝ) (ν : ℝ → ℝ) (v : ℝ) (ω : Ω) :
    lcNoise W ν v ω = ofNNRealTime W (lcTau ν v) ω := rfl

/-! ### The time change -/

theorem lcTau_zero (ν : ℝ → ℝ) : lcTau ν 0 = 0 := by simp [lcTau]

theorem lc3_integrable {ν : ℝ → ℝ} (hν : Continuous ν) (a b : ℝ) :
    IntervalIntegrable (fun u => 2 * ν u) volume a b :=
  (continuous_const.mul hν).intervalIntegrable a b

theorem lcTau_continuous {ν : ℝ → ℝ} (hν : Continuous ν) : Continuous (lcTau ν) :=
  intervalIntegral.continuous_primitive (fun a b => lc3_integrable hν a b) 0

theorem lcTau_sub {ν : ℝ → ℝ} (hν : Continuous ν) (u v : ℝ) :
    lcTau ν v - lcTau ν u = ∫ x in u..v, 2 * ν x := by
  unfold lcTau
  rw [sub_eq_iff_eq_add', intervalIntegral.integral_add_adjacent_intervals
    (lc3_integrable hν 0 u) (lc3_integrable hν u v)]

theorem lcTau_mono {ν : ℝ → ℝ} (hν : Continuous ν) (hν0 : ∀ x, 0 ≤ ν x) : Monotone (lcTau ν) := by
  intro u v huv
  have := lcTau_sub hν u v
  have h2 : 0 ≤ ∫ x in u..v, 2 * ν x :=
    intervalIntegral.integral_nonneg huv fun x _ => by have := hν0 x; positivity
  linarith

theorem lcTau_nonneg {ν : ℝ → ℝ} (hν : Continuous ν) (hν0 : ∀ x, 0 ≤ ν x) {v : ℝ} (hv : 0 ≤ v) :
    0 ≤ lcTau ν v := by
  have := lcTau_mono hν hν0 hv
  rwa [lcTau_zero] at this

theorem lcTau_sub_le {ν : ℝ → ℝ} {νs : ℝ} (hν : Continuous ν) (hνs : ∀ x, ν x ≤ νs) {u v : ℝ}
    (huv : u ≤ v) : lcTau ν v - lcTau ν u ≤ 2 * νs * (v - u) := by
  rw [lcTau_sub hν]
  have : ∫ x in u..v, 2 * ν x ≤ ∫ x in u..v, 2 * νs :=
    intervalIntegral.integral_mono_on huv (lc3_integrable hν u v)
      (continuous_const.intervalIntegrable _ _) fun x _ => by have := hνs x; linarith
  have e : ∫ x in u..v, 2 * νs = 2 * νs * (v - u) := by simp; ring
  linarith

theorem lcTau_le {ν : ℝ → ℝ} {νs : ℝ} (hν : Continuous ν) (hνs : ∀ x, ν x ≤ νs) {v : ℝ}
    (hv : 0 ≤ v) : lcTau ν v ≤ 2 * νs * v := by
  have := lcTau_sub_le hν hνs hv
  rwa [lcTau_zero, sub_zero, sub_zero] at this

/-! ### Paths, measurability, independence of the past -/

section Noise

variable {P : Measure Ω} {ℱ : Filtration ℝ mΩ} {W : ℝ≥0 → Ω → Fin d → ℝ} {ν : ℝ → ℝ}

theorem lc_noise_measurable (hW : IsBrownianFiltration P ℱ W) (v : ℝ) :
    Measurable (lcNoise W ν v) := hW.measurable _

theorem lc_noiseE_measurable (hW : IsBrownianFiltration P ℱ W) (v : ℝ) :
    Measurable (lcNoiseE W ν v) :=
  (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)).measurable.comp (hW.measurable _)

/-- **LC-3 (paths).**  Every path of the noise is continuous. -/
theorem lc_noise_cont (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν) (ω : Ω) :
    Continuous fun v => lcNoise W ν v ω :=
  continuous_pi fun k => (continuous_apply k).comp
    ((continuous_ofNNRealTime W ω (hW.cont ω)).comp (lcTau_continuous hν))

theorem lc_noiseE_cont (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν) (ω : Ω) :
    Continuous fun v => lcNoiseE W ν v ω :=
  (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)).comp (lc_noise_cont hW hν ω)

/-- The noise starts at `0`. -/
theorem lc_noise_zero (hW : IsBrownianFiltration P ℱ W) (ω : Ω) : lcNoise W ν 0 ω = 0 := by
  simp [lcNoise_eq, lcTau_zero, hW.zero]

theorem lc_noiseE_zero (hW : IsBrownianFiltration P ℱ W) (ω : Ω) : lcNoiseE W ν 0 ω = 0 := by
  simp [lcNoiseE, lc_noise_zero hW]

theorem lcNoisePast_le (hW : IsBrownianFiltration P ℱ W) {u : ℝ} (hν : Continuous ν)
    (hν0 : ∀ x, 0 ≤ ν x) :
    lcNoisePast W ν u ≤ ℱ (((lcTau ν u).toNNReal : ℝ≥0) : ℝ) := by
  refine iSup₂_le fun s hs => ?_
  have h1 : (lcTau ν s).toNNReal ≤ (lcTau ν u).toNNReal :=
    Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 hs.2)
  exact ((hW.adapted _).mono (ℱ.mono (by exact_mod_cast h1)) le_rfl).comap_le

/-- **LC-3 (independence).**  For `u ≤ v` the increment `G_v - G_u` is independent of the
time-changed filtration `ℱ_{τ(u)}` and of the σ-algebra generated by `G_s`, `0 ≤ s ≤ u`. -/
theorem lc_noise_indep (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν) (hν0 : ∀ x, 0 ≤ ν x)
    {u v : ℝ} (huv : u ≤ v) :
    Indep (MeasurableSpace.comap (fun ω => lcNoise W ν v ω - lcNoise W ν u ω) inferInstance)
      (ℱ (((lcTau ν u).toNNReal : ℝ≥0) : ℝ)) P ∧
    Indep (MeasurableSpace.comap (fun ω => lcNoise W ν v ω - lcNoise W ν u ω) inferInstance)
      (lcNoisePast W ν u) P := by
  have h := hW.indep_incr (lcTau ν u).toNNReal (lcTau ν v).toNNReal
    (Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 huv))
  exact ⟨h, indep_of_indep_of_le_right h (lcNoisePast_le hW hν hν0)⟩

/-- Independence of the increment from every random variable measurable for the past filtration. -/
theorem lc_noise_indepFun (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν)
    (hν0 : ∀ x, 0 ≤ ν x) {u v : ℝ} (huv : u ≤ v) {E : Type*} [MeasurableSpace E] {Z : Ω → E}
    (hZ : Measurable[ℱ (((lcTau ν u).toNNReal : ℝ≥0) : ℝ)] Z) :
    IndepFun (fun ω => lcNoise W ν v ω - lcNoise W ν u ω) Z P :=
  hW.indepFun_incr (Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 huv)) hZ

/-- The noise is adapted to the time-changed filtration: `G_s` is `ℱ_{τ(u)}`-measurable, `s ≤ u`. -/
theorem lc_noise_adapted (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν)
    (hν0 : ∀ x, 0 ≤ ν x) {s u : ℝ} (hsu : s ≤ u) :
    Measurable[ℱ (((lcTau ν u).toNNReal : ℝ≥0) : ℝ)] (lcNoise W ν s) := by
  have h1 : (lcTau ν s).toNNReal ≤ (lcTau ν u).toNNReal :=
    Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 hsu)
  exact (hW.adapted _).mono (ℱ.mono (by exact_mod_cast h1)) le_rfl

/-! ### Gaussian structure of the increments -/

theorem lc3_toNNReal_sub {a b : ℝ} (hb : 0 ≤ b) (hab : b ≤ a) :
    a.toNNReal - b.toNNReal = (a - b).toNNReal := by
  apply NNReal.eq
  rw [NNReal.coe_sub (Real.toNNReal_le_toNNReal hab), Real.coe_toNNReal _ (hb.trans hab),
    Real.coe_toNNReal _ hb, Real.coe_toNNReal _ (sub_nonneg.2 hab)]

/-- **LC-3 (law).**  For `0 ≤ u ≤ v` the increment `G_v - G_u` has law `N(0, (τ v - τ u) I)`; its
coordinates are independent with law `N(0, τ v - τ u)` and second moment `τ v - τ u`. -/
theorem lc_noise_law [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν)
    (hν0 : ∀ x, 0 ≤ ν x) {u v : ℝ} (hu : 0 ≤ u) (huv : u ≤ v) :
    HasLaw (fun ω => lcNoise W ν v ω - lcNoise W ν u ω)
      (Measure.pi fun _ : Fin d => gaussianReal 0 (lcTau ν v - lcTau ν u).toNNReal) P ∧
    (∀ k, HasLaw (fun ω => lcNoise W ν v ω k - lcNoise W ν u ω k)
      (gaussianReal 0 (lcTau ν v - lcTau ν u).toNNReal) P) ∧
    iIndepFun (fun (k : Fin d) ω => lcNoise W ν v ω k - lcNoise W ν u ω k) P ∧
    (∀ k, ∫ ω, (lcNoise W ν v ω k - lcNoise W ν u ω k) ^ 2 ∂P = lcTau ν v - lcTau ν u) := by
  have hmono : (lcTau ν u).toNNReal ≤ (lcTau ν v).toNNReal :=
    Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 huv)
  have hu0 := lcTau_nonneg hν hν0 hu
  have hle := lcTau_mono hν hν0 huv
  have e : (lcTau ν v).toNNReal - (lcTau ν u).toNNReal = (lcTau ν v - lcTau ν u).toNNReal :=
    lc3_toNNReal_sub hu0 hle
  have h1 := hW.gaussian_incr _ _ hmono
  rw [e] at h1
  refine ⟨h1, fun k => ?_, ?_, fun k => ?_⟩
  · have := hW.hasLaw_incr_coord hmono k
    rwa [e] at this
  · exact hW.iIndepFun_incr_coords hmono
  · have := hW.integral_incr_sq hmono k
    change ∫ ω, (W (lcTau ν v).toNNReal ω k - W (lcTau ν u).toNNReal ω k) ^ 2 ∂P = _
    rw [this, Real.coe_toNNReal _ (lcTau_nonneg hν hν0 (hu.trans huv)),
      Real.coe_toNNReal _ hu0]

/-- Covariance of the increment: `E (ΔG_k ΔG_l) = δ_{kl} (τ v - τ u)`. -/
theorem lc_noise_cov [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν)
    (hν0 : ∀ x, 0 ≤ ν x) {u v : ℝ} (hu : 0 ≤ u) (huv : u ≤ v) (k l : Fin d) :
    ∫ ω, (lcNoise W ν v ω k - lcNoise W ν u ω k) * (lcNoise W ν v ω l - lcNoise W ν u ω l) ∂P =
      if k = l then lcTau ν v - lcTau ν u else 0 := by
  have hmono : (lcTau ν u).toNNReal ≤ (lcTau ν v).toNNReal :=
    Real.toNNReal_le_toNNReal (lcTau_mono hν hν0 huv)
  by_cases hkl : k = l
  · subst hkl
    simp only [ite_true, ← sq]
    exact (lc_noise_law hW hν hν0 hu huv).2.2.2 k
  · simp only [hkl, ite_false]
    exact hW.integral_incr_mul_of_ne hmono hkl

/-- The value `G_v` itself: each coordinate is `N(0, τ v)` for `v ≥ 0`. -/
theorem lc_noise_law_coord [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W)
    {v : ℝ} (k : Fin d) :
    HasLaw (fun ω => lcNoise W ν v ω k) (gaussianReal 0 (lcTau ν v).toNNReal) P :=
  hW.hasLaw_coord _ k

/-! ### The restarted path -/

theorem lcTau_shift {ν : ℝ → ℝ} (hν : Continuous ν) (r s : ℝ) :
    lcTau ν (r + s) = lcTau ν r + lcTau (fun x => ν (r + x)) s := by
  have h1 := lcTau_sub hν r (r + s)
  have h2 : lcTau (fun x => ν (r + x)) s = ∫ x in r..r + s, 2 * ν x := by
    unfold lcTau
    simp
  rw [h2]; linarith

/-- **LC-3 (restart).**  For `r ≥ 0` the restarted noise path `s ↦ G_{r+s} - G_r`, `s ≥ 0`, is the
noise built from the shifted Brownian filtration `(ℱ_{τ(r)+·}, W_{τ(r)+·} - W_{τ(r)})` and the
shifted viscosity `ν(r + ·)`.  Hence every statement of this file holds for the restarted path. -/
theorem lc_noise_shift (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν) (hν0 : ∀ x, 0 ≤ ν x)
    {r : ℝ} (hr : 0 ≤ r) :
    IsBrownianFiltration P (shiftFil ℱ (lcTau ν r).toNNReal) (shiftProc W (lcTau ν r).toNNReal) ∧
    ∀ s : ℝ, 0 ≤ s → ∀ ω, lcNoise (shiftProc W (lcTau ν r).toNNReal) (fun x => ν (r + x)) s ω =
      lcNoise W ν (r + s) ω - lcNoise W ν r ω := by
  refine ⟨isBrownianFiltration_shift hW _, fun s hs ω => ?_⟩
  have hν' : Continuous fun x => ν (r + x) := hν.comp (continuous_const.add continuous_id)
  have hτ' := lcTau_nonneg hν' (fun x => hν0 _) hs
  have hτr := lcTau_nonneg hν hν0 hr
  funext k
  simp only [lcNoise_eq, shiftProc, Pi.sub_apply, lcTau_shift hν r s]
  rw [Real.toNNReal_add hτr hτ']

end Noise

/-! ### The running supremum of a continuous path -/

section Sup

variable {E : Type*} [NormedAddCommGroup E] {g : ℝ → E}

theorem lc3_bound (hg : Continuous g) (T : ℝ) : ∃ B : ℝ, 0 ≤ B ∧ ∀ v ∈ Icc (0 : ℝ) T, ‖g v‖ ≤ B := by
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := T)).exists_bound_of_continuousOn
    hg.continuousOn
  exact ⟨max B 0, le_max_right _ _, fun v hv => (hB v hv).trans (le_max_left _ _)⟩

theorem lc3_sup_nonneg (T : ℝ) : 0 ≤ ⨆ v ∈ Icc (0 : ℝ) T, ‖g v‖ :=
  Real.iSup_nonneg fun v => Real.iSup_nonneg fun _ => norm_nonneg _

theorem lc3_sup_le {T c : ℝ} (hc : 0 ≤ c) (h : ∀ v ∈ Icc (0 : ℝ) T, ‖g v‖ ≤ c) :
    ⨆ v ∈ Icc (0 : ℝ) T, ‖g v‖ ≤ c :=
  Real.iSup_le (fun v => Real.iSup_le (fun hv => h v hv) hc) hc

theorem lc3_le_sup (hg : Continuous g) {T w : ℝ} (hw : w ∈ Icc (0 : ℝ) T) :
    ‖g w‖ ≤ ⨆ v ∈ Icc (0 : ℝ) T, ‖g v‖ := by
  obtain ⟨B, hB0, hB⟩ := lc3_bound hg T
  have hbdd : BddAbove (range fun v => ⨆ (_ : v ∈ Icc (0 : ℝ) T), ‖g v‖) := by
    refine ⟨B, ?_⟩
    rintro _ ⟨v, rfl⟩
    exact Real.iSup_le (fun hv => hB v hv) hB0
  have := le_ciSup hbdd w
  rw [ciSup_pos hw] at this
  exact this

/-- The dyadic grid of `[0,T]` (constant `T` beyond the last point, so monotone in `j`). -/
def lc3Grid (T : ℝ) (n j : ℕ) : ℝ := T * ((min j (2 ^ n) : ℕ) : ℝ) / 2 ^ n

theorem lc3Grid_mem {T : ℝ} (hT : 0 ≤ T) (n j : ℕ) : lc3Grid T n j ∈ Icc (0 : ℝ) T := by
  have h2 : (0 : ℝ) < 2 ^ n := by positivity
  have hj : ((min j (2 ^ n) : ℕ) : ℝ) ≤ 2 ^ n := by exact_mod_cast min_le_right _ _
  refine ⟨by unfold lc3Grid; positivity, ?_⟩
  unfold lc3Grid
  rw [div_le_iff₀ h2]
  nlinarith

theorem lc3Grid_mono {T : ℝ} (hT : 0 ≤ T) (n : ℕ) : Monotone (lc3Grid T n) := by
  intro i j hij
  unfold lc3Grid
  have : ((min i (2 ^ n) : ℕ) : ℝ) ≤ ((min j (2 ^ n) : ℕ) : ℝ) := by
    exact_mod_cast min_le_min_right _ hij
  have h2 : (0 : ℝ) < 2 ^ n := by positivity
  gcongr

theorem lc3Grid_top (T : ℝ) (n : ℕ) : lc3Grid T n (2 ^ n) = T := by
  unfold lc3Grid
  rw [min_self]
  push_cast
  field_simp

theorem lc3Grid_double (T : ℝ) (n j : ℕ) (hj : j ≤ 2 ^ n) :
    lc3Grid T (n + 1) (2 * j) = lc3Grid T n j := by
  unfold lc3Grid
  have h1 : min (2 * j) (2 ^ (n + 1)) = 2 * j := min_eq_left (by rw [pow_succ]; omega)
  rw [h1, min_eq_left hj]
  push_cast
  rw [pow_succ]
  field_simp

theorem lc3_exists_grid {T t : ℝ} (hT : 0 ≤ T) (ht : t ∈ Icc (0 : ℝ) T) :
    ∃ k : ℕ → ℕ, Tendsto (fun n => lc3Grid T n (k n)) atTop (𝓝 t) := by
  rcases hT.eq_or_lt with h0 | hpos
  · subst h0
    have : t = 0 := le_antisymm ht.2 ht.1
    subst this
    exact ⟨fun _ => 0, by simp [lc3Grid]⟩
  · obtain ⟨k, hk0, -, hk⟩ := exists_dyadic_grid hpos ht
    refine ⟨k, ?_⟩
    refine hk.congr fun n => ?_
    simp [lc3Grid, min_eq_left (hk0 n)]

theorem lc3_sup_eq_grid {T : ℝ} (hT : 0 ≤ T) (hg : Continuous g) :
    ⨆ v ∈ Icc (0 : ℝ) T, ‖g v‖ = ⨆ p : ℕ × ℕ, ‖g (lc3Grid T p.1 p.2)‖ := by
  obtain ⟨B, hB0, hB⟩ := lc3_bound hg T
  have hbdd : BddAbove (range fun p : ℕ × ℕ => ‖g (lc3Grid T p.1 p.2)‖) :=
    ⟨B, by rintro _ ⟨p, rfl⟩; exact hB _ (lc3Grid_mem hT _ _)⟩
  apply le_antisymm
  · refine lc3_sup_le (Real.iSup_nonneg fun _ => norm_nonneg _) fun v hv => ?_
    obtain ⟨k, hk⟩ := lc3_exists_grid hT hv
    refine le_of_tendsto' ((continuous_norm.comp hg).tendsto v |>.comp hk) fun n => ?_
    exact le_ciSup hbdd (n, k n)
  · exact ciSup_le fun p => lc3_le_sup hg (lc3Grid_mem hT _ _)

/-- **Measurability of the running supremum** (item 4 of the packet): for a family of random
variables `G v` continuous in `v`, `ω ↦ ⨆ v ∈ Icc 0 T, ‖G v ω‖` is measurable. -/
theorem lc_measurable_sup_norm [MeasurableSpace E] [OpensMeasurableSpace E] {G : ℝ → Ω → E}
    (hm : ∀ v, Measurable (G v)) (hc : ∀ ω, Continuous fun v => G v ω) (T : ℝ) :
    Measurable fun ω => ⨆ v ∈ Icc (0 : ℝ) T, ‖G v ω‖ := by
  rcases lt_or_ge T 0 with hT | hT
  · have : ∀ ω, ⨆ v ∈ Icc (0 : ℝ) T, ‖G v ω‖ = 0 := fun ω => by
      simp [Icc_eq_empty_of_lt hT]
    simp only [this]
    exact measurable_const
  · have : (fun ω => ⨆ v ∈ Icc (0 : ℝ) T, ‖G v ω‖) =
        fun ω => ⨆ p : ℕ × ℕ, ‖G (lc3Grid T p.1 p.2) ω‖ :=
      funext fun ω => lc3_sup_eq_grid hT (hc ω)
    rw [this]
    exact Measurable.iSup fun p => (hm _).norm

end Sup

theorem lc_noise_sup_measurable {P : Measure Ω} {ℱ : Filtration ℝ mΩ} {W : ℝ≥0 → Ω → Fin d → ℝ}
    {ν : ℝ → ℝ} (hW : IsBrownianFiltration P ℱ W) (hν : Continuous ν) (T : ℝ) :
    Measurable fun ω => ⨆ v ∈ Icc (0 : ℝ) T, ‖lcNoiseE W ν v ω‖ :=
  lc_measurable_sup_norm (fun v => lc_noiseE_measurable hW v) (lc_noiseE_cont hW hν) T

/-! ### Pathwise bound for `lcU` (item 5 of the packet) -/

section UBound

variable (Q : Matrix (Fin d) (Fin d) ℝ)

/-- `κ = sup_{0 ≤ r ≤ v ≤ T} ‖lcU Q g r v‖`. -/
def lcKappa (g : ℝ → Euc d) (T : ℝ) : ℝ := ⨆ r ∈ Icc (0 : ℝ) T, ⨆ v ∈ Icc r T, ‖lcU Q g r v‖

/-- **Pathwise bound for the shift `lcU`.**  There is a constant `C(Q,T)` such that for every
continuous noise path `g`, `‖lcU Q g r v‖ ≤ C sup_{[0,T]} ‖g‖` for `0 ≤ r ≤ v ≤ T`. -/
theorem lc_U_bound (T : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {g : ℝ → Euc d}, Continuous g → ∀ r v : ℝ, 0 ≤ r → r ≤ v → v ≤ T →
      ‖lcU Q g r v‖ ≤ C * ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ := by
  have hcont : Continuous fun t : ℝ => NormedSpace.exp (t • lcQ Q) :=
    NormedSpace.exp_continuous.comp (continuous_id.smul continuous_const)
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := -T) (b := 0)).exists_bound_of_continuousOn
    hcont.continuousOn
  have hK0 : 0 ≤ max K 0 := le_max_right _ _
  refine ⟨2 * (1 + max T 0 * ‖lcQ Q‖ * max K 0), by positivity, ?_⟩
  intro g hg r v hr hrv hvT
  set s := ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ with hs
  have hs0 : 0 ≤ s := lc3_sup_nonneg T
  have hgs : ∀ w, 0 ≤ w → w ≤ T → ‖g w‖ ≤ s := fun w h1 h2 => lc3_le_sup hg ⟨h1, h2⟩
  have hT0 : 0 ≤ T := hr.trans (hrv.trans hvT)
  have hgr := hgs r hr (hrv.trans hvT)
  have hgv := hgs v (hr.trans hrv) hvT
  have h1 : ‖g v - g r‖ ≤ 2 * s := (norm_sub_le _ _).trans (by linarith)
  have h2 : ‖∫ u in r..v, (NormedSpace.exp ((-(v - u)) • lcQ Q)) (lcQ Q (g u - g r))‖ ≤
      max K 0 * (‖lcQ Q‖ * (2 * s)) * |v - r| := by
    refine intervalIntegral.norm_integral_le_of_norm_le_const fun u hu => ?_
    rw [uIoc_of_le hrv] at hu
    have hu1 : 0 ≤ u := hr.trans hu.1.le
    have hu2 : u ≤ T := hu.2.trans hvT
    have hexp : ‖NormedSpace.exp ((-(v - u)) • lcQ Q)‖ ≤ max K 0 :=
      (hK _ ⟨by linarith [hu.2], by linarith [hu.2]⟩).trans (le_max_left _ _)
    have hQ : ‖lcQ Q (g u - g r)‖ ≤ ‖lcQ Q‖ * (2 * s) :=
      ((lcQ Q).le_opNorm _).trans (mul_le_mul_of_nonneg_left
        ((norm_sub_le _ _).trans (by linarith [hgs u hu1 hu2])) (norm_nonneg _))
    calc _ ≤ ‖NormedSpace.exp ((-(v - u)) • lcQ Q)‖ * ‖lcQ Q (g u - g r)‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ ≤ max K 0 * (‖lcQ Q‖ * (2 * s)) :=
          mul_le_mul hexp hQ (norm_nonneg _) hK0
  have h3 : |v - r| ≤ max T 0 := by
    rw [abs_of_nonneg (sub_nonneg.2 hrv)]
    exact le_max_of_le_left (by linarith)
  have h4 : max K 0 * (‖lcQ Q‖ * (2 * s)) * |v - r| ≤ max K 0 * (‖lcQ Q‖ * (2 * s)) * max T 0 :=
    mul_le_mul_of_nonneg_left h3 (by positivity)
  unfold lcU
  calc _ ≤ ‖g v - g r‖ + ‖∫ u in r..v, (NormedSpace.exp ((-(v - u)) • lcQ Q)) (lcQ Q (g u - g r))‖ :=
        norm_sub_le _ _
    _ ≤ 2 * s + max K 0 * (‖lcQ Q‖ * (2 * s)) * max T 0 := by linarith
    _ = 2 * (1 + max T 0 * ‖lcQ Q‖ * max K 0) * s := by ring

/-- `sup_{v ∈ [r,T]} ‖lcU Q g r v‖ ≤ C sup_{[0,T]} ‖g‖` for `0 ≤ r ≤ T`, same constant. -/
theorem lc_U_sup_bound (T : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {g : ℝ → Euc d}, Continuous g → ∀ r : ℝ, 0 ≤ r → r ≤ T →
      ⨆ v ∈ Icc r T, ‖lcU Q g r v‖ ≤ C * ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ := by
  obtain ⟨C, hC0, hC⟩ := lc_U_bound Q T
  refine ⟨C, hC0, fun {g} hg r hr hrT => ?_⟩
  have hc : 0 ≤ C * ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ := mul_nonneg hC0 (lc3_sup_nonneg T)
  exact Real.iSup_le (fun v => Real.iSup_le (fun hv => hC hg r v hr hv.1 hv.2) hc) hc

/-- `κ ≤ C sup_{[0,T]} ‖g‖`: the quantity `κ` of the pathwise weights is controlled by the noise. -/
theorem lc_kappa_bound (T : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {g : ℝ → Euc d}, Continuous g →
      lcKappa Q g T ≤ C * ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ := by
  obtain ⟨C, hC0, hC⟩ := lc_U_sup_bound Q T
  refine ⟨C, hC0, fun {g} hg => ?_⟩
  have hc : 0 ≤ C * ⨆ w ∈ Icc (0 : ℝ) T, ‖g w‖ := mul_nonneg hC0 (lc3_sup_nonneg T)
  exact Real.iSup_le (fun r => Real.iSup_le (fun hr => hC hg r hr.1 hr.2) hc) hc

theorem lcKappa_nonneg (g : ℝ → Euc d) (T : ℝ) : 0 ≤ lcKappa Q g T :=
  Real.iSup_nonneg fun r => Real.iSup_nonneg fun _ => Real.iSup_nonneg fun v =>
    Real.iSup_nonneg fun _ => norm_nonneg _

end UBound

end HRS.MS.Lc
