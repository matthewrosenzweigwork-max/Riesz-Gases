/-- The retained source evaluation identity, together with its scalar first
chaos certificate, holds for the measurable representatives of the retained
Gaussian coordinates. -/
theorem fp81s21_gaussian_source_measurable_hsrc
    {p : Parameters} {δ : ℝ} {R : Trajectory p δ}
    {hμ₀ : IsProbabilityMeasure (r26t3_mu R 0)}
    (D : fp81s21_gaussian_source_retained_data p R hμ₀) :
    (∃ hmeas : ∀ i,
        Measurable (fp81s21_gaussian_source_measurableXi D i),
      ∃ hstd : IsStdGaussianSeq D.G0.P
          (fp81s21_gaussian_source_measurableXi D),
      ∀ u : ℝ, 0 ≤ u → ∀ φ : Euc p.d → ℝ,
        IsOscTest (wholeSpaceIndex p.d : ℝ) φ →
        (fun ω => OscDual.eval (D.G0.Z u ω) φ) =ᵐ[D.G0.P]
          (fun ω => D.W (D.J (fp81s21_combinedFeature p R D.hK u φ)) ω) ∧
        HRS.MC.E213U13.InQ1 hstd hmeas
          (fun ω => D.W (D.J (fp81s21_combinedFeature p R D.hK u φ)) ω)) := by
  obtain ⟨hmeas, hae, hstd⟩ :=
    fp81s21_gaussian_source_measurable_coords_std D
  refine ⟨hmeas, hstd, ?_⟩
  intro u hu φ hφ
  refine ⟨D.sourceEvaluation u hu φ hφ, ?_⟩
  have hfeature := fp81s21_gaussian_source_W_firstChaos D
    (D.J (fp81s21_combinedFeature p R D.hK u φ))
  have hfeature' : InFirstChaos D.G0.P
      (fp81s21_gaussian_source_measurableXi D) 2
      (D.W (D.J (fp81s21_combinedFeature p R D.hK u φ))) :=
    fp81s21_firstChaos_congr_coordinates hae hfeature
  exact HRS.MS.R26T3.s21l_inQ1_of_first hstd hmeas hfeature'

/-- The retained shifted window is in the first chaos generated by the
measurable coordinates of the retained Gaussian source, with its centered
Gaussian law certified at the same time.  The radius and positive-δ prefix
are inherited from the retained-source package. -/
theorem fp81s21_retained_Z_firstChaos (p : Parameters) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 2 ∧
      ∀ δ : ℝ, 0 < δ → δ ≤ δ₀ →
        ∀ R : Trajectory p δ,
          ∀ hμ₀ : IsProbabilityMeasure (r26t3_mu R 0),
            ∀ D : fp81s21_gaussian_source_retained_data p R hμ₀,
              ∀ a : ℝ, 0 ≤ a →
                HRS.InFirstChaos D.G0.P
                    (fp81s21_gaussian_source_measurableXi D) 2
                    (r26t3_Zpath D.G0 a) ∧
                HRS.IsCenteredGaussian
                    (HRS.law D.G0.P (r26t3_Zpath D.G0 a)) := by
  obtain ⟨δ₀, hδ₀, hδ₀half, _⟩ := fp81s21_gaussian_source_retained p
  refine ⟨δ₀, hδ₀, hδ₀half, ?_⟩
  intro δ hδ hδle R hμ₀ D a ha
  letI : IsProbabilityMeasure (r26t3_mu R 0) := hμ₀
  obtain ⟨hmeas, hstd, hsrc⟩ := fp81s21_gaussian_source_measurable_hsrc D
  exact fp81s21_retained_Z_firstChaos_conditional p R D.G0
    (fp81s21_gaussian_source_measurableXi D) hstd hmeas D.hK D.J D.W hsrc a ha

#print axioms fp81s21_gaussian_source_measurable_hsrc
#print axioms fp81s21_retained_Z_firstChaos

end HRS.Fp81.S21
