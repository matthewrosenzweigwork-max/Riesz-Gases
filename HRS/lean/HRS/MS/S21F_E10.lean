import HRS.Stochastic.Bridge
import HRS.Whole.Basic

/-!
# S21F, packet R26-T3.E10: Brownian lift for a measurable initial configuration

From `exists_isBrownianFiltration_of_isVectorBrownian` (augmented filtration generated by `X₀` and the
continuous modification `W'`; `X₀` is measurable at time `0`).  No adaptedness of any solution is asserted.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Filter Topology Set InformationTheory
open scoped ENNReal NNReal
open HRS HRS.Whole

namespace HRS.MS.R26T3

theorem r26t3_brownian_lift {d N : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X₀ : Ω → EucConfig d N) (hX₀ : Measurable X₀)
    (W : ℝ≥0 → Ω → (Fin N → Euc d)) (hW : IsVectorBrownian P W)
    (hind : IndepFun X₀ (fun ζ t => W t ζ) P) :
    ∃ (ℱ : Filtration ℝ mΩ) (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ),
      IsBrownianFiltration P ℱ W' ∧ Measurable[ℱ 0] X₀ ∧
      (∀ᵐ ζ ∂P, ∀ t i j, W' t ζ (i,j) = W t ζ i j) := by
  obtain ⟨W', hW'm, hae, hBF, hX⟩ :=
    exists_isBrownianFiltration_of_isVectorBrownian P W hW X₀ hX₀ hind
  exact ⟨_, W', hBF, hX 0, hae⟩

end HRS.MS.R26T3
