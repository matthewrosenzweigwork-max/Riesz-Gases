import HRS.MS.Fp81S21WindowFeature15

/-!
# S2.1(iii): the window covariance form

The form is chosen from its defining identity in the same way as `s101D`.
Its existence and the sharp trace estimate are proved from the physical
orbit envelope and the positive-order feature bound.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000
noncomputable section

open MeasureTheory Set
open scoped ENNReal NNReal BigOperators ContDiff

namespace HRS.Fp81.S21

open HRS (Euc)
open HRS.Whole HRS.MS.CovMeas HRS.MS.FixEq

variable {d : ℕ}

open Classical in
/-- The pointwise covariance form generated by the observation-window
feature. It is defined by the same existence-choice construction as `s101D`.
-/
def fp81s21_windowD (C : WholeCoeff d) (m H a : ℝ)
    (z : ℝ → (Euc d → ℝ) → ℝ) (v : ℝ) :
    KSpace d m H →L[ℝ] KSpace d m H →L[ℝ] ℝ :=
  if h : ∃ Dc : KSpace d m H →L[ℝ] KSpace d m H →L[ℝ] ℝ,
      ∀ u w, Dc u w = 2 * C.ν * z v
        (s101Fm (fp81s21_window_feature C m H a v) (s101Rk u w))
  then h.choose else 0

/-- Specification, symmetry, bounded orthonormal-pair sums, and the positive
trace estimate for the window covariance form. The positive-order bound is
kept explicit so a wR33 feature estimate can be supplied without changing its
quantifier order.
-/
theorem fp81s21_windowD_data
    (hd : 1 ≤ d) {C : WholeCoeff d} {m H a : ℝ} {r : ℕ} {P : ℝ}
    {z : ℝ → (Euc d → ℝ) → ℝ}
    (hH : 0 < H) (ha : 0 ≤ a)
    (horb : R2OrbitSummable C m (a + H) r)
    (hterminal : ∀ v ∈ Icc (0 : ℝ) (a + H), ∀ α : MultiIndex d, ∀ x : Euc d,
      propagatorW C v v (oscTestFun m α) x = oscTestFun m α x)
    (hz : IsR2L1F r P (a + H) z)
    (hP : (d : ℝ) < 2 * P)
    {v : ℝ} (hv : v ∈ Icc (0 : ℝ) (a + H))
    {Bpos : ℝ}
    (hPos : ∀ j : ℕ, 1 ≤ j → j ≤ r + 1 → ∀ x : Euc d,
      ‖iteratedFDeriv ℝ j (fp81s21_window_feature C m H a v) x‖ ≤ Bpos) :
    (∀ u w, fp81s21_windowD C m H a z v u w =
      2 * C.ν * z v (s101Fm (fp81s21_window_feature C m H a v) (s101Rk u w))) ∧
    (∀ u w, fp81s21_windowD C m H a z v u w = fp81s21_windowD C m H a z v w u) ∧
    BddAbove (Set.range fun p : HRS.OrthonormalPairs (KSpace d m H) =>
      ∑ i, |fp81s21_windowD C m H a z v (p.1.2.1 i) (p.1.2.2 i)|) ∧
    ENNReal.ofReal (HRS.traceNormForm (fp81s21_windowD C m H a z v)) ≤
      ENNReal.ofReal |2 * C.ν| * dualNormE r P (z v) *
        ENNReal.ofReal (s57pC d r P * ((d : ℝ) * 2 ^ r * Bpos ^ 2)) := by
  obtain ⟨c, hD⟩ := s101_data_of_horb hd horb
  have htermv := hterminal v hv
  have hreg := fp81s21_window_feature_contDiff_full_of_data
    hd hH a ha v hv hD htermv
  have hη : IsBoundedLinearOnE r P (fun f => 2 * C.ν * z v f) :=
    s101_isBounded_of_lin hz.1 hv (2 * C.ν)
  have hBpos : 0 ≤ Bpos :=
    le_trans (norm_nonneg _) (hPos 1 (by norm_num) (by omega) 0)
  obtain ⟨Dc, hDc, hsym, hbdd, _⟩ :=
    s101_Dform_data hP hreg.1 hreg.2 hη
  have hex : ∃ Dc : KSpace d m H →L[ℝ] KSpace d m H →L[ℝ] ℝ,
      ∀ u w, Dc u w = 2 * C.ν * z v
        (s101Fm (fp81s21_window_feature C m H a v) (s101Rk u w)) :=
    ⟨Dc, hDc⟩
  have hEq : fp81s21_windowD C m H a z v = Dc := by
    ext u w
    unfold fp81s21_windowD
    rw [dif_pos hex]
    calc
      hex.choose u w = 2 * C.ν * z v
          (s101Fm (fp81s21_window_feature C m H a v) (s101Rk u w)) :=
        hex.choose_spec u w
      _ = Dc u w := (hDc u w).symm
  have hsharp := fp81s21_window_feature_trace_bound_pos_of_data
    (hd := hd) (C := C) (m := m) (H := H) (a := a) (v := v)
    (r := r) (c := c) hH ha hv hD htermv hP hη hBpos hPos Dc hDc
  have hscale := s101_dualNormE_smul_le (r := r) (P := P)
    (2 * C.ν) (z v)
  rw [hEq]
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact hDc
  · exact hsym
  · exact hbdd
  ·
    calc
      ENNReal.ofReal (HRS.traceNormForm Dc) ≤
          dualNormE r P (fun f => 2 * C.ν * z v f) *
            ENNReal.ofReal (s57pC d r P * ((d : ℝ) * 2 ^ r * Bpos ^ 2)) := hsharp
      _ ≤ (ENNReal.ofReal |2 * C.ν| * dualNormE r P (z v)) *
            ENNReal.ofReal (s57pC d r P * ((d : ℝ) * 2 ^ r * Bpos ^ 2)) :=
          mul_le_mul_of_nonneg_right hscale (by positivity)
      _ = ENNReal.ofReal |2 * C.ν| * dualNormE r P (z v) *
            ENNReal.ofReal (s57pC d r P * ((d : ℝ) * 2 ^ r * Bpos ^ 2)) := by
          rw [mul_assoc]

#print axioms fp81s21_windowD_data

end HRS.Fp81.S21

end
