/-- Integrability and a numerical bound for the sixth power of a real-valued random variable. -/
def SixthBound {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (Y : Ω → ℝ) (M : ℝ) : Prop :=
  Integrable (fun ω => ‖Y ω‖ ^ 6) P ∧ (∫ ω, ‖Y ω‖ ^ 6 ∂P) ≤ M

private theorem fp81s21_sixthBound_of_eLpNorm
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (Y : Ω → ℝ) (D : ℝ)
    (hD : 0 ≤ D) (hY : Measurable Y)
    (hLp : eLpNorm Y (ENNReal.ofReal 6) P ≤ ENNReal.ofReal D) :
    SixthBound P Y (D ^ 6) := by
  have hLin := HRS.MS.R2Wfm.s97_lint_eq P Y hY.aestronglyMeasurable
    (r := 6) (by norm_num)
  have hPower : ∫⁻ ω, ENNReal.ofReal (‖Y ω‖ ^ 6) ∂P ≤ ENNReal.ofReal (D ^ 6) := by
    have hEq : ∫⁻ ω, ENNReal.ofReal (‖Y ω‖ ^ 6) ∂P =
        eLpNorm Y (ENNReal.ofReal 6) P ^ (6 : ℝ) := by
      have hPoint : ∀ ω, ENNReal.ofReal (‖Y ω‖ ^ 6) = ENNReal.ofReal |Y ω| ^ (6 : ℝ) := by
        intro ω
        rw [Real.norm_eq_abs, ENNReal.ofReal_pow (abs_nonneg _)]
        rw [← ENNReal.rpow_natCast]
        rfl
      calc
        _ = ∫⁻ ω, ENNReal.ofReal |Y ω| ^ (6 : ℝ) ∂P :=
          lintegral_congr_ae (Filter.Eventually.of_forall hPoint)
        _ = eLpNorm Y (ENNReal.ofReal 6) P ^ (6 : ℝ) := hLin
    rw [hEq]
    calc eLpNorm Y (ENNReal.ofReal 6) P ^ (6 : ℝ)
        ≤ ENNReal.ofReal D ^ (6 : ℝ) := ENNReal.rpow_le_rpow hLp (by norm_num)
      _ = ENNReal.ofReal (D ^ 6) := by
        rw [ENNReal.ofReal_rpow_of_nonneg hD (by norm_num)]
        congr 1
        exact_mod_cast Real.rpow_natCast D 6
  have hNonneg : ∀ ω, 0 ≤ ‖Y ω‖ ^ 6 := fun ω => by positivity
  have hIntegrable : Integrable (fun ω => ‖Y ω‖ ^ 6) P := by
    refine ⟨((measurable_norm.comp hY).pow_const 6).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall hNonneg)]
    exact lt_of_le_of_lt hPower ENNReal.ofReal_lt_top
  refine ⟨hIntegrable, ?_⟩
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall hNonneg)
    hIntegrable.aestronglyMeasurable]
  have hReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top hPower
  rwa [ENNReal.toReal_ofReal (by positivity : 0 ≤ D ^ 6)] at hReal

open HRS.Whole
open HRS.MS.R26T3

private theorem fp81s21_density_no_atoms {d : ℕ} (hd : 1 ≤ d) {ρ : Euc d → ℝ}
    (hρ : HRS.Whole.IsProbDensity ρ) : ∀ x, HRS.Whole.withDensityReal ρ {x} = 0 := by
  letI : Nontrivial (Euc d) := by
    obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
    infer_instance
  intro x
  rw [HRS.Whole.withDensityReal, withDensity_apply _ (measurableSet_singleton x),
    setLIntegral_measure_zero _ _ (measure_singleton x)]

private theorem fp81s21_zero_pairEnergy_ae
    {d N : ℕ} (hd : 1 ≤ d) {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {μ : Measure (Euc d)} {ρ : Euc d → ℝ}
    (hρ : HRS.Whole.IsProbDensity ρ) (hμ : μ = HRS.Whole.withDensityReal ρ)
    (X : ℝ≥0 → Ω → EucConfig d N) (t : ℝ≥0)
    (hNoCollision : ∀ᵐ ω ∂P, X t ω ∉ eucCollisionSet d N)
    {s B : ℝ} {h : Euc d → Euc d → ℝ}
    (hB : B = 0) (hh : IsBoundedPairKernel s B h) :
    (fun ω => pairEnergy h (X t ω) μ) =ᵐ[P] fun _ => 0 := by
  have hμatom : ∀ x, μ {x} = 0 := by
    intro x
    rw [hμ]
    exact fp81s21_density_no_atoms hd hρ x
  have hOff : ∀ x y, x ≠ y → h x y = 0 := by
    intro x y hxy
    have hb := hh.bound x y hxy
    rw [hB] at hb
    have habs : |h x y| ≤ 0 := by simpa using hb
    exact abs_eq_zero.mp (le_antisymm habs (abs_nonneg _))
  filter_upwards [hNoCollision] with ω hω
  have hDistinct : ∀ i j, i ≠ j → X t ω i ≠ X t ω j := by
    intro i j hij heq
    apply hω
    exact ⟨i, j, hij, heq⟩
  calc
    pairEnergy h (X t ω) μ = pairEnergy (fun _ _ => (0 : ℝ)) (X t ω) μ :=
      HRS.MS.Wr.pairEnergy_congr_offdiag hμatom hOff (X t ω) hDistinct
    _ = 0 := by simp [pairEnergy]

private theorem fp81s21_pair_eLpNorm_at
    {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ρ : Euc d → ℝ} {s M L b pinf K Cq B : ℝ}
    (hρ : IsRound2Density d s M L ρ) (hN : 2 ≤ N)
    (X : ℝ≥0 → Ω → EucConfig d N) (t : ℝ≥0) (hX : Measurable (X t))
    (hActual : HasR2ActualDensity s b pinf K (HRS.Whole.withDensityReal ρ) (P.map (X t)))
    (hB : 0 < B) {h : Euc d → Euc d → ℝ} (hh : IsBoundedPairKernel s B h)
    (hCq : ∀ k : Euc d → Euc d → ℝ, IsBoundedPairKernel s 1 k →
      eLpNorm (fun Z : EucConfig d N => (N : ℝ) * pairEnergy k Z (HRS.Whole.withDensityReal ρ))
          (ENNReal.ofReal 6) (P.map (X t)) ≤ ENNReal.ofReal Cq ∧
      eLpNorm (fun Z : EucConfig d N => (N : ℝ) *
        (pairEnergy k Z (HRS.Whole.withDensityReal ρ) -
          ∫ Z', pairEnergy k Z' (HRS.Whole.withDensityReal ρ) ∂(P.map (X t))))
          (ENNReal.ofReal 6) (P.map (X t)) ≤ ENNReal.ofReal Cq) :
    eLpNorm (fun ω => (N : ℝ) * pairEnergy h (X t ω) (HRS.Whole.withDensityReal ρ))
        (ENNReal.ofReal 6) P ≤ ENNReal.ofReal (B * Cq) ∧
    eLpNorm (fun ω => (N : ℝ) *
      (pairEnergy h (X t ω) (HRS.Whole.withDensityReal ρ) -
        ∫ ω', pairEnergy h (X t ω') (HRS.Whole.withDensityReal ρ) ∂P))
        (ENNReal.ofReal 6) P ≤ ENNReal.ofReal (B * Cq) := by
  let μ : Measure (Euc d) := HRS.Whole.withDensityReal ρ
  haveI : IsProbabilityMeasure μ := HRS.Whole.U1.u1_isProb hρ.prob
  let Pcfg : Measure (EucConfig d N) := P.map (X t)
  haveI hPcfg : IsProbabilityMeasure Pcfg := hActual.1
  let k : Euc d → Euc d → ℝ := fun x y => B⁻¹ * h x y
  have hk : IsBoundedPairKernel s 1 k := by
    refine ⟨?_, ?_, ?_⟩
    · change Measurable (fun q : Euc d × Euc d => B⁻¹ * h q.1 q.2)
      exact measurable_const.mul hh.measurable
    · intro x y
      simp [k, hh.symm x y]
    · intro x y hxy
      have hW : 0 ≤ 1 + rieszWeight s (x - y) := by
        have := HRS.MS.PrepStat.s32_rieszWeight_nonneg s (x - y)
        linarith
      have hAbs : |k x y| = B⁻¹ * |h x y| := by
        simp [k, abs_mul, abs_of_nonneg (inv_nonneg.mpr hB.le)]
      rw [hAbs]
      calc
        B⁻¹ * |h x y| ≤ B⁻¹ * (B * (1 + rieszWeight s (x - y))) :=
          mul_le_mul_of_nonneg_left (hh.bound x y hxy) (inv_nonneg.mpr hB.le)
        _ = 1 * (1 + rieszWeight s (x - y)) := by
          rw [← mul_assoc, inv_mul_cancel₀ hB.ne', one_mul]
  have hEnergyScale : ∀ Z : EucConfig d N,
      pairEnergy h Z μ = B * pairEnergy k Z μ := by
    intro Z
    have hkEq : h = fun x y => B * k x y := by
      funext x y
      dsimp [k]
      field_simp [hB.ne']
    rw [hkEq, HRS.MS.PrepStat.s32_pairEnergy_const_mul]
  have hPairMeas : Measurable (fun Z : EucConfig d N => pairEnergy k Z μ) := by
    exact HRS.MS.R2Chaos.s94_pE_meas_config (N := N) (μ := μ) hk.measurable
  have hRawMeas : Measurable (fun Z : EucConfig d N => (N : ℝ) * pairEnergy k Z μ) :=
    measurable_const.mul hPairMeas
  have hCenterMeas : Measurable (fun Z : EucConfig d N => (N : ℝ) *
      (pairEnergy k Z μ - ∫ Z', pairEnergy k Z' μ ∂Pcfg)) :=
    measurable_const.mul (hPairMeas.sub measurable_const)
  have hMeanMap : ∫ Z, pairEnergy k Z μ ∂Pcfg =
      ∫ ω, pairEnergy k (X t ω) μ ∂P :=
    integral_map hX.aemeasurable hPairMeas.aestronglyMeasurable
  have hRawMap : eLpNorm (fun ω => (N : ℝ) * pairEnergy k (X t ω) μ)
      (ENNReal.ofReal 6) P =
      eLpNorm (fun Z : EucConfig d N => (N : ℝ) * pairEnergy k Z μ)
        (ENNReal.ofReal 6) Pcfg := by
    rw [eLpNorm_map_measure hRawMeas.aestronglyMeasurable hX.aemeasurable]
    rfl
  have hCenterMap : eLpNorm (fun ω => (N : ℝ) *
      (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P))
      (ENNReal.ofReal 6) P =
      eLpNorm (fun Z : EucConfig d N => (N : ℝ) *
        (pairEnergy k Z μ - ∫ Z', pairEnergy k Z' μ ∂Pcfg))
        (ENNReal.ofReal 6) Pcfg := by
    rw [eLpNorm_map_measure hCenterMeas.aestronglyMeasurable hX.aemeasurable]
    simp only [Function.comp_def, hMeanMap]
  have hBase := hCq k hk
  have hRawK : eLpNorm (fun ω => (N : ℝ) * pairEnergy k (X t ω) μ)
      (ENNReal.ofReal 6) P ≤ ENNReal.ofReal Cq := hRawMap ▸ hBase.1
  have hCenterK : eLpNorm (fun ω => (N : ℝ) *
      (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P))
      (ENNReal.ofReal 6) P ≤ ENNReal.ofReal Cq := hCenterMap ▸ hBase.2
  have hMeanScale : ∫ ω, pairEnergy h (X t ω) μ ∂P =
      B * ∫ ω, pairEnergy k (X t ω) μ ∂P := by
    calc
      ∫ ω, pairEnergy h (X t ω) μ ∂P =
          ∫ ω, B * pairEnergy k (X t ω) μ ∂P :=
        integral_congr_ae (Filter.Eventually.of_forall fun ω => hEnergyScale (X t ω))
      _ = B * ∫ ω, pairEnergy k (X t ω) μ ∂P := integral_const_mul B _
  have hRawScale : (fun ω => (N : ℝ) * pairEnergy h (X t ω) μ) =
      fun ω => B * ((N : ℝ) * pairEnergy k (X t ω) μ) := by
    funext ω
    rw [hEnergyScale]
    ring
  have hCenterScale : (fun ω => (N : ℝ) *
      (pairEnergy h (X t ω) μ - ∫ ω', pairEnergy h (X t ω') μ ∂P)) =
      fun ω => B * ((N : ℝ) *
        (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P)) := by
    funext ω
    rw [hEnergyScale, hMeanScale]
    ring
  have hRawSmul : (fun ω => (N : ℝ) * pairEnergy h (X t ω) μ) =
      fun ω => B • ((N : ℝ) * pairEnergy k (X t ω) μ) := by
    funext ω
    rw [hEnergyScale]
    simp only [smul_eq_mul]
    ring
  have hCenterSmul : (fun ω => (N : ℝ) *
      (pairEnergy h (X t ω) μ - ∫ ω', pairEnergy h (X t ω') μ ∂P)) =
      fun ω => B • ((N : ℝ) *
        (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P)) := by
    funext ω
    rw [hEnergyScale, hMeanScale]
    simp only [smul_eq_mul]
    ring
  constructor
  · calc
      eLpNorm (fun ω => (N : ℝ) * pairEnergy h (X t ω) μ) (ENNReal.ofReal 6) P
          = ‖B‖ₑ * eLpNorm (fun ω => (N : ℝ) * pairEnergy k (X t ω) μ)
              (ENNReal.ofReal 6) P := by
                rw [hRawSmul,
                  show (fun ω => B • ((N : ℝ) * pairEnergy k (X t ω) μ)) =
                    B • (fun ω => (N : ℝ) * pairEnergy k (X t ω) μ) from rfl,
                  eLpNorm_const_smul]
      _ = ENNReal.ofReal B * eLpNorm (fun ω => (N : ℝ) * pairEnergy k (X t ω) μ)
              (ENNReal.ofReal 6) P := by rw [Real.enorm_eq_ofReal hB.le]
      _ ≤ ENNReal.ofReal B * ENNReal.ofReal Cq :=
        mul_le_mul_of_nonneg_left hRawK (by positivity)
      _ = ENNReal.ofReal (B * Cq) := by rw [ENNReal.ofReal_mul hB.le]
  · calc
      eLpNorm (fun ω => (N : ℝ) *
          (pairEnergy h (X t ω) μ - ∫ ω', pairEnergy h (X t ω') μ ∂P))
          (ENNReal.ofReal 6) P
          = ‖B‖ₑ * eLpNorm (fun ω => (N : ℝ) *
              (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P))
              (ENNReal.ofReal 6) P := by
                rw [hCenterSmul,
                  show (fun ω => B • ((N : ℝ) *
                    (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P))) =
                    B • (fun ω => (N : ℝ) *
                      (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P)) from rfl,
                  eLpNorm_const_smul]
      _ = ENNReal.ofReal B * eLpNorm (fun ω => (N : ℝ) *
              (pairEnergy k (X t ω) μ - ∫ ω', pairEnergy k (X t ω') μ ∂P))
              (ENNReal.ofReal 6) P := by rw [Real.enorm_eq_ofReal hB.le]
      _ ≤ ENNReal.ofReal B * ENNReal.ofReal Cq :=
        mul_le_mul_of_nonneg_left hCenterK (by positivity)
      _ = ENNReal.ofReal (B * Cq) := by rw [ENNReal.ofReal_mul hB.le]

private theorem fp81s21_linear_eLpNorm_at
    {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {ρ : Euc d → ℝ} {s b pinf K Cl B : ℝ}
    (hN : 2 ≤ N) (X : ℝ≥0 → Ω → EucConfig d N) (t : ℝ≥0)
    (hX : Measurable (X t))
    (hActual : HasR2ActualDensity s b pinf K (HRS.Whole.withDensityReal ρ)
      (P.map (X t)))
    (f : Euc d → ℝ) (hf : Measurable f) (hB : 0 ≤ B)
    (hCl : ∀ N : ℕ, 2 ≤ N → ∀ Pcfg : Measure (EucConfig d N),
      HasR2ActualDensity s b pinf K (HRS.Whole.withDensityReal ρ) Pcfg →
      eLpNorm (fun Z : EucConfig d N => Real.sqrt (N : ℝ) *
        (HRS.Whole.pair (HRS.Whole.empirical Z) f -
          HRS.Whole.pair (HRS.Whole.withDensityReal ρ) f)) (ENNReal.ofReal 6) Pcfg ≤
        ENNReal.ofReal (Cl * B)) :
    eLpNorm (fun ω => Real.sqrt (N : ℝ) *
      (HRS.Whole.pair (HRS.Whole.empirical (X t ω)) f -
        HRS.Whole.pair (HRS.Whole.withDensityReal ρ) f)) (ENNReal.ofReal 6) P ≤
      ENNReal.ofReal (Cl * B) := by
  let Pcfg : Measure (EucConfig d N) := P.map (X t)
  have hLinMeas : Measurable (fun Z : EucConfig d N => Real.sqrt (N : ℝ) *
      (HRS.Whole.pair (HRS.Whole.empirical Z) f -
        HRS.Whole.pair (HRS.Whole.withDensityReal ρ) f)) := by
    have hEmp : ∀ Z : EucConfig d N,
        HRS.Whole.pair (HRS.Whole.empirical Z) f = (N : ℝ)⁻¹ * ∑ i, f (Z i) :=
      fun Z => HRS.MS.PrepStat.s32_pair_empirical Z hf
    simp_rw [hEmp]
    exact measurable_const.mul ((measurable_const.mul
      (Finset.measurable_sum _ fun i _ => hf.comp (measurable_pi_apply i))).sub_const _)
  have hMap : eLpNorm (fun ω => Real.sqrt (N : ℝ) *
      (HRS.Whole.pair (HRS.Whole.empirical (X t ω)) f -
        HRS.Whole.pair (HRS.Whole.withDensityReal ρ) f)) (ENNReal.ofReal 6) P =
      eLpNorm (fun Z : EucConfig d N => Real.sqrt (N : ℝ) *
        (HRS.Whole.pair (HRS.Whole.empirical Z) f -
          HRS.Whole.pair (HRS.Whole.withDensityReal ρ) f)) (ENNReal.ofReal 6) Pcfg := by
    rw [eLpNorm_map_measure hLinMeas.aestronglyMeasurable hX.aemeasurable]
    rfl
  rw [hMap]
  exact hCl N hN Pcfg (by simpa [Pcfg] using hActual)

/-- Uniform all-time sixth moments for scalar pair-energy slices and bounded linear
fluctuations of an actual particle trajectory.  The common constant is selected before
particle count, realization, time, and observable envelopes. -/
theorem fp81s21_particle_sixth_slices (p : Parameters) :
    ∃ δ0 : ℝ, 0 < δ0 ∧ δ0 ≤ 1 / 2 ∧
      ∀ δ : ℝ, 0 < δ → δ ≤ δ0 → ∀ R : HRS.MS.R26T3.Trajectory p δ,
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ N : ℕ, 2 ≤ N → ∀ A : HRS.MS.R26T3.Particle R N,
          ∀ u : ℝ, 0 ≤ u → ∀ B : ℝ, 0 ≤ B →
            (∀ h : Euc p.d → Euc p.d → ℝ,
                IsBoundedPairKernel p.s B h →
                SixthBound A.P (fun ω => (N : ℝ) *
                  pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u)) (C * B ^ 6) ∧
                SixthBound A.P (fun ω =>
                  (N : ℝ) * (pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u) -
                    ∫ ω', pairEnergy h (A.X u.toNNReal ω') (r26t3_mu R u) ∂A.P))
                  (C * B ^ 6)) ∧
              ∀ f : Euc p.d → ℝ, Measurable f → (∀ x, |f x| ≤ B) →
                SixthBound A.P (fun ω => Real.sqrt (N : ℝ) *
                  (HRS.Whole.pair (HRS.Whole.empirical (A.X u.toNNReal ω)) f -
                    HRS.Whole.pair (r26t3_mu R u) f))
                  (C * B ^ 6) := by
  obtain ⟨δ0, hδ0, hδhalf, hUniform⟩ := fp81s21_uniform_density_moments p
  refine ⟨δ0, hδ0, hδhalf, ?_⟩
  intro δ hδ hδle R
  obtain ⟨pinf, K, C₀, c₀, M, L, Mρ, Cm, hpinf, hc₀, hGaussian, hRound2,
    hMoment, hParticle⟩ := hUniform δ hδ hδle R
  obtain ⟨Cq, hCq0, hCq⟩ := HRS.MS.R2Mt.s92_F_bound p.hd p.hs0 p.hs M L
    p.β pinf K 1 6 p.hβ hpinf (by norm_num)
  obtain ⟨Cl, hCl0, hLinear⟩ := HRS.MS.R2Mt.s92_linear_bound p.hd p.hs0 p.hs M L
    p.β pinf K 6 p.hβ hpinf (by norm_num)
  let C : ℝ := max (Cq ^ 6) (Cl ^ 6)
  have hC : 0 ≤ C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro N hN A u hu B hB
  let t : ℝ≥0 := u.toNNReal
  let μ : Measure (Euc p.d) := HRS.Whole.withDensityReal (R.ρ u)
  have hSol := A.strong (u + 1)
  have hX : Measurable (A.X t) := hSol.adapted t
  have ht : (t : ℝ) ≤ u + 1 := by
    change (u.toNNReal : ℝ) ≤ u + 1
    rw [Real.coe_toNNReal _ hu]
    linarith
  have hNoCollision : ∀ᵐ ω ∂A.P, A.X t ω ∉ eucCollisionSet p.d N :=
    hSol.no_collision.mono (fun ω hω => hω t ht)
  have hρ : HRS.Whole.IsProbDensity (R.ρ u) :=
    ((HRS.MS.R26T3.r26t3_reference_data p δ hδ (hδle.trans hδhalf) R).2.2.1 u hu).1
  haveI : IsProbabilityMeasure μ := HRS.Whole.U1.u1_isProb hρ
  have hρRound : HRS.Whole.IsRound2Density p.d p.s M L (R.ρ u) := hRound2 u hu
  have hActual : HasR2ActualDensity p.s p.β pinf K μ (A.P.map (A.X t)) := by
    change HasR2ActualDensity p.s p.β pinf K
      (HRS.Whole.withDensityReal (R.ρ u)) (A.P.map (A.X t))
    exact (hParticle N hN A u hu).1
  have hCqAt : ∀ k : Euc p.d → Euc p.d → ℝ, IsBoundedPairKernel p.s 1 k →
      eLpNorm (fun Z : EucConfig p.d N => (N : ℝ) * pairEnergy k Z μ)
        (ENNReal.ofReal 6) (A.P.map (A.X t)) ≤ ENNReal.ofReal Cq ∧
      eLpNorm (fun Z : EucConfig p.d N => (N : ℝ) *
        (pairEnergy k Z μ - ∫ Z', pairEnergy k Z' μ ∂(A.P.map (A.X t))))
        (ENNReal.ofReal 6) (A.P.map (A.X t)) ≤ ENNReal.ofReal Cq := by
    intro k hk
    simpa [μ] using hCq (R.ρ u) hρRound k hk N hN (A.P.map (A.X t)) hActual
  constructor
  · intro h hh
    let Y : A.Ω → ℝ := fun ω => (N : ℝ) * pairEnergy h (A.X t ω) μ
    have hPairMeas : Measurable (fun Z : EucConfig p.d N => pairEnergy h Z μ) :=
      HRS.MS.R2Chaos.s94_pE_meas_config (N := N) (μ := μ) hh.measurable
    have hYMeas : Measurable Y := by
      change Measurable (fun ω => (N : ℝ) * pairEnergy h (A.X t ω) μ)
      exact measurable_const.mul (hPairMeas.comp hX)
    have hCenterMeas : Measurable (fun ω => Y ω - ∫ ω', Y ω' ∂A.P) :=
      hYMeas.sub_const _
    have hMeanScale : (∫ ω, Y ω ∂A.P) = (N : ℝ) *
        ∫ ω, pairEnergy h (A.X t ω) μ ∂A.P := by
      dsimp [Y]
      rw [integral_const_mul]
    have hCenterEq : (fun ω => Y ω - ∫ ω', Y ω' ∂A.P) =
        (fun ω => (N : ℝ) * (pairEnergy h (A.X t ω) μ -
          ∫ ω', pairEnergy h (A.X t ω') μ ∂A.P)) := by
      funext ω
      rw [hMeanScale]
      dsimp [Y]
      ring
    by_cases hBzero : B = 0
    · have hPairZero := fp81s21_zero_pairEnergy_ae (d := p.d) (N := N)
        (P := A.P) (μ := μ) (ρ := R.ρ u)
        (hd := Nat.le_trans (by decide : 1 ≤ 2) p.hd) hρ (by rfl) A.X t hNoCollision
        hBzero hh
      have hYzero : Y =ᵐ[A.P] fun _ => 0 := by
        filter_upwards [hPairZero] with ω hω
        simp [Y, hω]
      have hMeanZero : (∫ ω, Y ω ∂A.P) = 0 := by
        calc
          (∫ ω, Y ω ∂A.P) = ∫ ω, (0 : ℝ) ∂A.P := integral_congr_ae hYzero
          _ = 0 := by simp
      have hCenteredZero : (fun ω => Y ω - ∫ ω', Y ω' ∂A.P) =ᵐ[A.P] fun _ => 0 := by
        filter_upwards [hYzero] with ω hω
        simp [hMeanZero, hω]
      have hRawLp : eLpNorm Y (ENNReal.ofReal 6) A.P ≤ ENNReal.ofReal 0 := by
        rw [eLpNorm_congr_ae hYzero]
        simp
      have hCenteredLp : eLpNorm (fun ω => Y ω - ∫ ω', Y ω' ∂A.P)
          (ENNReal.ofReal 6) A.P ≤ ENNReal.ofReal 0 := by
        rw [eLpNorm_congr_ae hCenteredZero]
        simp
      have hRawSix := fp81s21_sixthBound_of_eLpNorm A.P Y 0 le_rfl hYMeas hRawLp
      have hCenteredSix := fp81s21_sixthBound_of_eLpNorm A.P
        (fun ω => Y ω - ∫ ω', Y ω' ∂A.P) 0 le_rfl hCenterMeas hCenteredLp
      constructor
      · simpa [Y, hBzero, C, t, μ, r26t3_mu] using hRawSix
      · change SixthBound A.P
          (fun ω => (N : ℝ) * (pairEnergy h (A.X t ω) μ -
            ∫ ω', pairEnergy h (A.X t ω') μ ∂A.P)) (C * B ^ 6)
        rw [← hCenterEq]
        simpa [hBzero] using hCenteredSix
    · have hBpos : 0 < B := hB.lt_of_ne' hBzero
      have hPairLp := fp81s21_pair_eLpNorm_at hρRound hN A.X t hX hActual hBpos hh hCqAt
      have hD0 : 0 ≤ B * Cq := mul_nonneg hB hCq0
      have hScale : (B * Cq) ^ 6 ≤ C * B ^ 6 := by
        dsimp [C]
        calc
          (B * Cq) ^ 6 = B ^ 6 * Cq ^ 6 := by rw [mul_pow]
          _ ≤ B ^ 6 * max (Cq ^ 6) (Cl ^ 6) :=
            mul_le_mul_of_nonneg_left (le_max_left _ _) (by positivity)
          _ = max (Cq ^ 6) (Cl ^ 6) * B ^ 6 := by ring
      have hRawSix := fp81s21_sixthBound_of_eLpNorm A.P Y (B * Cq) hD0 hYMeas hPairLp.1
      have hCenteredLp : eLpNorm (fun ω => Y ω - ∫ ω', Y ω' ∂A.P)
          (ENNReal.ofReal 6) A.P ≤ ENNReal.ofReal (B * Cq) := by
        rw [hCenterEq]
        exact hPairLp.2
      have hCenteredSix := fp81s21_sixthBound_of_eLpNorm A.P
        (fun ω => Y ω - ∫ ω', Y ω' ∂A.P) (B * Cq) hD0 hCenterMeas hCenteredLp
      have hRawOut : SixthBound A.P
          (fun ω => (N : ℝ) * pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u))
          (C * B ^ 6) := by
        simpa [Y, t, μ, r26t3_mu] using
          (show SixthBound A.P Y (C * B ^ 6) from
            ⟨hRawSix.1, hRawSix.2.trans hScale⟩)
      have hCenteredOut : SixthBound A.P
          (fun ω => (N : ℝ) *
            (pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u) -
              ∫ ω', pairEnergy h (A.X u.toNNReal ω') (r26t3_mu R u) ∂A.P))
          (C * B ^ 6) := by
        change SixthBound A.P
          (fun ω => (N : ℝ) * (pairEnergy h (A.X t ω) μ -
            ∫ ω', pairEnergy h (A.X t ω') μ ∂A.P)) (C * B ^ 6)
        rw [← hCenterEq]
        exact ⟨hCenteredSix.1, hCenteredSix.2.trans hScale⟩
      exact ⟨hRawOut, hCenteredOut⟩
  · intro f hf hfb
    let Ylin : A.Ω → ℝ := fun ω => Real.sqrt (N : ℝ) *
      (HRS.Whole.pair (HRS.Whole.empirical (A.X t ω)) f - HRS.Whole.pair μ f)
    have hLinCfgMeas : Measurable (fun Z : EucConfig p.d N => Real.sqrt (N : ℝ) *
        (HRS.Whole.pair (HRS.Whole.empirical Z) f - HRS.Whole.pair μ f)) := by
      have hEmp : ∀ Z : EucConfig p.d N,
          HRS.Whole.pair (HRS.Whole.empirical Z) f = (N : ℝ)⁻¹ * ∑ i, f (Z i) :=
        fun Z => HRS.MS.PrepStat.s32_pair_empirical Z hf
      simp_rw [hEmp]
      exact measurable_const.mul ((measurable_const.mul
        (Finset.measurable_sum _ fun i _ => hf.comp (measurable_pi_apply i))).sub_const _)
    have hYlinMeas : Measurable Ylin := by
      change Measurable (fun ω => Real.sqrt (N : ℝ) *
        (HRS.Whole.pair (HRS.Whole.empirical (A.X t ω)) f - HRS.Whole.pair μ f))
      exact hLinCfgMeas.comp hX
    have hLinActualBound : ∀ N' : ℕ, 2 ≤ N' → ∀ Pcfg : Measure (EucConfig p.d N'),
        HasR2ActualDensity p.s p.β pinf K (HRS.Whole.withDensityReal (R.ρ u)) Pcfg →
        eLpNorm (fun Z : EucConfig p.d N' => Real.sqrt (N' : ℝ) *
          (HRS.Whole.pair (HRS.Whole.empirical Z) f -
            HRS.Whole.pair (HRS.Whole.withDensityReal (R.ρ u)) f))
          (ENNReal.ofReal 6) Pcfg ≤ ENNReal.ofReal (Cl * B) := by
      intro N' hN' Pcfg hActual'
      exact hLinear (R.ρ u) hρRound N' hN' Pcfg hActual' f B hf hfb
    have hLinLp := fp81s21_linear_eLpNorm_at hN A.X t hX hActual f hf hB hLinActualBound
    have hD0 : 0 ≤ Cl * B := mul_nonneg hCl0 hB
    have hLinSix := fp81s21_sixthBound_of_eLpNorm A.P Ylin (Cl * B) hD0 hYlinMeas hLinLp
    have hScale : (Cl * B) ^ 6 ≤ C * B ^ 6 := by
      dsimp [C]
      calc
        (Cl * B) ^ 6 = B ^ 6 * Cl ^ 6 := by rw [mul_pow]; ring
        _ ≤ B ^ 6 * max (Cq ^ 6) (Cl ^ 6) :=
          mul_le_mul_of_nonneg_left (le_max_right _ _) (by positivity)
        _ = max (Cq ^ 6) (Cl ^ 6) * B ^ 6 := by ring
    exact ⟨hLinSix.1, hLinSix.2.trans hScale⟩

/-- Sixth-moment specialization to the physical quadratic field.  The two returned
identities expose both the field's centering and the scaled centering integral. -/
theorem fp81s21_particle_sixth_quadField (p : Parameters) :
    ∃ δ0 : ℝ, 0 < δ0 ∧ δ0 ≤ 1 / 2 ∧
      ∀ δ : ℝ, 0 < δ → δ ≤ δ0 → ∀ R : Trajectory p δ,
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ N : ℕ, 2 ≤ N → ∀ A : Particle R N,
          ∀ u : ℝ, 0 ≤ u → ∀ B : ℝ, 0 ≤ B →
          ∀ f : Euc p.d → ℝ, Measurable f →
            IsBoundedPairKernel p.s B
              (HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x)) →
            SixthBound A.P
              (fun ω => HRS.Whole.r2QuadField p.s (r26t3_mu R u) A.P A.X u ω f)
              (C * B ^ 6) ∧
            (∀ ω, HRS.Whole.r2QuadField p.s (r26t3_mu R u) A.P A.X u ω f =
              (N : ℝ) * (pairEnergy
                (HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x))
                (A.X u.toNNReal ω) (r26t3_mu R u) -
                ∫ ω', pairEnergy
                  (HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x))
                  (A.X u.toNNReal ω') (r26t3_mu R u) ∂A.P)) ∧
            (∫ ω, (N : ℝ) * pairEnergy
                (HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x))
                (A.X u.toNNReal ω) (r26t3_mu R u) ∂A.P =
              (N : ℝ) * ∫ ω, pairEnergy
                (HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x))
                (A.X u.toNNReal ω) (r26t3_mu R u) ∂A.P) := by
  obtain ⟨δ0, hδ0, hδhalf, hSlices⟩ := fp81s21_particle_sixth_slices p
  refine ⟨δ0, hδ0, hδhalf, ?_⟩
  intro δ hδ hδle R
  obtain ⟨C, hC, hAt⟩ := hSlices δ hδ hδle R
  refine ⟨C, hC, ?_⟩
  intro N hN A u hu B hB f hf hKernel
  let h : Euc p.d → Euc p.d → ℝ :=
    HRS.Whole.commutatorKernel p.d p.s (fun x => gradient f x)
  have hPair := hAt N hN A u hu B hB
  have hCentered := (hPair.1 h (by simpa [h] using hKernel)).2
  let Y : A.Ω → ℝ := fun ω => (N : ℝ) *
    pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u)
  have hMeanScale : (∫ ω, Y ω ∂A.P) = (N : ℝ) *
      ∫ ω, pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u) ∂A.P := by
    dsimp [Y]
    rw [integral_const_mul]
  have hFieldEq : (fun ω => HRS.Whole.r2QuadField p.s
      (r26t3_mu R u) A.P A.X u ω f) =
      (fun ω => (N : ℝ) * (pairEnergy h (A.X u.toNNReal ω) (r26t3_mu R u) -
        ∫ ω', pairEnergy h (A.X u.toNNReal ω') (r26t3_mu R u) ∂A.P)) := by
    funext ω
    rw [HRS.Whole.r2QuadField]
  have hSix : SixthBound A.P
      (fun ω => HRS.Whole.r2QuadField p.s (r26t3_mu R u) A.P A.X u ω f)
      (C * B ^ 6) := by
    rw [hFieldEq]
    exact hCentered
  refine ⟨hSix, ?_, hMeanScale⟩
  intro ω
  rfl

