import Mathlib

/-!
# SA27, part 1: finite-dimensional distributions determine laws on `C([0,T]; E)`; tight + fdd convergence

Generic (Mathlib-only) infrastructure, analogue of `HRS.AdjK.adjkd_ext_of_fidi` and
`adjkd_convergence_of_tight_fidi` for an arbitrary separable normed space `E` whose Borel `σ`-algebra is generated by a
family `f : ι → E → ℝ` of continuous functionals (for `E = H^{-q}(ℝ^d)`: the pairings with smooth tests).

* `sa27_ext_of_cyl`: two probability measures on `α` (with `σ`-algebra generated by `f`) with equal finite-dimensional
  marginals `(f (g 0), …, f (g (p-1)))` are equal.
* `sa27_path_gen`, `sa27_path_ext`: the same on `C([0,T]; E)` for the functionals `w ↦ f i (w t)`.
* `sa27_conv_of_tight_fidi`: tightness + convergence of the finite-dimensional marginals ⟹ weak convergence.
* `sa27_tight_of_tendsto`: a weakly convergent sequence of probability measures on a Polish space is tight.
-/

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal BoundedContinuousFunction

noncomputable section

namespace HRS.MS.IidInit

section Cyl

variable {α : Type*} {ι : Type*}

/-- The finite-dimensional evaluation `x ↦ (f (g 0) x, …, f (g (p-1)) x)`. -/
def sa27_fd (f : ι → α → ℝ) {p : ℕ} (g : Fin p → ι) (x : α) : EuclideanSpace ℝ (Fin p) :=
  WithLp.toLp 2 fun a => f (g a) x

/-- Cylinder sets. -/
def sa27_cyl (f : ι → α → ℝ) : Set (Set α) :=
  {S | ∃ (p : ℕ) (g : Fin p → ι) (B : Set (EuclideanSpace ℝ (Fin p))), MeasurableSet B ∧
      S = sa27_fd f g ⁻¹' B}

theorem sa27_proj_continuous {n : ℕ} (p : ℕ) (f : Fin p → Fin n) :
    Continuous fun x : EuclideanSpace ℝ (Fin n) =>
      (WithLp.toLp 2 fun a => x (f a) : EuclideanSpace ℝ (Fin p)) := by
  refine (PiLp.continuous_toLp 2 _).comp (continuous_pi fun a => ?_)
  exact (EuclideanSpace.proj (f a)).continuous

theorem sa27_cyl_isPiSystem (f : ι → α → ℝ) : IsPiSystem (sa27_cyl f) := by
  rintro S1 ⟨p, g, B, hB, rfl⟩ S2 ⟨q, g', B', hB', rfl⟩ -
  let π1 : EuclideanSpace ℝ (Fin (p + q)) → EuclideanSpace ℝ (Fin p) :=
    fun x => WithLp.toLp 2 fun a => x (Fin.castAdd q a)
  let π2 : EuclideanSpace ℝ (Fin (p + q)) → EuclideanSpace ℝ (Fin q) :=
    fun x => WithLp.toLp 2 fun a => x (Fin.natAdd p a)
  have h1 : Measurable π1 := (sa27_proj_continuous p (Fin.castAdd q)).measurable
  have h2 : Measurable π2 := (sa27_proj_continuous q (Fin.natAdd p)).measurable
  refine ⟨p + q, Fin.append g g', π1 ⁻¹' B ∩ π2 ⁻¹' B', (h1 hB).inter (h2 hB'), ?_⟩
  ext w
  simp only [Set.mem_inter_iff, Set.mem_preimage, π1, π2, sa27_fd]
  simp [Fin.append_left, Fin.append_right]

theorem sa27_cyl_gen (f : ι → α → ℝ) :
    MeasurableSpace.generateFrom (sa27_cyl f) =
      ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ) := by
  refine le_antisymm ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    rintro S ⟨p, g, B, hB, rfl⟩
    letI m : MeasurableSpace α :=
      ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ)
    have hm : ∀ a : Fin p, Measurable (f (g a)) := fun a =>
      (comap_measurable (f (g a))).mono
        (le_iSup (fun i => MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ)) (g a))
        le_rfl
    have : Measurable (sa27_fd f g) := by
      unfold sa27_fd
      exact (PiLp.continuous_toLp 2 _).measurable.comp (measurable_pi_iff.2 hm)
    exact this hB
  · refine iSup_le fun i => ?_
    rintro _ ⟨B, hB, rfl⟩
    refine MeasurableSpace.measurableSet_generateFrom ⟨1, fun _ => i,
      {x : EuclideanSpace ℝ (Fin 1) | x 0 ∈ B}, ?_, ?_⟩
    · exact (EuclideanSpace.proj (0 : Fin 1)).continuous.measurable hB
    · ext x; simp [sa27_fd]

theorem sa27_fd_measurable [mα : MeasurableSpace α] (f : ι → α → ℝ)
    (hgen : mα = ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ))
    {p : ℕ} (g : Fin p → ι) : Measurable (sa27_fd f g) := by
  have hm : ∀ a : Fin p, Measurable (f (g a)) := fun a => by
    rw [measurable_iff_comap_le, hgen]
    exact le_iSup (fun i => MeasurableSpace.comap (f i) inferInstance) (g a)
  unfold sa27_fd
  exact (PiLp.continuous_toLp 2 _).measurable.comp (measurable_pi_iff.2 hm)

/-- A probability measure is determined by its finite-dimensional marginals. -/
theorem sa27_ext_of_cyl [mα : MeasurableSpace α] (f : ι → α → ℝ)
    (hgen : mα = ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ))
    (μ ν : Measure α) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (h : ∀ (p : ℕ) (g : Fin p → ι), μ.map (sa27_fd f g) = ν.map (sa27_fd f g)) : μ = ν := by
  refine ext_of_generate_finite (sa27_cyl f) (hgen.trans (sa27_cyl_gen f).symm)
    (sa27_cyl_isPiSystem f) ?_ (by simp)
  rintro S ⟨p, g, B, hB, rfl⟩
  have hm := sa27_fd_measurable f hgen g
  have := congrArg (fun κ => κ B) (h p g)
  simpa [Measure.map_apply hm hB] using this

end Cyl

section Path

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [SecondCountableTopology E]
  [mE : MeasurableSpace E] [BorelSpace E] {ι : Type*} (T : ℝ)

/-- The functionals `w ↦ f i (w t)` on `C([0,T]; E)`. -/
def sa27_pathF (f : ι → E → ℝ) (j : Set.Icc (0 : ℝ) T × ι) (w : C(Set.Icc (0 : ℝ) T, E)) : ℝ :=
  f j.2 (w j.1)

theorem sa27_path_gen (f : ι → E → ℝ)
    (hgen : mE = ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ)) :
    (inferInstance : MeasurableSpace C(Set.Icc (0 : ℝ) T, E)) =
      ⨆ j, MeasurableSpace.comap (sa27_pathF T f j) (inferInstance : MeasurableSpace ℝ) := by
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
  have h1 : ∀ t : Set.Icc (0 : ℝ) T, mE.comap (fun w : C(Set.Icc (0 : ℝ) T, E) => w t) =
      ⨆ i : ι, MeasurableSpace.comap (sa27_pathF T f (t, i)) (inferInstance : MeasurableSpace ℝ) :=
    fun t => by
      have := congrArg (MeasurableSpace.comap (fun w : C(Set.Icc (0 : ℝ) T, E) => w t)) hgen
      rw [this, MeasurableSpace.comap_iSup]
      refine iSup_congr fun i => ?_
      rw [MeasurableSpace.comap_comp]
      rfl
  refine (iSup_congr h1).trans ?_
  exact (iSup_prod (f := fun j : Set.Icc (0 : ℝ) T × ι =>
    MeasurableSpace.comap (sa27_pathF T f j) (inferInstance : MeasurableSpace ℝ))).symm

theorem sa27_path_ext (f : ι → E → ℝ)
    (hgen : mE = ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ))
    (μ ν : Measure C(Set.Icc (0 : ℝ) T, E)) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (h : ∀ (p : ℕ) (g : Fin p → Set.Icc (0 : ℝ) T × ι),
      μ.map (sa27_fd (sa27_pathF T f) g) = ν.map (sa27_fd (sa27_pathF T f) g)) : μ = ν :=
  sa27_ext_of_cyl (sa27_pathF T f) (sa27_path_gen T f hgen) μ ν h

theorem sa27_pathF_continuous (f : ι → E → ℝ) (hfc : ∀ i, Continuous (f i))
    (j : Set.Icc (0 : ℝ) T × ι) : Continuous (sa27_pathF T f j) :=
  (hfc j.2).comp (continuous_eval_const j.1)

theorem sa27_fd_continuous {α : Type*} [TopologicalSpace α] (f : ι → α → ℝ) (hfc : ∀ i, Continuous (f i))
    {p : ℕ} (g : Fin p → ι) : Continuous (sa27_fd f g) :=
  (PiLp.continuous_toLp 2 _).comp (continuous_pi fun a => hfc (g a))

/-- Tightness and convergence of the finite-dimensional marginals give weak convergence. -/
theorem sa27_conv_of_tight_fidi (f : ι → E → ℝ) (hfc : ∀ i, Continuous (f i))
    (hgen : mE = ⨆ i, MeasurableSpace.comap (f i) (inferInstance : MeasurableSpace ℝ))
    (μ : ℕ → Measure C(Set.Icc (0 : ℝ) T, E)) [∀ n, IsProbabilityMeasure (μ n)]
    (μ' : Measure C(Set.Icc (0 : ℝ) T, E)) [IsProbabilityMeasure μ']
    (htight : IsTightMeasureSet (Set.range μ))
    (hfdd : ∀ (p : ℕ) (g : Fin p → Set.Icc (0 : ℝ) T × ι)
      (h : EuclideanSpace ℝ (Fin p) →ᵇ ℝ),
      Tendsto (fun n => ∫ y, h y ∂((μ n).map (sa27_fd (sa27_pathF T f) g))) atTop
        (𝓝 (∫ y, h y ∂(μ'.map (sa27_fd (sa27_pathF T f) g))))) :
    ∀ F : C(Set.Icc (0 : ℝ) T, E) →ᵇ ℝ,
      Tendsto (fun n => ∫ w, F w ∂(μ n)) atTop (𝓝 (∫ w, F w ∂μ')) := by
  classical
  let ν : ℕ → ProbabilityMeasure C(Set.Icc (0 : ℝ) T, E) := fun n => ⟨μ n, inferInstance⟩
  let ν' : ProbabilityMeasure C(Set.Icc (0 : ℝ) T, E) := ⟨μ', inferInstance⟩
  have hcomp : IsCompact (closure (Set.range ν)) := by
    apply isCompact_closure_of_isTightMeasureSet
    refine htight.subset ?_
    rintro _ ⟨_, ⟨n, rfl⟩, rfl⟩
    exact ⟨n, rfl⟩
  have hT : Tendsto ν atTop (𝓝 ν') := by
    refine hcomp.tendsto_nhds_of_unique_mapClusterPt
      (Eventually.of_forall fun n => subset_closure ⟨n, rfl⟩) ?_
    intro κ _ hκ
    have hext : (κ : Measure C(Set.Icc (0 : ℝ) T, E)) = μ' := by
      refine sa27_path_ext T f hgen _ _ fun p g => ?_
      have hG := sa27_fd_continuous (sa27_pathF T f) (sa27_pathF_continuous T f hfc) g
      have h1 : Tendsto (fun n => ProbabilityMeasure.map (ν n) (sa27_fd (sa27_pathF T f) g)) atTop
          (𝓝 (ProbabilityMeasure.map ν' (sa27_fd (sa27_pathF T f) g))) := by
        rw [ProbabilityMeasure.tendsto_iff_forall_integral_tendsto]
        intro h
        exact hfdd p g h
      have h2 : MapClusterPt (ProbabilityMeasure.map κ (sa27_fd (sa27_pathF T f) g)) atTop
          (fun n => ProbabilityMeasure.map (ν n) (sa27_fd (sa27_pathF T f) g)) :=
        hκ.continuousAt_comp (f := fun κ : ProbabilityMeasure C(Set.Icc (0 : ℝ) T, E) =>
          ProbabilityMeasure.map κ (sa27_fd (sa27_pathF T f) g))
          (ProbabilityMeasure.continuous_map hG).continuousAt
      have h4 : ProbabilityMeasure.map κ (sa27_fd (sa27_pathF T f) g) = ProbabilityMeasure.map ν' (sa27_fd (sa27_pathF T f) g) :=
        eq_of_nhds_neBot (ClusterPt.mono h2 h1)
      have h6 := congrArg (fun κ : ProbabilityMeasure (EuclideanSpace ℝ (Fin p)) =>
        (κ : Measure (EuclideanSpace ℝ (Fin p)))) h4
      exact h6
    exact Subtype.ext hext
  intro F
  have := (ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.1 hT) F
  simpa [ν, ν'] using this

end Path

section Tight

variable {X : Type*} [PseudoMetricSpace X] [SecondCountableTopology X] [CompleteSpace X]
  [MeasurableSpace X] [BorelSpace X]

/-- A weakly convergent sequence of probability measures on a Polish space is tight. -/
theorem sa27_tight_of_tendsto (μ : ℕ → Measure X) [∀ n, IsProbabilityMeasure (μ n)]
    (μ' : Measure X) [IsProbabilityMeasure μ']
    (h : ∀ F : X →ᵇ ℝ, Tendsto (fun n => ∫ x, F x ∂(μ n)) atTop (𝓝 (∫ x, F x ∂μ'))) :
    IsTightMeasureSet (Set.range μ) := by
  let ν : ℕ → ProbabilityMeasure X := fun n => ⟨μ n, inferInstance⟩
  let ν' : ProbabilityMeasure X := ⟨μ', inferInstance⟩
  have hT : Tendsto ν atTop (𝓝 ν') := by
    rw [ProbabilityMeasure.tendsto_iff_forall_integral_tendsto]
    intro F
    simpa [ν, ν'] using h F
  have hc : IsCompact (insert ν' (Set.range ν)) := hT.isCompact_insert_range
  have hcl : closure (Set.range ν) ⊆ insert ν' (Set.range ν) :=
    closure_minimal (Set.subset_insert _ _) hc.isClosed
  have hcc : IsCompact (closure (Set.range ν)) := hc.of_isClosed_subset isClosed_closure hcl
  have := isTightMeasureSet_of_isCompact_closure hcc
  convert this using 1
  ext κ
  simp only [Set.mem_range, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨n, rfl⟩
    exact ⟨ν n, ⟨n, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨n, rfl⟩, rfl⟩
    exact ⟨n, rfl⟩

end Tight

end HRS.MS.IidInit
