import HRS.MS.MainRdPathAux22
import HRS.MS.IidInitAux8

/-!
# S.A.9, packet P6a: weak convergence on `C([0,T]; H^{-q})` from tightness and the convergence of the pairings with
Schwartz tests

* `sa9_hneg_gen_sch`: the Borel `σ`-algebra of `H^{-q}` is generated by the pairings with the Schwartz tests
  (`mhn_phi (h ℓ)` of a Parseval system are Schwartz);
* `sa9_path_conv_sch`: tightness of the path laws plus convergence of the finite-dimensional laws of the pairings with
  Schwartz tests at finitely many times imply weak convergence.
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal BigOperators ContDiff BoundedContinuousFunction

namespace HRS.MS.MainRdPath

open HRS HRS.Whole HRS.Whole.AppendixA HRS.Whole.AppendixALemmas HRS.MP.HNegInfra HRS.MP.RdInit
  HRS.MS.IidInit

variable {d : ℕ}

/-- Schwartz test functions. -/
abbrev sa9_Sch (d : ℕ) : Type := {φ : Euc d → ℝ // ∃ ψ : SchwartzMap (Euc d) ℝ, ⇑ψ = φ}

/-- The pairing with a Schwartz test as a function on `H^{-q}`. -/
def sa9_pfS (d q : ℕ) (φ : sa9_Sch d) (F : HNeg d (q : ℝ)) : ℝ := HNeg.pairing φ.1 F

theorem sa9_sch_test (q : ℕ) (φ : sa9_Sch d) : IsSobolevTest (q : ℝ) φ.1 := by
  obtain ⟨φ, ψ, rfl⟩ := φ
  exact HRS.MS.PathFidi.sa26_schwartz_sob ψ q

theorem sa9_pfS_continuous (q : ℕ) (φ : sa9_Sch d) : Continuous (sa9_pfS d q φ) :=
  mhn_continuous_pairing (sa9_sch_test q φ)

/-- `mhn_phi h` is a Schwartz function. -/
theorem sa9_mhn_phi_sch (h : mhn_Hc d) : ∃ ψ : SchwartzMap (Euc d) ℝ, ⇑ψ = mhn_phi h :=
  ⟨(mhn_U h).postcompCLM (𝕜 := ℝ) Complex.reCLM, by
    funext x
    simp [SchwartzMap.postcompCLM_apply, mhn_phi]⟩

theorem sa9_measurable_iff_parseval {q : ℕ} {Ω : Type*} [MeasurableSpace Ω] (h : ℕ → mhn_Hc d)
    (hP : ∀ F : HNeg d (q : ℝ), HasSum (fun n => (inner ℝ (mhn_rep (q : ℝ) (h n)) F) ^ 2) (‖F‖ ^ 2))
    (F : Ω → HNeg d (q : ℝ)) :
    Measurable F ↔ ∀ n, Measurable (fun x => HNeg.pairing (mhn_phi (h n)) (F x)) := by
  let T : HNeg d (q : ℝ) → (ℕ → ℝ) := fun G n => HNeg.pairing (mhn_phi (h n)) G
  have hTc : Continuous T := continuous_pi (fun n => mhn_continuous_pairing (mhn_isSobolevTest_phi _ (h n)))
  have hTi : Function.Injective T := by
    intro G H hGH
    have h0 : ∀ n, (inner ℝ (mhn_rep (q : ℝ) (h n)) (G - H)) ^ 2 = 0 := by
      intro n
      rw [← mhn_pairing_phi, mhn_pairing_sub (mhn_isSobolevTest_phi _ (h n)),
        show HNeg.pairing (mhn_phi (h n)) G = HNeg.pairing (mhn_phi (h n)) H from congrFun hGH n]
      simp
    have hs := hP (G - H)
    simp only [h0] at hs
    have : ‖G - H‖ ^ 2 = 0 := hs.unique hasSum_zero
    exact sub_eq_zero.1 (norm_eq_zero.1 (pow_eq_zero_iff (two_ne_zero) |>.1 this))
  have hemb : MeasurableEmbedding T := hTc.measurableEmbedding hTi
  constructor
  · intro hF n
    exact (measurable_pi_apply n).comp (hTc.measurable.comp hF)
  · intro hh
    rw [← hemb.measurable_comp_iff]
    exact measurable_pi_iff.2 hh

theorem sa9_hneg_gen_sch (q : ℕ) :
    (inferInstance : MeasurableSpace (HNeg d (q : ℝ))) =
      ⨆ φ : sa9_Sch d, MeasurableSpace.comap (sa9_pfS d q φ) (inferInstance : MeasurableSpace ℝ) := by
  refine le_antisymm ?_ ?_
  · obtain ⟨h, hP⟩ := mri_parseval_h (d := d) (q : ℝ)
    set m : MeasurableSpace (HNeg d (q : ℝ)) :=
      ⨆ φ : sa9_Sch d, MeasurableSpace.comap (sa9_pfS d q φ) (inferInstance : MeasurableSpace ℝ) with hm
    have hid : @Measurable (HNeg d (q : ℝ)) (HNeg d (q : ℝ)) m (instMeasurableSpaceHNeg (q : ℝ))
        (id : HNeg d (q : ℝ) → HNeg d (q : ℝ)) := by
      refine (@sa9_measurable_iff_parseval d q (HNeg d (q : ℝ)) m h hP id).2 fun n => ?_
      exact (comap_measurable (sa9_pfS d q ⟨mhn_phi (h n), sa9_mhn_phi_sch (h n)⟩)).mono
        (le_iSup (fun φ : sa9_Sch d => MeasurableSpace.comap (sa9_pfS d q φ)
          (inferInstance : MeasurableSpace ℝ)) ⟨mhn_phi (h n), sa9_mhn_phi_sch (h n)⟩) le_rfl
    have := (@measurable_iff_comap_le (HNeg d (q : ℝ)) (HNeg d (q : ℝ)) m (instMeasurableSpaceHNeg (q : ℝ))
      id).1 hid
    rw [MeasurableSpace.comap_id] at this
    exact this
  · refine iSup_le fun φ => ?_
    exact measurable_iff_comap_le.1 (sa9_pfS_continuous q φ).measurable

theorem sa9_path_conv_sch (q : ℕ) (T : ℝ) (μ : ℕ → Measure C(Set.Icc (0 : ℝ) T, HNeg d (q : ℝ)))
    [∀ n, IsProbabilityMeasure (μ n)] (μ' : Measure C(Set.Icc (0 : ℝ) T, HNeg d (q : ℝ)))
    [IsProbabilityMeasure μ'] (htight : IsTightMeasureSet (Set.range μ))
    (hfdd : ∀ (p : ℕ) (g : Fin p → Set.Icc (0 : ℝ) T × sa9_Sch d)
      (h : EuclideanSpace ℝ (Fin p) →ᵇ ℝ),
      Tendsto (fun n => ∫ y, h y ∂((μ n).map (sa27_fd (sa27_pathF T (sa9_pfS d q)) g))) atTop
        (𝓝 (∫ y, h y ∂(μ'.map (sa27_fd (sa27_pathF T (sa9_pfS d q)) g))))) :
    ∀ F : C(Set.Icc (0 : ℝ) T, HNeg d (q : ℝ)) →ᵇ ℝ,
      Tendsto (fun n => ∫ w, F w ∂(μ n)) atTop (𝓝 (∫ w, F w ∂μ')) :=
  sa27_conv_of_tight_fidi T (sa9_pfS d q) (sa9_pfS_continuous q) (sa9_hneg_gen_sch q) μ μ' htight hfdd

end HRS.MS.MainRdPath
