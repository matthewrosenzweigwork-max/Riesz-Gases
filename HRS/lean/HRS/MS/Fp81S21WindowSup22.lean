import HRS.MS.Fp81S21WindowSup21
import HRS.MS.R2WinErrNL2

/-!
# S2.1(iii), packet 9d: terminal-derivative kernel measurability

`S104nOrbit.jcont` is joint continuity on the triangle `0 ≤ v ≤ s ≤ T` of
`∇U^{v,s}(L_s φ)`. Extend this family by zero outside the triangle, then the
commutator kernel is jointly measurable in both time parameters and its two
spatial variables.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

noncomputable section

open MeasureTheory Set Topology

namespace HRS.Fp81.S21

open HRS HRS.Whole HRS.MS.R2WinErr HRS.MS.R2Interp

private def fp81s21_terminal_good_times (T : ℝ) : Set (ℝ × ℝ) :=
  {a | 0 ≤ a.1} ∩ ({a | a.1 ≤ a.2} ∩ {a | a.2 ≤ T})

/-- The propagated terminal derivative has a jointly measurable gradient on
the full two-time plane after zero extension from its S104nOrbit triangle. -/
theorem fp81s21_window_terminal_derivative_gradient_joint_meas
    {d : ℕ} (C : WholeCoeff d) (φ : Euc d → ℝ) {T : ℝ}
    (horb : S104nOrbit C φ T) :
    ∃ V : (ℝ × ℝ) → Euc d → Euc d,
      Measurable (Function.uncurry V) ∧
      ∀ v s, 0 ≤ v → v ≤ s → s ≤ T → ∀ x,
        V (v, s) x =
          gradient (propagatorW C v s (generatorW C s φ)) x := by
  classical
  let goodTime := fp81s21_terminal_good_times T
  let good : Set ((ℝ × ℝ) × Euc d) := goodTime ×ˢ (Set.univ : Set (Euc d))
  have hA : IsClosed {a : ℝ × ℝ | 0 ≤ a.1} := by
    exact isClosed_le continuous_const continuous_fst
  have hB : IsClosed {a : ℝ × ℝ | a.1 ≤ a.2} := by
    exact isClosed_le continuous_fst continuous_snd
  have hC : IsClosed {a : ℝ × ℝ | a.2 ≤ T} := by
    exact isClosed_le continuous_snd continuous_const
  have hGoodTime : IsClosed goodTime := by
    dsimp [goodTime, fp81s21_terminal_good_times]
    exact hA.inter (hB.inter hC)
  have hgood : MeasurableSet good := hGoodTime.measurableSet.prod MeasurableSet.univ
  let raw : ((ℝ × ℝ) × Euc d) → Euc d := fun q =>
    gradient (propagatorW C q.1.1 q.1.2 (generatorW C q.1.2 φ)) q.2
  have hraw : ContinuousOn raw good := by
    rw [continuousOn_iff_continuous_restrict]
    let J : good → ℝ × ℝ × Euc d := fun q => (q.1.1.2, q.1.1.1, q.1.2)
    have hJ : Continuous J := by fun_prop
    have hJmem : MapsTo J Set.univ {z : ℝ × ℝ × Euc d |
        0 ≤ z.2.1 ∧ z.2.1 ≤ z.1 ∧ z.1 ≤ T} := by
      intro q _
      rcases Set.mem_prod.1 q.2 with ⟨hqt, _⟩
      rcases hqt with ⟨hv, hrest⟩
      rcases hrest with ⟨hvs, hs⟩
      exact ⟨hv, hvs, hs⟩
    have hcomp := horb.jcont.comp hJ.continuousOn hJmem
    have hcomp' : Continuous (good.domRestrict raw) := by
      apply continuousOn_univ.1
      refine ContinuousOn.congr hcomp ?_
      intro q hq
      simp [J, raw]
    exact hcomp'
  let Vjoint : ((ℝ × ℝ) × Euc d) → Euc d :=
    Set.piecewise good raw (fun _ => 0)
  have hVjoint : Measurable Vjoint :=
    ContinuousOn.measurable_piecewise hraw continuousOn_const hgood
  let V : (ℝ × ℝ) → Euc d → Euc d := fun a x => Vjoint (a, x)
  refine ⟨V, ?_, ?_⟩
  · change Measurable Vjoint
    exact hVjoint
  · intro v s hv hvs hs x
    have hmem : (v, s) ∈ goodTime := by
      simp [goodTime, fp81s21_terminal_good_times, hv, hvs, hs]
    have hmem' : ((v, s), x) ∈ good := Set.mem_prod.2 ⟨hmem, Set.mem_univ _⟩
    simp [V, Vjoint, Set.piecewise, hmem', raw]

/-- Joint measurability of the Riesz commutator kernel generated by any jointly
measurable two-parameter vector-field family. -/
theorem fp81s21_param_commutator_kernel_joint_meas
    {d : ℕ} (σ : ℝ) {V : (ℝ × ℝ) → Euc d → Euc d}
    (hV : Measurable (Function.uncurry V)) :
    Measurable (fun q : (ℝ × ℝ) × Euc d × Euc d =>
      commutatorKernel d σ (V q.1) q.2.1 q.2.2) := by
  unfold commutatorKernel
  have hVx : Measurable fun q : (ℝ × ℝ) × Euc d × Euc d => V q.1 q.2.1 :=
    hV.comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd))
  have hVy : Measurable fun q : (ℝ × ℝ) × Euc d × Euc d => V q.1 q.2.2 :=
    hV.comp (measurable_fst.prodMk (measurable_snd.comp measurable_snd))
  have hgrad : Measurable fun q : (ℝ × ℝ) × Euc d × Euc d =>
      rieszKernelGrad d σ (q.2.1 - q.2.2) := by
    exact movtr_rieszKernelGrad_measurable (d := d) σ |>.comp
      ((measurable_fst.comp measurable_snd).sub
        (measurable_snd.comp measurable_snd))
  exact (hVx.sub hVy).inner hgrad

#print axioms fp81s21_window_terminal_derivative_gradient_joint_meas
#print axioms fp81s21_param_commutator_kernel_joint_meas

end HRS.Fp81.S21

end
