import HRS.MP.HNegInfra
import HRS.MS.IidInitAux1

/-!
# SA27, part 2: `H^{-q}(ℝ^d)` and the pairings with smooth tests

The Borel `σ`-algebra of `H^{-q}(ℝ^d)` is generated by the pairings with the smooth tests `IsSobolevTest q`
(`sa27_hneg_gen`, from `hneg_measurable_iff`); consequences: laws on `H^{-q}` and on `C([0,T]; H^{-q})` are determined by the
finite-dimensional marginals of the pairings (`sa27_hneg_ext`), and tight + fdd convergence gives weak convergence
(`sa27_hneg_path_conv`).
-/

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal BoundedContinuousFunction

noncomputable section

namespace HRS.MS.IidInit

open HRS HRS.Whole HRS.MP.HNegInfra

variable {d : ℕ}

/-- Smooth tests of `H^q`. -/
abbrev sa27_Tst (d : ℕ) (q : ℝ) : Type := {φ : Euc d → ℝ // IsSobolevTest q φ}

/-- The pairing with a smooth test as a function on `H^{-q}`. -/
def sa27_pf (d : ℕ) (q : ℝ) (φ : sa27_Tst d q) (F : HNeg d q) : ℝ := HNeg.pairing φ.1 F

theorem sa27_pf_continuous (q : ℝ) (φ : sa27_Tst d q) : Continuous (sa27_pf d q φ) :=
  mhn_continuous_pairing φ.2

theorem sa27_hneg_gen (q : ℝ) :
    (inferInstance : MeasurableSpace (HNeg d q)) =
      ⨆ φ : sa27_Tst d q, MeasurableSpace.comap (sa27_pf d q φ) (inferInstance : MeasurableSpace ℝ) := by
  refine le_antisymm ?_ ?_
  · obtain ⟨φ, hφ, -, hnorm⟩ := hneg_norming d q
    set m : MeasurableSpace (HNeg d q) :=
      ⨆ φ : sa27_Tst d q, MeasurableSpace.comap (sa27_pf d q φ) (inferInstance : MeasurableSpace ℝ) with hm
    have hid : @Measurable (HNeg d q) (HNeg d q) m (instMeasurableSpaceHNeg q)
        (id : HNeg d q → HNeg d q) := by
      refine (@hneg_measurable_iff d q (HNeg d q) m φ hφ hnorm id).2 fun n => ?_
      exact (comap_measurable (sa27_pf d q ⟨φ n, hφ n⟩)).mono
        (le_iSup (fun φ : sa27_Tst d q => MeasurableSpace.comap (sa27_pf d q φ)
          (inferInstance : MeasurableSpace ℝ)) ⟨φ n, hφ n⟩) le_rfl
    have := (@measurable_iff_comap_le (HNeg d q) (HNeg d q) m (instMeasurableSpaceHNeg q) id).1 hid
    rw [MeasurableSpace.comap_id] at this
    exact this
  · refine iSup_le fun φ => ?_
    exact measurable_iff_comap_le.1 (sa27_pf_continuous q φ).measurable

/-- A probability measure on `H^{-q}` is determined by the laws of finite vectors of pairings. -/
theorem sa27_hneg_ext (q : ℝ) (μ ν : Measure (HNeg d q)) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν]
    (h : ∀ (p : ℕ) (g : Fin p → sa27_Tst d q),
      μ.map (sa27_fd (sa27_pf d q) g) = ν.map (sa27_fd (sa27_pf d q) g)) : μ = ν :=
  sa27_ext_of_cyl (sa27_pf d q) (sa27_hneg_gen q) μ ν h

/-- Tightness and convergence of the finite-dimensional laws of the pairings give weak convergence on
`C([0,T]; H^{-q})`. -/
theorem sa27_hneg_path_conv (q T : ℝ)
    (μ : ℕ → Measure C(Set.Icc (0 : ℝ) T, HNeg d q)) [∀ n, IsProbabilityMeasure (μ n)]
    (μ' : Measure C(Set.Icc (0 : ℝ) T, HNeg d q)) [IsProbabilityMeasure μ']
    (htight : IsTightMeasureSet (Set.range μ))
    (hfdd : ∀ (p : ℕ) (g : Fin p → Set.Icc (0 : ℝ) T × sa27_Tst d q)
      (h : EuclideanSpace ℝ (Fin p) →ᵇ ℝ),
      Tendsto (fun n => ∫ y, h y ∂((μ n).map (sa27_fd (sa27_pathF T (sa27_pf d q)) g))) atTop
        (𝓝 (∫ y, h y ∂(μ'.map (sa27_fd (sa27_pathF T (sa27_pf d q)) g))))) :
    ∀ F : C(Set.Icc (0 : ℝ) T, HNeg d q) →ᵇ ℝ,
      Tendsto (fun n => ∫ w, F w ∂(μ n)) atTop (𝓝 (∫ w, F w ∂μ')) :=
  sa27_conv_of_tight_fidi T (sa27_pf d q) (sa27_pf_continuous q) (sa27_hneg_gen q) μ μ' htight hfdd

end HRS.MS.IidInit
