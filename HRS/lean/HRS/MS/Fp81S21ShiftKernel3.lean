open MeasureTheory Filter Topology ProbabilityTheory Function
open scoped ENNReal NNReal BigOperators RealInnerProductSpace ContDiff

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 400000
noncomputable section

namespace HRS.Fp81.S21

open HRS (Euc)
open HRS.Whole
open HRS.MS.R26T3

/-- On every bounded shift interval, the commutator kernels generated by the
compatible corrector gradients have a finite-rank net in product-law `L²`.
The centers and both envelope constants are chosen before the shift. -/
theorem fp81s21_compat_kernel_finite_L2_net
    {p : Parameters} {δ : ℝ} (hδ : 0 < δ) (hδh : δ ≤ 1 / 2)
    (R : Trajectory p δ) (F : fp81s21_CompatPotentialFamily R)
    {C c : ℝ} (hC : 0 ≤ C) (hc : 0 ≤ c)
    (hdecay : ∀ a : Set.Ici (0 : ℝ), ∀ j : ℕ,
      HasCbBound (fp81s21_k0 p.d)
        (C * Real.exp (-c * (a : ℝ)) * r26t3_feature_weight p.d j)
        (gradient ((F a).χ j))) :
    ∀ M : ℝ, 0 ≤ M → ∀ j : ℕ,
      let k : Set.Ici (0 : ℝ) → Euc p.d → Euc p.d → ℝ :=
        fun a x y => commutatorKernel p.d p.s (gradient ((F a).χ j)) x y
      ∃ B C₂ : ℝ, 0 ≤ B ∧ 0 ≤ C₂ ∧
        (∀ a : Set.Ici (0 : ℝ), (a : ℝ) ≤ M →
          IsBoundedPairKernel p.s B (k a)) ∧
        ∀ η : ℝ, 0 < η →
          ∃ m : ℕ, ∃ D : Fin m → fp81s21_RankKernel p.d,
            (∀ i, IsBoundedPairKernel p.s (C₂ * B) (D i).kernel) ∧
            ∀ a : Set.Ici (0 : ℝ), (a : ℝ) ≤ M →
              ∃ i : Fin m,
                eLpNorm
                  (fun z : Euc p.d × Euc p.d =>
                    k a z.1 z.2 - (D i).kernel z.1 z.2)
                  (ENNReal.ofReal 2) ((r26t3_mu R 0).prod (r26t3_mu R 0))
                    ≤ ENNReal.ofReal η := by
  intro M hM j
  classical
  let μ : Measure (Euc p.d) := r26t3_mu R 0
  obtain ⟨Mρ, Lρ, hρ⟩ := s21f_round2Density_init hδ hδh R
  have hμ : IsProbabilityMeasure μ := by
    change IsProbabilityMeasure (HRS.Whole.withDensityReal (R.ρ 0))
    exact HRS.Whole.U1.u1_isProb hρ.prob
  letI : IsProbabilityMeasure μ := hμ
  have hle : μ ≤ ENNReal.ofReal Mρ • (volume : Measure (Euc p.d)) := by
    change HRS.Whole.withDensityReal (R.ρ 0) ≤ _
    exact HRS.Whole.U1.u1_le_smul hρ.bdd
  obtain ⟨C₀, hU1⟩ := HRS.Whole.U1.round2_approximation_proof
    p.hd p.s p.hs0 p.hs
  let C₂ : ℝ := max C₀ 0
  have hC₂ : 0 ≤ C₂ := le_max_right _ _
  let wj : ℝ := r26t3_feature_weight p.d j
  have hwj : 0 ≤ wj := by
    dsimp [wj, r26t3_feature_weight]
    apply mul_nonneg
    · apply Real.rpow_nonneg
      positivity
    · exact Real.rpow_nonneg (oscEigenvalue_pos _).le _
  let Λ : ℝ := 3 * C * wj
  have hΛ : 0 ≤ Λ := by dsimp [Λ]; positivity
  let B : ℝ := (p.s + 1) * Λ
  have hB : 0 ≤ B := by
    dsimp [B]
    apply mul_nonneg
    · linarith [p.hs0]
    · exact hΛ
  let v : Set.Ici (0 : ℝ) → HRS.MS.R2S11.s11V p.d Λ := fun a =>
    ⟨gradient ((F a).χ j),
      fp81s21_compat_gradient_velocityBall R F hC hc hdecay a j⟩
  have hboundedV : ∀ u : HRS.MS.R2S11.s11V p.d Λ,
      IsBoundedPairKernel p.s B (commutatorKernel p.d p.s u.1) := by
    intro u
    have hLip : LipschitzWith (Real.toNNReal Λ) u.1 := by
      simpa [max_eq_left hΛ] using HRS.MS.R2S11.s11_V_lip u
    have hb := S99.s99_comm_isBounded p.hs0 (Real.toNNReal Λ)
      hLip
    simpa [B, Real.coe_toNNReal _ hΛ] using hb
  have hkernelBound : ∀ a : Set.Ici (0 : ℝ),
      IsBoundedPairKernel p.s B (fun x y =>
        commutatorKernel p.d p.s (gradient ((F a).χ j)) x y) := by
    intro a
    simpa [v] using hboundedV (v a)
  refine ⟨B, C₂, hB, hC₂, ?_, ?_⟩
  · intro a haM
    simpa using hkernelBound a
  · intro η hη
    have h2s : (2 : ℝ) * p.s < (p.d : ℝ) := by
      have hdR : (2 : ℝ) ≤ (p.d : ℝ) := by exact_mod_cast p.hd
      nlinarith [p.hs]
    obtain ⟨Vnet, hVnet⟩ := HRS.MS.R2S11.s11_net_Lr
      (s := p.s) (r := 2) p.hs0 (by norm_num) h2s Λ (μ' := μ) hle
      (ε := η / 2) (by positivity)
    let I := {u : HRS.MS.R2S11.s11V p.d Λ // u ∈ Vnet}
    letI : Fintype I := Fintype.ofFinite I
    let m : ℕ := Fintype.card I
    let e : I ≃ Fin m := Fintype.equivFin I
    let center : Fin m → HRS.MS.R2S11.s11V p.d Λ := fun i => (e.symm i).1
    have hex : ∀ i : Fin m, ∃ hj : ℕ → Euc p.d → Euc p.d → ℝ,
        IsRound2Approx p.s C₀ B μ
          (commutatorKernel p.d p.s (center i).1) hj := by
      intro i
      obtain ⟨hj, hA⟩ := hU1 Mρ Lρ (R.ρ 0) hρ B
        (commutatorKernel p.d p.s (center i).1) (hboundedV (center i))
      refine ⟨hj, ?_⟩
      simpa [μ, r26t3_mu] using hA
    choose hj hA using hex
    have h2s' : (2 : ℝ) * p.s < (p.d : ℝ) := h2s
    have hconv : ∀ i : Fin m,
        Tendsto (fun n => eLpNorm
          (fun z : Euc p.d × Euc p.d =>
            hj i n z.1 z.2 - commutatorKernel p.d p.s (center i).1 z.1 z.2)
          (ENNReal.ofReal 2) (μ.prod μ)) atTop (𝓝 0) := by
      intro i
      exact (hA i).converges 2 (by norm_num) h2s'
    have hnex : ∀ i : Fin m, ∃ n : ℕ,
        eLpNorm
          (fun z : Euc p.d × Euc p.d =>
            hj i n z.1 z.2 - commutatorKernel p.d p.s (center i).1 z.1 z.2)
          (ENNReal.ofReal 2) (μ.prod μ) ≤ ENNReal.ofReal (η / 2) := by
      intro i
      have hpos : 0 < ENNReal.ofReal (η / 2) := ENNReal.ofReal_pos.2 (by positivity)
      exact ((ENNReal.tendsto_nhds_zero.1 (hconv i)) _ hpos).exists
    choose n hn using hnex
    choose rankN rankC rankU hvalid hEq using fun i : Fin m => (hA i).finiteRank (n i)
    let D : Fin m → fp81s21_RankKernel p.d := fun i =>
      ⟨rankN i, rankC i, rankU i, hvalid i⟩
    have hEqD : ∀ i : Fin m, hj i (n i) = (D i).kernel := by
      intro i
      simpa [D, fp81s21_RankKernel.kernel] using hEq i
    have hDbounded : ∀ i : Fin m,
        IsBoundedPairKernel p.s (C₂ * B) (D i).kernel := by
      intro i
      have hb := HRS.MS.R2Chaos.s94_approx_bounded (hA i) (n i)
      have hbD : IsBoundedPairKernel p.s (C₀ * B) (D i).kernel := by
        simpa [D, fp81s21_RankKernel.kernel, hEq i] using hb
      refine ⟨hbD.measurable, hbD.symm, ?_⟩
      intro x y hxy
      have hweight := HRS.MS.R2S11.s11_rieszWeight_nonneg
        (d := p.d) p.s (x - y)
      have hfactor : 0 ≤ 1 + rieszWeight p.s (x - y) := by linarith
      have hcoeff : C₀ * B ≤ C₂ * B :=
        mul_le_mul_of_nonneg_right (le_max_left C₀ 0) hB
      exact (hbD.bound x y hxy).trans
        (mul_le_mul_of_nonneg_right hcoeff hfactor)
    have h2one : (1 : ℝ≥0∞) ≤ ENNReal.ofReal 2 := by norm_num
    refine ⟨m, D, hDbounded, ?_⟩
    intro a haM
    obtain ⟨u, huV, huErr⟩ := hVnet (v a)
    let i : Fin m := e ⟨u, huV⟩
    have hcenter : center i = u := by
      dsimp [center, i]
      simp [e]
    let f₁ : Euc p.d × Euc p.d → ℝ := fun z =>
      commutatorKernel p.d p.s (gradient ((F a).χ j)) z.1 z.2 -
        commutatorKernel p.d p.s (center i).1 z.1 z.2
    let f₂ : Euc p.d × Euc p.d → ℝ := fun z =>
      (D i).kernel z.1 z.2 - commutatorKernel p.d p.s (center i).1 z.1 z.2
    have hnetErr : eLpNorm f₁ (ENNReal.ofReal 2) (μ.prod μ) ≤ ENNReal.ofReal (η / 2) := by
      simpa [f₁, center, i, e, hcenter] using huErr
    have happroxErr : eLpNorm f₂ (ENNReal.ofReal 2) (μ.prod μ) ≤ ENNReal.ofReal (η / 2) := by
      simpa [f₂, hEqD i] using hn i
    have hdecomp : (fun z : Euc p.d × Euc p.d =>
        commutatorKernel p.d p.s (gradient ((F a).χ j)) z.1 z.2 -
          (D i).kernel z.1 z.2) = fun z => f₁ z + -f₂ z := by
      funext z
      dsimp [f₁, f₂]
      ring
    refine ⟨i, ?_⟩
    rw [hdecomp]
    calc
      eLpNorm (fun z => f₁ z + -f₂ z) (ENNReal.ofReal 2) (μ.prod μ)
          ≤ eLpNorm f₁ (ENNReal.ofReal 2) (μ.prod μ) +
            eLpNorm (fun z => -f₂ z) (ENNReal.ofReal 2) (μ.prod μ) :=
              eLpNorm_add_le h2one
      _ = eLpNorm f₁ (ENNReal.ofReal 2) (μ.prod μ) +
            eLpNorm f₂ (ENNReal.ofReal 2) (μ.prod μ) := by
              change eLpNorm f₁ (ENNReal.ofReal 2) (μ.prod μ) +
                eLpNorm (-f₂) (ENNReal.ofReal 2) (μ.prod μ) = _
              rw [eLpNorm_neg]
      _ ≤ ENNReal.ofReal (η / 2) + ENNReal.ofReal (η / 2) :=
        add_le_add hnetErr happroxErr
      _ = ENNReal.ofReal η := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        ring

#print axioms fp81s21_compat_kernel_finite_L2_net

end HRS.Fp81.S21

end
