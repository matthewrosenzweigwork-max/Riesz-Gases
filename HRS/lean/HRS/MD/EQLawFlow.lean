variable {d : ℕ}

theorem eqlaw_gibbs_prob (hd : 2 ≤ d) {s : ℝ} (hs0 : 0 ≤ s) (hsd : s < d) {V : Torus d → ℝ}
    (hV : Torus.IsSmooth V) {β : ℝ} (hβ : 0 < β) {N : ℕ} (hN : 1 ≤ N) :
    IsProbabilityMeasure (canonicalGibbs (periodicRiesz d s) V N β) := by
  obtain ⟨B, hB0, hB⟩ := Q84d.q84d_exists_lower hd hs0 hsd
  obtain ⟨Vm, hVm⟩ := Q84d.q84d_exists_bound_smooth hV
  have hlow : ∀ X : Config d N, -((N : ℝ) * Vm + N * B) ≤
      canonicalHamiltonian (periodicRiesz d s) V X := fun X => by
    have := Q84d.q84d_H_lower hB0 hB hVm hN (∅ : Finset (Fin N × Fin N)) (Finset.empty_subset _) X
    simpa using this
  exact Q84d.q84d_gibbs_isProb (CoercAux.measurable_periodicRiesz_one (by omega) hs0 hsd)
    (Q84d.q84d_measurable_V hV) hlow hβ.le

theorem eqlaw_gibbs_ae_not_collision (hd : 2 ≤ d) (s : ℝ) (V : Torus d → ℝ) (β : ℝ) (N : ℕ) :
    ∀ᵐ X ∂(canonicalGibbs (periodicRiesz d s) V N β), X ∉ collisionSet d N := by
  have h : canonicalGibbs (periodicRiesz d s) V N β ≪ (volume : Measure (Config d N)) := by
    unfold canonicalGibbs
    exact (withDensity_absolutelyContinuous _ _).smul_left _
  exact h.ae_le (Q84d.q84d_ae_not_collision (by omega))

theorem eqlaw_symNonpos_neg_one : Torus.SymNonpos (-1 : Matrix (Fin d) (Fin d) ℝ) := by
  unfold Torus.SymNonpos Torus.symPart
  simp only [Matrix.transpose_neg, Matrix.transpose_one]
  have : (-((1 / 2 : ℝ) • ((-1 : Matrix (Fin d) (Fin d) ℝ) + -1))) = 1 := by
    rw [← two_smul ℝ (-1 : Matrix (Fin d) (Fin d) ℝ), smul_smul]
    norm_num
  rw [this]
  exact Matrix.PosSemidef.one

/-- The measurable map `toCoords`-inverse on whole paths. -/
theorem eqlaw_measurable_ofCoordsPath (d N : ℕ) :
    Measurable (fun (f : ℝ≥0 → (Fin N × Fin d) → ℝ) => fun t : ℝ≥0 => fun i : Fin N =>
      (WithLp.toLp 2 fun j : Fin d => f t (i, j) : Euc d)) := by
  refine measurable_pi_iff.2 fun t => measurable_pi_iff.2 fun i => ?_
  refine (WithLp.measurable_toLp 2 _).comp ?_
  exact measurable_pi_iff.2 fun j => (measurable_pi_apply (i, j)).comp (measurable_pi_apply t)

theorem eq_flow_exists_proof (hd : 2 ≤ d) {s : ℝ} (hs0 : 0 ≤ s) (hsd : s < d)
    (V : Torus d → ℝ) (hV : Torus.IsSmooth V) {β : ℝ} (hβ : 0 < β) {N : ℕ} (hN : 2 ≤ N)
    (H : ℝ) (hH : 0 ≤ H) :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (X₀ : Ω → Config d N) (W : ℝ≥0 → Ω → (Fin N → Euc d)) (X : ℝ≥0 → Ω → Config d N),
      IsStationaryGibbsFlow P s hs0 hsd V β hβ H X₀ W X := by
  classical
  haveI : BorelSpace (Torus d) := Pi.borelSpace
  haveI : BorelSpace (Config d N) := Pi.borelSpace
  set μ : Measure (Config d N) := canonicalGibbs (periodicRiesz d s) V N β with hμ
  haveI : IsProbabilityMeasure μ := eqlaw_gibbs_prob hd hs0 hsd hV hβ (by omega)
  obtain ⟨W', hW'm, hW0, hWc, hind, hBF⟩ :=
    exists_enlargement_indep (Fin N × Fin d) (Config d N) μ
  set P : Measure (Config d N × ((Fin N × Fin d) → WienerSeq)) :=
    μ.prod (Measure.pi fun _ : (Fin N × Fin d) => wienerMeasure) with hP
  haveI : IsProbabilityMeasure P := inferInstance
  set ℱ := generatedFiltration P Prod.fst measurable_fst W' hW'm with hℱ
  set D : DynData d := PDE.mfData d s hs0 hsd V β hβ with hD
  have hV2 : Torus.IsCk 2 D.V :=
    (show ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Torus.lift V) from hV).of_le
      (WithTop.coe_le_coe.2 (le_top : (2 : ℕ∞) ≤ ⊤))
  have hM : Torus.SymNonpos D.M := eqlaw_symNonpos_neg_one
  have hb : IsLocLipschitzDrift (liftedFree d N) (fun _ Z => liftedDrift D Z) :=
    liftedDrift_locLipschitz D (kernelLocal_of_two_le hd D.hs0 D.hsd).smoothOffZero hV2
  have hmapfst : P.map Prod.fst = μ := by
    rw [hP, Measure.map_fst_prod, measure_univ, one_smul]
  have hdist : ∀ᵐ ω ∂P, (Prod.fst ω : Config d N) ∉ collisionSet d N := by
    have hmp : MeasurePreserving (Prod.fst : Config d N × ((Fin N × Fin d) → WienerSeq) → Config d N) P μ :=
      ⟨measurable_fst, hmapfst⟩
    exact hmp.quasiMeasurePreserving.ae (eqlaw_gibbs_ae_not_collision hd s V β N)
  have hnoexit : ∀ (Y₀ : Config d N × ((Fin N × Fin d) → WienerSeq) → (Fin N → Euc d))
      (τ : Config d N × ((Fin N × Fin d) → WienerSeq) → WithTop ℝ)
      (Y : ℝ → Config d N × ((Fin N × Fin d) → WienerSeq) → (Fin N → Euc d)),
      IsMaximalParticleSolution P ℱ W' D Y₀ τ Y → ∀ᵐ ω ∂P, τ ω = ⊤ :=
    fun Y₀ τ Y hsol => (particle_no_collision_dge2 D hd hM hV2 hBF hsol).2
  obtain ⟨X, hS, hF⟩ := eqlaw_exists_filtered P D hb ℱ W' hBF Prod.fst
    (fun t => generatedFiltration_measurable_init P Prod.fst measurable_fst W' hW'm t) hdist hnoexit H
  have hPU : PathwiseUnique P D H Prod.fst (ofCoords W') :=
    pathwiseUnique_of_locLipschitz P D hb H Prod.fst (ofCoords W')
      (isVectorBrownian_of_isBrownianFiltration P ℱ W' hBF)
  refine ⟨_, inferInstance, P, inferInstance, Prod.fst, ofCoords W', X, ?_, ⟨ℱ, W', hF⟩, ?_⟩
  · refine ⟨measurable_fst, hdist, isVectorBrownian_of_isBrownianFiltration P ℱ W' hBF, ?_,
      Or.inl ⟨hS, hPU⟩⟩
    exact hind.comp measurable_id (eqlaw_measurable_ofCoordsPath d N)
  · show P.map Prod.fst = μ
    exact hmapfst

