import HRS.Stochastic.Brownian
import HRS.Stochastic.Filtration

/-!
# EQ-LAW (packet `eq_path_stationary`), part 1: the shifted Brownian filtration and the Markov-type independence

* `shiftFil ℱ u`, `shiftProc W u`: for a Brownian filtration `(ℱ, W)` and `u ≥ 0`, the pair `(ℱ_{u+·}, W_{u+·} - W_u)` is again a
  Brownian filtration (`isBrownianFiltration_shift`).
* `indepFun_init_path`: in a Brownian filtration, every `ℱ 0`-measurable random variable is independent of the whole process
  (`indep_zero_path`).
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal

namespace HRS.MD.EQLawPath

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {ι : Type*} [Fintype ι]

set_option linter.unusedSectionVars false
set_option warn.classDefReducibility false

/-- The shifted filtration `t ↦ ℱ_{u+t}`. -/
def shiftFil (ℱ : Filtration ℝ mΩ) (u : ℝ≥0) : Filtration ℝ mΩ where
  seq t := ℱ ((u : ℝ) + t)
  mono' _ _ hst := ℱ.mono (by linarith)
  le' _ := ℱ.le _

/-- The shifted process `s ↦ W_{u+s} - W_u`. -/
def shiftProc (W : ℝ≥0 → Ω → ι → ℝ) (u : ℝ≥0) : ℝ≥0 → Ω → ι → ℝ :=
  fun s ω => W (u + s) ω - W u ω

theorem shiftProc_incr (W : ℝ≥0 → Ω → ι → ℝ) (u s t : ℝ≥0) (ω : Ω) :
    shiftProc W u t ω - shiftProc W u s ω = W (u + t) ω - W (u + s) ω := by
  simp only [shiftProc]; abel

theorem isBrownianFiltration_shift {P : Measure Ω} {ℱ : Filtration ℝ mΩ} {W : ℝ≥0 → Ω → ι → ℝ}
    (hW : IsBrownianFiltration P ℱ W) (u : ℝ≥0) :
    IsBrownianFiltration P (shiftFil ℱ u) (shiftProc W u) where
  complete t s hs h0 := hW.complete _ s hs h0
  adapted s := by
    have h1 : Measurable[ℱ (((u + s : ℝ≥0)) : ℝ)] (W (u + s)) := hW.adapted (u + s)
    have h2 : Measurable[ℱ ((u : ℝ) + s)] (W u) :=
      (hW.adapted u).mono (ℱ.mono (by simp)) le_rfl
    have e : ((u + s : ℝ≥0) : ℝ) = (u : ℝ) + s := NNReal.coe_add u s
    rw [e] at h1
    exact h1.sub h2
  zero ω := by simp [shiftProc]
  cont ω := by
    refine continuous_pi fun k => ?_
    have := (continuous_apply k).comp (hW.cont ω)
    simp only [shiftProc, Pi.sub_apply]
    exact (this.comp (continuous_const.add continuous_id)).sub continuous_const
  indep_incr s t hst := by
    have h := hW.indep_incr (u + s) (u + t) (by gcongr)
    have e : (fun ω => shiftProc W u t ω - shiftProc W u s ω) =
        fun ω => W (u + t) ω - W (u + s) ω := funext fun ω => shiftProc_incr W u s t ω
    rw [e]
    simpa [shiftFil] using h
  gaussian_incr s t hst := by
    have h := hW.gaussian_incr (u + s) (u + t) (by gcongr)
    have e : (fun ω => shiftProc W u t ω - shiftProc W u s ω) =
        fun ω => W (u + t) ω - W (u + s) ω := funext fun ω => shiftProc_incr W u s t ω
    rw [e]
    have e2 : ((u + t : ℝ≥0) - (u + s) : ℝ≥0) = t - s := by
      rw [add_tsub_add_eq_tsub_left]
    rwa [e2] at h

/-! ### Independence of the initial σ-algebra and the path -/

variable {P : Measure Ω} {ℱ : Filtration ℝ mΩ} {W : ℝ≥0 → Ω → ι → ℝ}

/-- The σ-algebra generated by the values of `W` at the times in a finite set. -/
def sigmaAt (W : ℝ≥0 → Ω → ι → ℝ) (I : Finset ℝ≥0) : MeasurableSpace Ω :=
  ⨆ t ∈ I, MeasurableSpace.comap (W t) inferInstance

theorem sigmaAt_le (hW : IsBrownianFiltration P ℱ W) (I : Finset ℝ≥0) {m : ℝ≥0}
    (hm : ∀ t ∈ I, t ≤ m) : sigmaAt W I ≤ ℱ (m : ℝ) :=
  iSup₂_le fun t ht =>
    ((hW.adapted t).mono (ℱ.mono (by exact_mod_cast hm t ht)) le_rfl).comap_le

theorem sigmaAt_mono (W : ℝ≥0 → Ω → ι → ℝ) {I J : Finset ℝ≥0} (h : I ⊆ J) :
    sigmaAt W I ≤ sigmaAt W J :=
  iSup₂_le fun t ht => le_iSup₂_of_le (f := fun t (_ : t ∈ J) =>
    MeasurableSpace.comap (W t) inferInstance) t (h ht) le_rfl

theorem indep_zero_sigmaAt_insert [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W)
    {m a : ℝ≥0} (hma : m ≤ a) (I : Finset ℝ≥0) (hI : ∀ t ∈ I, t ≤ m) (hm : m ∈ I)
    (ih : Indep (ℱ 0) (sigmaAt W I) P) : Indep (ℱ 0) (sigmaAt W (insert a I)) P := by
  set Δ : MeasurableSpace Ω := MeasurableSpace.comap (fun ω => W a ω - W m ω) inferInstance with hΔ
  have hΔle : Δ ≤ mΩ := ((hW.measurable a).sub (hW.measurable m)).comap_le
  have h0 : Δ ≤ mΩ := hΔle
  have hℱle : ℱ 0 ≤ mΩ := ℱ.le 0
  have hIle : sigmaAt W I ≤ mΩ := (sigmaAt_le hW I hI).trans (ℱ.le _)
  have hΔind : Indep Δ (ℱ 0 ⊔ sigmaAt W I) P :=
    indep_of_indep_of_le_right (hW.indep_incr m a hma)
      (sup_le (ℱ.mono (by simp)) (sigmaAt_le hW I hI))
  have h := indep_sup_right_of_indep (M0 := Δ) (M1 := ℱ 0) (M2 := sigmaAt W I) P h0 hℱle hIle ih hΔind
  refine indep_of_indep_of_le_right h ?_
  refine iSup₂_le fun t ht => ?_
  rcases Finset.mem_insert.1 ht with rfl | ht
  · have h1 : Measurable[Δ ⊔ sigmaAt W I] (fun ω => W t ω - W m ω) :=
      (comap_measurable (fun ω => W t ω - W m ω)).mono le_sup_left le_rfl
    have h2 : Measurable[Δ ⊔ sigmaAt W I] (W m) :=
      (comap_measurable (W m)).mono (le_sup_of_le_right (le_iSup₂_of_le (f := fun t (_ : t ∈ I) =>
        MeasurableSpace.comap (W t) inferInstance) m hm le_rfl)) le_rfl
    have h3 := h1.add h2
    have e : W t = (fun ω => W t ω - W m ω) + W m := by funext ω; simp
    rw [e]
    exact h3.comap_le
  · exact le_sup_of_le_right (le_iSup₂_of_le (f := fun t (_ : t ∈ I) =>
      MeasurableSpace.comap (W t) inferInstance) t ht le_rfl)

theorem indep_zero_sigmaAt [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W)
    (I : Finset ℝ≥0) : Indep (ℱ 0) (sigmaAt W I) P := by
  induction I using Finset.induction_on_max with
  | empty =>
    have : sigmaAt W (∅ : Finset ℝ≥0) = ⊥ := by simp [sigmaAt]
    rw [this]
    exact indep_bot_right _
  | insert a I ha ih =>
    rcases I.eq_empty_or_nonempty with rfl | hne
    · have e : sigmaAt W ({a} : Finset ℝ≥0) =
          MeasurableSpace.comap (fun ω => W a ω - W 0 ω) inferInstance := by
        simp [sigmaAt, hW.zero]
      rw [insert_empty_eq, e]
      exact (hW.indep_incr 0 a (by simp)).symm
    · exact indep_zero_sigmaAt_insert hW (ha _ (I.max'_mem hne)).le I (fun t ht => I.le_max' t ht)
        (I.max'_mem hne) ih

theorem indep_zero_path [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W) :
    Indep (ℱ 0) (MeasurableSpace.comap (fun ω => fun t : ℝ≥0 => W t ω) inferInstance) P := by
  have hpath : MeasurableSpace.comap (fun ω => fun t : ℝ≥0 => W t ω) inferInstance =
      ⨆ I : Finset ℝ≥0, sigmaAt W I := by
    apply le_antisymm
    · have : MeasurableSpace.comap (fun ω => fun t : ℝ≥0 => W t ω) inferInstance =
          ⨆ t : ℝ≥0, MeasurableSpace.comap (W t) inferInstance := by
        rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
        simp only [MeasurableSpace.comap_comp]
        rfl
      rw [this]
      refine iSup_le fun t => le_iSup_of_le ({t} : Finset ℝ≥0) ?_
      exact le_iSup₂_of_le (f := fun r (_ : r ∈ ({t} : Finset ℝ≥0)) =>
        MeasurableSpace.comap (W r) inferInstance) t (Finset.mem_singleton_self t) le_rfl
    · refine iSup_le fun I => iSup₂_le fun r _ => ?_
      exact ((measurable_pi_apply r).comp
        (comap_measurable (fun ω => fun t : ℝ≥0 => W t ω))).comap_le
  rw [hpath]
  refine (indep_iSup_of_directed_le (fun I => (indep_zero_sigmaAt hW I).symm) (fun I => ?_)
    (ℱ.le 0) ?_).symm
  · exact (sigmaAt_le hW I (m := I.sup id) (fun t ht => Finset.le_sup (f := id) ht)).trans (ℱ.le _)
  · exact Monotone.directed_le fun I J hIJ => sigmaAt_mono W hIJ

/-! ### The law of a Brownian path does not depend on the filtration -/

open ProbabilityTheory.BrownianReal in
/-- The finite-dimensional law of a Brownian filtration: the swap of the product of the scalar Brownian laws. -/
theorem bf_fdd_law [IsProbabilityMeasure P] (hW : IsBrownianFiltration P ℱ W) (I : Finset ℝ≥0) :
    P.map (fun ω => I.restrict (fun t => W t ω)) =
      (Measure.pi fun _ : ι => projectiveFamily I).map
        (fun x : ι → (I → ℝ) => fun (t : I) (k : ι) => x k t) := by
  set f : ι → Ω → (I → ℝ) := fun k ω => I.restrict (fun t => W t ω k) with hf
  have hfm : ∀ k, Measurable (f k) := fun k => by
    refine measurable_pi_iff.2 fun t => ?_
    exact hW.measurable_coord t k
  have hind : iIndepFun f P := by
    have := (hW.iIndepFun_coord).comp (fun (k : ι) (p : ℝ≥0 → ℝ) => I.restrict p)
      (fun k => Finset.measurable_restrict _)
    exact this
  have hlaw : ∀ k, P.map (f k) = projectiveFamily I := fun k =>
    ((hW.isBrownianReal k).toIsPreBrownianReal.hasLaw I).map_eq
  have h1 : P.map (fun ω k => f k ω) = Measure.pi fun _ : ι => projectiveFamily I := by
    rw [(iIndepFun_iff_map_fun_eq_pi_map (fun k => (hfm k).aemeasurable)).1 hind]
    exact congrArg Measure.pi (funext hlaw)
  have hswap : Measurable (fun x : ι → (I → ℝ) => fun (t : I) (k : ι) => x k t) :=
    measurable_pi_iff.2 fun t => measurable_pi_iff.2 fun k => (measurable_pi_apply t).comp
      (measurable_pi_apply k)
  rw [← h1, Measure.map_map hswap (measurable_pi_iff.2 hfm)]
  rfl

/-- The continuous-path random element of a Brownian filtration. -/
def bfPath (hW : IsBrownianFiltration P ℱ W) : Ω → C(ℝ≥0, ι → ℝ) :=
  fun ω => ⟨fun t => W t ω, hW.cont ω⟩

theorem measurable_bfPath (hW : IsBrownianFiltration P ℱ W) : Measurable (bfPath hW) := by
  rw [ContinuousMap.measurable_iff_eval]
  intro t
  exact hW.measurable t

theorem measurableSpace_continuousMap_eq :
    (inferInstance : MeasurableSpace C(ℝ≥0, ι → ℝ)) =
      MeasurableSpace.comap (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) inferInstance := by
  rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval]
  show _ = MeasurableSpace.comap _ (⨆ a, MeasurableSpace.comap (fun b : ℝ≥0 → ι → ℝ => b a) inferInstance)
  rw [MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp]
  rfl

theorem map_coe_eq_iff {ν₁ ν₂ : Measure C(ℝ≥0, ι → ℝ)} :
    ν₁.map (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) =
      ν₂.map (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) → ν₁ = ν₂ := by
  intro h
  have hm : Measurable (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) :=
    measurable_pi_iff.2 fun t => ContinuousMap.measurable_eval t
  refine Measure.ext fun s hs => ?_
  have hs' : MeasurableSet[MeasurableSpace.comap
      (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) inferInstance] s := by
    rw [← measurableSpace_continuousMap_eq]; exact hs
  obtain ⟨A, hA, rfl⟩ := hs'
  have h1 := congrArg (fun ν => ν A) h
  simpa [Measure.map_apply hm hA] using h1

theorem bf_process_law_eq {Ω₁ : Type*} {m₁ : MeasurableSpace Ω₁} {Ω₂ : Type*} {m₂ : MeasurableSpace Ω₂}
    {P₁ : Measure Ω₁} {P₂ : Measure Ω₂} [IsProbabilityMeasure P₁] [IsProbabilityMeasure P₂]
    {ℱ₁ : Filtration ℝ m₁} {ℱ₂ : Filtration ℝ m₂} {W₁ : ℝ≥0 → Ω₁ → ι → ℝ} {W₂ : ℝ≥0 → Ω₂ → ι → ℝ}
    (h₁ : IsBrownianFiltration P₁ ℱ₁ W₁) (h₂ : IsBrownianFiltration P₂ ℱ₂ W₂) :
    P₁.map (fun ω => fun t : ℝ≥0 => W₁ t ω) = P₂.map (fun ω => fun t : ℝ≥0 => W₂ t ω) := by
  have hm₁ : AEMeasurable (fun ω => fun t : ℝ≥0 => W₁ t ω) P₁ :=
    (measurable_pi_iff.2 fun t => h₁.measurable t).aemeasurable
  have hm₂ : AEMeasurable (fun ω => fun t : ℝ≥0 => W₂ t ω) P₂ :=
    (measurable_pi_iff.2 fun t => h₂.measurable t).aemeasurable
  have l₁ := isProjectiveLimit_map (X := fun t ω => W₁ t ω) (P := P₁) hm₁
  have l₂ := isProjectiveLimit_map (X := fun t ω => W₂ t ω) (P := P₂) hm₂
  have hfam : (fun I : Finset ℝ≥0 => P₁.map (fun ω => I.restrict (fun t => W₁ t ω))) =
      fun I : Finset ℝ≥0 => P₂.map (fun ω => I.restrict (fun t => W₂ t ω)) := by
    funext I
    rw [bf_fdd_law h₁, bf_fdd_law h₂]
  rw [hfam] at l₁
  haveI : ∀ I : Finset ℝ≥0, IsFiniteMeasure (P₂.map (fun ω => I.restrict (fun t => W₂ t ω))) :=
    fun I => by
      refine ⟨?_⟩
      rw [Measure.map_apply_of_aemeasurable ?_ MeasurableSet.univ]
      · simp
      · exact (Finset.measurable_restrict _).comp_aemeasurable hm₂
  exact l₁.unique l₂

theorem bf_path_law_eq {Ω₁ : Type*} {m₁ : MeasurableSpace Ω₁} {Ω₂ : Type*} {m₂ : MeasurableSpace Ω₂}
    {P₁ : Measure Ω₁} {P₂ : Measure Ω₂} [IsProbabilityMeasure P₁] [IsProbabilityMeasure P₂]
    {ℱ₁ : Filtration ℝ m₁} {ℱ₂ : Filtration ℝ m₂} {W₁ : ℝ≥0 → Ω₁ → ι → ℝ} {W₂ : ℝ≥0 → Ω₂ → ι → ℝ}
    (h₁ : IsBrownianFiltration P₁ ℱ₁ W₁) (h₂ : IsBrownianFiltration P₂ ℱ₂ W₂) :
    P₁.map (bfPath h₁) = P₂.map (bfPath h₂) := by
  have hm : Measurable (fun c : C(ℝ≥0, ι → ℝ) => (c : ℝ≥0 → ι → ℝ)) :=
    measurable_pi_iff.2 fun t => ContinuousMap.measurable_eval t
  refine map_coe_eq_iff ?_
  rw [Measure.map_map hm (measurable_bfPath h₁), Measure.map_map hm (measurable_bfPath h₂)]
  exact bf_process_law_eq h₁ h₂

end HRS.MD.EQLawPath
