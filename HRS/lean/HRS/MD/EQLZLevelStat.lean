import HRS.Stochastic.Wiener
import HRS.MD.EQLZVocab

/-!
# EQ-LZ packet LN, part 1: a stationary level flow

For every probability law `μ` on the big torus `𝕋^{N d}` there is a level-`lev` flow `Y*` (an `IsLevelFlow`, in a Brownian
filtration, with `ℱ_t`-measurable initial lift for every real `t`) whose time-`0` marginal `levelProc Y* 0` has law `μ`.
Construction: `exists_enlargement` on `(𝕋^{N d}, μ)` (the Brownian filtration is generated by the initial datum
`Prod.fst` and the Wiener paths), the shifted filtration `b15e_shiftFil`, the initial lift `Y₀ = rep ∘ e⁻¹ ∘ Prod.fst`,
and `b15e_exists_regularised`.
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal
open HRS HRS.MD.EQLZ

namespace HRS.MD.EQLZLevelStat

variable {d N : ℕ}

/-- The lift `x ↦ rep ∘ e⁻¹ x` from the big torus to the covering space. -/
def lzlLift (d N : ℕ) (x : Torus (N * d)) : Fin N → Euc d :=
  fun i => Torus.rep ((d1_configEquiv d N).symm x i)

theorem lzlLift_measurable (d N : ℕ) : Measurable (lzlLift d N) :=
  measurable_pi_iff.2 fun i => (b15e_measurable_rep d).comp
    ((measurable_pi_apply i).comp (d1_configEquiv d N).symm.measurable)

theorem lzlLift_levelProc (d N : ℕ) (x : Torus (N * d)) :
    d1_configEquiv d N (fun i => Torus.mk (lzlLift d N x i)) = x := by
  have : (fun i => Torus.mk (lzlLift d N x i)) = (d1_configEquiv d N).symm x := by
    funext i; simp [lzlLift, Torus.mk_rep]
  rw [this]; exact (d1_configEquiv d N).apply_symm_apply x

theorem lzl_exists_stationary (D : DynData d) (hV : Torus.IsSmooth D.V) (lev : ℝ)
    (μ : Measure (Torus (N * d))) [IsProbabilityMeasure μ] :
    ∃ (Ω : Type) (mΩ : MeasurableSpace Ω) (P : Measure Ω) (_ : IsProbabilityMeasure P)
      (ℱ : Filtration ℝ mΩ) (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) (Y₀ : Ω → Fin N → Euc d)
      (Y : ℝ → Ω → Fin N → Euc d), IsLevelFlow D lev P ℱ W' Y₀ Y ∧ P.map (levelProc Y 0) = μ := by
  obtain ⟨W, hW, hmap, h0, hc, hB⟩ := exists_enlargement (Fin N × Fin d) (Torus (N * d)) μ
  set P : Measure (Torus (N * d) × ((Fin N × Fin d) → WienerSeq)) :=
    μ.prod (Measure.pi fun _ : (Fin N × Fin d) => wienerMeasure) with hP
  haveI : IsProbabilityMeasure P := inferInstance
  set ℱ0 := generatedFiltration P Prod.fst measurable_fst W hW with hℱ0
  have hBs : IsBrownianFiltration P (b15e_shiftFil ℱ0) W := b15e_shiftFil_brownian hB
  have hV2 : Torus.IsCk 2 D.V :=
    (show ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Torus.lift D.V) from hV).of_le
      (by first | exact WithTop.coe_le_coe.2 le_top | (norm_cast; exact le_top) | simp)
  set Y₀ : (Torus (N * d) × ((Fin N × Fin d) → WienerSeq)) → Fin N → Euc d :=
    fun ω => lzlLift d N ω.1 with hY₀
  have hY₀m : ∀ t : ℝ, Measurable[b15e_shiftFil ℱ0 t] Y₀ := fun t =>
    (lzlLift_measurable d N).comp (generatedFiltration_measurable_init P Prod.fst measurable_fst W hW (max t 0))
  obtain ⟨Y, hY⟩ := b15e_exists_regularised hBs D hV2 lev Y₀ hY₀m
  refine ⟨_, inferInstance, P, inferInstance, b15e_shiftFil ℱ0, W, Y₀, Y, ⟨hBs, hY₀m, hY⟩, ?_⟩
  have hproc : levelProc Y 0 = Prod.fst := by
    funext ω
    simp only [levelProc, hY.init ω, hY₀]
    exact lzlLift_levelProc d N ω.1
  rw [hproc]
  exact hmap

end HRS.MD.EQLZLevelStat

end
