/-!
# Torus PDE layer VII: the mean-field equation with finite regularity, the equilibrium adjoint,
and the nonlinear transient (package MF-01)

Sources (HRS periodic main paper):
* thermal equation `H:eq:thermal-equation` and the prose (lines 913–920): "On the torus, this
  equation has a unique smooth positive solution for every smooth `V`";
* Proposition 5.1 `O:prop:finite-reg` (lines 5771–5791): finite regularity and compact-temperature
  uniformity for `∂_tρ = β⁻¹Δρ + Div(ρ∇(V + g*ρ))` (`O:eq:mf-finite`);
* `C:eq:operator-order` (lines 5943–5947): `Q_β 𝓛_β = -A_β L_β`;
* Proposition 5.2 `C:prop:adjoint` (lines 5893–5906): uniform adjoint estimates
  `C:eq:U-decay`, `C:eq:U-comparison`;
* Corollary 5.3 `C:cor:linear` (lines 5917–5932): loss of the initial law for the linear SPDE
  `C:eq:linear-spde`, with the stationary covariance `C:eq:stationary-cov` (lines 5908–5913);
* Lemma 4.14 `lem:periodic-pair-inverse` (lines 4739–4747): the smooth two-copy inverse;
* the nonlinear transient `H:eq:nonlinear-transient` (prose lines 872–890), proved as
  Proposition `E:prop:mean` (lines 7288–7313; coverage row `M:E:prop:mean`, package MAIN-02).

## Representation

* The mean-field equation `O:eq:mf-finite` is `H:eq:meanfield` with `M = -I` and `ν = β⁻¹`
  (`mfData`).  Its `C([0,∞);H^K)` solutions are represented at the coefficient level
  (`IsMFSolutionHK`): `ρ̂(t) ∈ H^K` norm-continuous on `[0,∞)` and, for each `k`, the integrated
  equation `ρ̂(t,k) = ρ̂⁰(k) + ∫_0^t (𝒩 ρ̂(σ))^(k) dσ` with an integrable integrand, where
  `𝒩 ρ̂ = β⁻¹Δρ + Div(ρ∇V) + Div(ρ ∇g*ρ)` is `mfRhsCoeff` (products as coefficient
  convolutions, `∇g*` as the multiplier `2πi k ĝ(k)`, which is the cancellation convention by
  `convGradConv_coeff`).  The function `ρ^t` is `toFun (ρ̂ t)` (honest for `K > d/2`).
* The hypotheses of Proposition 5.1 are the fields of `FiniteRegHyp` (a `Prop` record listing them;
  no hypothesis beyond the source's).  The proposition is split into its assertions
  (`finite_reg_*`); "uniformly in `β`" is read as: the constants are chosen before
  `β ∈ [β₋,β₊]` (title "compact-temperature uniformity", proof lines 5832, 5841).
* `Q_β = projMean μ_β`, `K_β = Kop g μ_β`, `L_β = Lop ρ_β`, `A_β = β⁻¹I + K_β`
  (`HRS/Kernel/Riesz.lean`); `S_β(t)` is realised as `Q_β U^{0,t}` for the frozen coefficient
  `ρ_β` (`equilibriumSemigroup`), which is the semigroup generated by `-A_βL_β` on the centered
  space by `C:eq:operator-order` (`equilibriumSemigroup_generator`).
* `𝒟'`-valued processes of Corollary 5.3 live in `NegSobolev d j = H^{-j}_0` (zero mass built in);
  the linear SPDE is characterised in mild form (`IsLinearSPDESolution`, modelled on
  `HRS.IsLinearFluctuationSolution`) with noise level `q = ν = β⁻¹` and `M = -I`.  The
  "stationary Gaussian evolution" with lags is the centered Gaussian vector with covariance
  `𝒞_β(φ_a, S_β(τ_b-τ_a)φ_b)` for `τ_a ≤ τ_b` (`stationaryLagCov`), and the "smooth
  probability-law error" is `smoothDist 2` (`𝖽_{C²}`, source macro `\zCdc`).
-/

noncomputable section

open MeasureTheory Filter Topology
open scoped ENNReal NNReal BigOperators ComplexConjugate

namespace HRS.PDE

variable {d : ℕ}

/-! ### The gradient-flow data and the coefficient form of `O:eq:mf-finite` -/

/-! ### The thermal equation (lines 913–920) -/

/-- Prose, lines 919–920: "On the torus, this equation [`H:eq:thermal-equation`] has a unique
smooth positive solution for every smooth `V`" (Section 2 setting, `d ≥ 2`, `0 ≤ s < d`,
`β ∈ (0,∞)`): existence of a smooth positive thermal density, unique among smooth positive
solutions. -/
theorem thermal_exists_unique_smooth (hd : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d)
    (β : ℝ) (hβ : 0 < β) (V : Torus d → ℝ) (hV : Torus.IsSmooth V) :
    ∃ ρ : Torus d → ℝ, IsThermalDensity (periodicRiesz d s) V β ρ ∧ Torus.IsSmooth ρ ∧
      (∀ x, 0 < ρ x) ∧
      ∀ ρ' : Torus d → ℝ, IsThermalDensity (periodicRiesz d s) V β ρ' → Torus.IsSmooth ρ' →
        (∀ x, 0 < ρ' x) → ρ' = ρ := by
  have hcont : ∀ φ : Torus d → ℝ, Torus.IsSmooth φ → Continuous φ := fun φ hφ =>
    MFAux.continuous_of_isCk (ContDiff.of_le
      (show ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Torus.lift φ) from hφ) (by exact_mod_cast le_top))
  obtain ⟨ρ, hρ, hc, hp⟩ :=
    MFThermalAssembly.thermal_exists_continuous (by omega) s hs0 hsd V (hcont V hV) β hβ
  refine ⟨ρ, hρ, MFThermalAssembly.thermal_isSmooth_all (by omega) s hs0 hsd V hV β hβ ρ hρ hc hp,
    hp, fun ρ' hρ' hs' hp' => ?_⟩
  exact MFThermal.thermal_unique hd s hs0 hsd β hβ V ρ ρ' hρ hc hp hρ' (hcont ρ' hs') hp'

/-! ### Proposition 5.1 `O:prop:finite-reg` (lines 5771–5791), assertion by assertion -/

/-- Proposition 5.1, existence and uniqueness (lines 5773–5777): for `β ∈ [β₋,β₊]` the equation
`O:eq:mf-finite` has a unique global solution in `C([0,∞);H^K)`, with time derivative in
`C([0,∞);H^{K-2})`: the solution is real, `∂_tρ̂ = 𝒩ρ̂` holds as an `H^{K-2}`-valued derivative
(difference quotients converge in `H^{K-2}` at every `t ≥ 0`), and `t ↦ 𝒩ρ̂(t)` is norm-continuous
in `H^{K-2}`. -/
theorem finite_reg_exists_unique (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ β ∈ Set.Icc βm βp, ∃ ρc : ℝ → Coeff d,
      IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc ∧ (∀ t, 0 ≤ t → IsRealCoeff (ρc t)) ∧
      ContinuousInHsOn ((K : ℝ) - 2) (fun t => mfRhsCoeff d s V β⁻¹ (ρc t)) (Set.Ici 0) ∧
      (∀ t, 0 ≤ t → Tendsto (fun t' => hsNorm ((K : ℝ) - 2)
          (fun k => (ρc t' k - ρc t k) / ((t' - t : ℝ) : ℂ) - mfRhsCoeff d s V β⁻¹ (ρc t) k))
        (𝓝[Set.Ici 0 \ {t}] t) (𝓝 0)) ∧
      ∀ ρc' : ℝ → Coeff d, IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc' → ∀ t, 0 ≤ t → ρc' t = ρc t := by
  exact HRS.PDE.MFGlobal.finite_reg_exists_unique hd s βm βp K V ρ₀ H

/-- Proposition 5.1 (line 5777): "its thermal equilibrium density `ρ_β` is positive and belongs to
`H^K`": for `β ∈ [β₋,β₊]` there is a continuous, positive thermal density in `H^K`. -/
theorem finite_reg_thermal (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ β ∈ Set.Icc βm βp, ∃ ρβ : Torus d → ℝ, IsThermalDensity (periodicRiesz d s) V β ρβ ∧
      Continuous ρβ ∧ (∀ x, 0 < ρβ x) ∧ MemSobolev K ρβ := by
  intro β hβ
  have hβ0 : 0 < β := lt_of_lt_of_le H.hβm hβ.1
  have hVc : Continuous V := MFAux.continuous_of_isCk (ContDiff.of_le H.hV (by exact_mod_cast
    (show (1 : ℕ) ≤ K + 2 by omega)))
  obtain ⟨ρ, hρ, hc, hp⟩ :=
    MFThermalAssembly.thermal_exists_continuous hd s H.hs0 H.hsd V hVc β hβ0
  exact ⟨ρ, hρ, hc, hp,
    MFThermalAssembly.thermal_memSobolev_all hd s H.hs0 H.hsd K V H.hV β hβ0 ρ hρ hc hp⟩

/-- Uniqueness presupposed by "its thermal equilibrium density" (line 5777; cf. lines 919–920):
under the data of Proposition 5.1, continuous positive thermal densities are unique. -/
theorem finite_reg_thermal_unique (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ β ∈ Set.Icc βm βp, ∀ ρβ ρβ' : Torus d → ℝ,
      IsThermalDensity (periodicRiesz d s) V β ρβ → Continuous ρβ → (∀ x, 0 < ρβ x) →
      IsThermalDensity (periodicRiesz d s) V β ρβ' → Continuous ρβ' → (∀ x, 0 < ρβ' x) →
      ρβ' = ρβ := by
  intro β hβ ρβ ρβ' h1 c1 p1 h2 c2 p2
  rcases Nat.lt_or_ge d 2 with h | h
  · -- `d = 1`: through the kernel-fact bundle (open input `MFInputs.mfKernelFacts_one`).
    have hd1 : d = 1 := by omega
    exact MFThermalExist.thermal_unique' hd s H.hs0 H.hsd
      (MFInputs.mfKernelFacts_one hd1 s H.hs0 H.hsd) β (lt_of_lt_of_le H.hβm hβ.1) V ρβ ρβ'
      h1 c1 p1 h2 c2 p2
  · exact MFThermal.thermal_unique h s H.hs0 H.hsd β (lt_of_lt_of_le H.hβm hβ.1) V ρβ ρβ'
      h1 c1 p1 h2 c2 p2

/-- Proposition 5.1, `O:eq:finite-bounds` (lines 5777–5780): uniformly in `β ∈ [β₋,β₊]`,
`0 < c ≤ ρ^t ≤ C` and `sup_{t≥0} ‖ρ^t‖_{H^K} ≤ C`. -/
theorem finite_reg_uniform_bounds (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∃ c C : ℝ, 0 < c ∧ ∀ β ∈ Set.Icc βm βp, ∀ ρc : ℝ → Coeff d,
      IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc → ∀ t, 0 ≤ t →
        (∀ x, c ≤ mfPath ρc t x ∧ mfPath ρc t x ≤ C) ∧ hsNorm K (ρc t) ≤ C := by
  exact HRS.PDE.MFGlobal.finite_reg_uniform_bounds hd s βm βp K V ρ₀ H

/-- Proposition 5.1, `O:eq:finite-decay` (lines 5781–5784): for every `0 ≤ r < K` there are
`C_r, c_r > 0` (uniform in `β ∈ [β₋,β₊]`) with `‖ρ^t - ρ_β‖_{H^r} ≤ C_r e^{-c_r t}`. -/
theorem finite_reg_decay (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ r : ℝ, 0 ≤ r → r < K → ∃ Cr cr : ℝ, 0 < Cr ∧ 0 < cr ∧
      ∀ β ∈ Set.Icc βm βp, ∀ ρc : ℝ → Coeff d, IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc →
      ∀ ρβ : Torus d → ℝ, IsThermalDensity (periodicRiesz d s) V β ρβ → Continuous ρβ →
        (∀ x, 0 < ρβ x) → MemSobolev K ρβ →
      ∀ t, 0 ≤ t → MemHs r (ρc t - coeffOf ρβ) ∧
        hsNorm r (ρc t - coeffOf ρβ) ≤ Cr * Real.exp (-cr * t) := by
  exact HRS.PDE.MFDecay.finite_reg_decay hd s βm βp K V ρ₀ H

/-- Proposition 5.1, last sentence of the first paragraph (lines 5785–5787): the effective
velocity `u^t = β⁻¹∇log ρ^t + ∇(V + g*ρ^t)` decays exponentially in `C^j` whenever
`j + 1 + d/2 < K` (constants uniform in `β ∈ [β₋,β₊]`). -/
theorem finite_reg_velocity_decay (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ j : ℕ, (j : ℝ) + 1 + (d : ℝ) / 2 < K → ∃ C c : ℝ, 0 < c ∧
      ∀ β ∈ Set.Icc βm βp, ∀ ρc : ℝ → Coeff d, IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc →
      ∀ t, 0 ≤ t → Torus.IsCk j (effVelocity d s V β (mfPath ρc t)) ∧
        Torus.cbNorm j (effVelocity d s V β (mfPath ρc t)) ≤ C * Real.exp (-c * t) := by
  exact HRS.PDE.MFVelocity.finite_reg_velocity_decay hd s βm βp K V ρ₀ H

/-- Consistency with the Setup file: the coefficient solution of Proposition 5.1 is a weak solution
of `H:eq:meanfield` (`HRS.IsMeanFieldSolution`, with `M = -I`, `invβ = β⁻¹`) on every `[0,T]`. -/
theorem finite_reg_isMeanFieldSolution (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) :
    ∀ (β : ℝ) (hβ : β ∈ Set.Icc βm βp), ∀ ρc : ℝ → Coeff d, IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc →
      ∀ T, 0 < T →
        IsMeanFieldSolution (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) T (mfPath ρc) := by
  exact HRS.PDE.MFWeak.finite_reg_isMeanFieldSolution hd s βm βp K V ρ₀ H

/-! ### The equilibrium operators (`C:eq:K`, `C:eq:AL`, lines 5882–5892) and `C:eq:operator-order` -/

/-- `C:eq:operator-order` (lines 5943–5947): `Q_β 𝓛_β = -A_β L_β` for the gradient-flow generator
`𝓛_β = 𝓛_{β,ρ_β}` with `M = -I` (Gibbs equation `∇ρ_β = -βρ_β∇(V+g*ρ_β)` and integration by
parts), on `C²` functions. -/
theorem equilibrium_operator_order (hd : 1 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (β : ℝ)
    (hβ : 0 < β) (V : Torus d → ℝ) (hV : Torus.IsCk 2 V) (ρβ : Torus d → ℝ)
    (hρβ : IsThermalDensity (periodicRiesz d s) V β ρβ) (hρC : Torus.IsCk 2 ρβ)
    (hpos : ∀ x, 0 < ρβ x) (f : Torus d → ℝ) (hf : Torus.IsCk 2 f) :
    projMean (withDensityReal ρβ) (backwardGenerator (mfData d s hs0 hsd V β hβ) ρβ f) =
      equilibriumGen d s ρβ β⁻¹ f := by
  exact MFOneLe.operator_order_core_of_one_le hd (mfData d s hs0 hsd V β hβ) rfl β hβ rfl hV ρβ
    hρβ hρC hpos f hf

/-- `S_β(τ)` is the semigroup generated by `-A_β L_β` on the centered space: for smooth `ψ`,
`τ ↦ S_β(τ)ψ` is differentiable with derivative `-A_βL_β S_β(τ)ψ`, `S_β(0)ψ = Q_βψ`, and
`S_β(τ)ψ` is centered. -/
theorem equilibriumSemigroup_generator (hd : 1 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (β : ℝ)
    (hβ : 0 < β) (V : Torus d → ℝ) (hV : Torus.IsSmooth V) (ρβ : Torus d → ℝ)
    (hρβ : IsThermalDensity (periodicRiesz d s) V β ρβ) (hρC : Torus.IsSmooth ρβ)
    (hpos : ∀ x, 0 < ρβ x) (ψ : Torus d → ℝ) (hψ : Torus.IsSmooth ψ) :
    equilibriumSemigroup (mfData d s hs0 hsd V β hβ) ρβ 0 ψ = projMean (withDensityReal ρβ) ψ ∧
    (∀ τ, 0 ≤ τ → pair (withDensityReal ρβ) (equilibriumSemigroup (mfData d s hs0 hsd V β hβ) ρβ τ ψ) = 0) ∧
    ∀ x, ∀ τ, 0 ≤ τ →
      HasDerivWithinAt (fun τ' => equilibriumSemigroup (mfData d s hs0 hsd V β hβ) ρβ τ' ψ x)
        (equilibriumGen d s ρβ β⁻¹ (equilibriumSemigroup (mfData d s hs0 hsd V β hβ) ρβ τ ψ) x)
        (Set.Ici 0) τ := by
  exact MFOneLe.equilibriumSemigroup_generator_of_one_le hd s hs0 hsd β hβ V hV ρβ hρβ hρC hpos
    ψ hψ

/-! ### Proposition 5.2 `C:prop:adjoint` (lines 5893–5906) -/

/-- Proposition 5.2 (uniform adjoint estimates): assume the data of Proposition 5.1; for an even
integer `j > d/2 + 4` with `K ≥ 2j + 4d + 20` there are `C, c, κ > 0` (uniform in
`β ∈ [β₋,β₊]`, independent of both times) such that for `0 ≤ r ≤ t` and `φ ∈ H^j`,
`‖Q_β U^{r,t}φ‖_{H^j} ≤ C e^{-c(t-r)} ‖Q_βφ‖_{H^j}` (`C:eq:U-decay`) and
`‖Q_β U^{r,t}φ - S_β(t-r) Q_βφ‖_{H^j} ≤ C e^{-c(t-r)} e^{-κ r} ‖Q_βφ‖_{H^j}`
(`C:eq:U-comparison`).  Here `U^{r,t}` is the propagator (`HRS.propagator`) along the solution
`ρ^t` of Proposition 5.1 and `S_β = equilibriumSemigroup`; `φ` is taken continuous (its `H^j`
class has a continuous representative, `j > d/2`). -/
theorem adjoint_decay_comparison (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) (j : ℕ) (hjeven : Even j) (hj : (d : ℝ) / 2 + 4 < j)
    (hK : 2 * j + 4 * d + 20 ≤ K) :
    ∃ C c κ : ℝ, 0 < C ∧ 0 < c ∧ 0 < κ ∧
      ∀ (β : ℝ) (hβ : β ∈ Set.Icc βm βp) (ρc : ℝ → Coeff d) (_ : IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc)
        (ρβ : Torus d → ℝ) (_ : IsThermalDensity (periodicRiesz d s) V β ρβ) (_ : Continuous ρβ)
        (_ : ∀ x, 0 < ρβ x) (φ : Torus d → ℝ) (_ : Continuous φ) (_ : MemSobolev j φ)
        (r t : ℝ) (_ : 0 ≤ r) (_ : r ≤ t),
        MemSobolev j (projMean (withDensityReal ρβ)
          (propagator (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) (mfPath ρc) r t φ)) ∧
        sobolevNorm j (projMean (withDensityReal ρβ)
            (propagator (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) (mfPath ρc) r t φ)) ≤
          C * Real.exp (-c * (t - r)) * sobolevNorm j (projMean (withDensityReal ρβ) φ) ∧
        sobolevNorm j (fun x => projMean (withDensityReal ρβ)
            (propagator (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) (mfPath ρc) r t φ) x -
          equilibriumSemigroup (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) ρβ (t - r)
            (projMean (withDensityReal ρβ) φ) x) ≤
          C * Real.exp (-c * (t - r)) * Real.exp (-κ * r) *
            sobolevNorm j (projMean (withDensityReal ρβ) φ) := by
  exact HRS.PDE.MFAdjoint.adjoint_decay_comparison_wiring hd s βm βp K V ρ₀ H j hjeven hj hK

/-! ### Corollary 5.3 `C:cor:linear` (lines 5917–5932) -/

/-- Corollary 5.3 (loss of the initial law for the linear equation), under the data of
Propositions 5.1–5.2: let `η⁰` be a zero-mass random distribution (an `H^{-j}_0`-valued random
variable), independent of the white noise, with `E‖η⁰‖_{H^{-j}} < ∞`, and `η` a solution of
`C:eq:linear-spde`.  For fixed smooth tests `φ_a` and fixed lags `τ_a ≥ 0`, there are `C, c > 0`
such that the law of `(⟨φ_a, η^{u+τ_a}⟩)_a` is within smooth (`𝖽_{C²}`) distance
`C(1 + E‖η⁰‖_{H^{-j}}) e^{-cu}` of the stationary Gaussian evolution `N(0, Σ)` with
`Σ = stationaryLagCov`, for all `u ≥ 0`.  The initial law may be non-Gaussian. -/
theorem linear_loss_of_initial_law (hd : 1 ≤ d) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ)
    (H : FiniteRegHyp d s βm βp K V ρ₀) (j : ℕ) (hjeven : Even j) (hj : (d : ℝ) / 2 + 4 < j)
    (hK : 2 * j + 4 * d + 20 ≤ K) (β : ℝ) (hβ : β ∈ Set.Icc βm βp) (ρc : ℝ → Coeff d)
    (hρc : IsMFSolutionHK d s V β⁻¹ K ρ₀ ρc) (ρβ : Torus d → ℝ)
    (hρβ : IsThermalDensity (periodicRiesz d s) V β ρβ) (hρC : Continuous ρβ)
    (hpos : ∀ x, 0 < ρβ x) (p : ℕ) (τ : Fin p → ℝ) (hτ : ∀ a, 0 ≤ τ a)
    (φ : Fin p → Torus d → ℝ) (hφ : ∀ a, Torus.IsSmooth (φ a)) :
    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧
      ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (η₀ : Ω → NegSobolev d j) (η : ℝ → Ω → NegSobolev d j),
        Measurable η₀ → Integrable (fun ω => ‖η₀ ω‖) P →
        IsLinearSPDESolution P (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) (mfPath ρc) j
          η₀ η →
        ∀ u : ℝ, 0 ≤ u →
          smoothDist 2
            (law P fun ω => (WithLp.toLp 2 fun a => NegSobolev.eval (η (u + τ a) ω) (φ a) :
              EuclideanSpace ℝ (Fin p)))
            (ProbabilityTheory.multivariateGaussian 0
              (stationaryLagCov d s β (mfData d s H.hs0 H.hsd V β (H.hβm.trans_le hβ.1)) ρβ τ φ)) ≤
          C * (1 + ∫ ω, ‖η₀ ω‖ ∂P) * Real.exp (-c * u) := by
  exact HRS.PDE.MFLinear.linear_loss_of_initial_law_aux hd s βm βp K V ρ₀ H j hjeven hj hK β hβ ρc
    hρc ρβ hρβ hρC hpos p τ hτ φ hφ

/-! ### Lemma 4.14 `lem:periodic-pair-inverse` (lines 4739–4747) -/

/-- Lemma 4.14 (the smooth two-copy inverse on the torus; Section 4 setting `d ≥ 2`, smooth `V`,
`ρ_β` the smooth positive thermal density, `M = -I`, `ν = β⁻¹`): for every differentiability
order `j ≥ 2` there is an order `J` ("sufficiently differentiable") such that for every doubly
centered kernel `R ∈ C^J(𝕋^d × 𝕋^d)`, the integral `Ψ_R = ∫_0^∞ U_t^xU_t^yR dt` converges in
`C^j` (integrable `C^j` norm, partial integrals converging in `C^j`), `Ψ_R ∈ C^j` is doubly
centered, and `-(𝒜_x + 𝒜_y)Ψ_R = R`. -/
theorem periodic_pair_inverse (hd : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (β : ℝ)
    (hβ : 0 < β) (V : Torus d → ℝ) (hV : Torus.IsSmooth V) (ρβ : Torus d → ℝ)
    (hρβ : IsThermalDensity (periodicRiesz d s) V β ρβ) (hρC : Torus.IsSmooth ρβ)
    (hpos : ∀ x, 0 < ρβ x) :
    ∀ j : ℕ, 2 ≤ j → ∃ J : ℕ, ∀ R : Torus d → Torus d → ℝ, IsCk2 J R →
      DoublyCentered (withDensityReal ρβ) R →
      (∀ t, 0 ≤ t → IsCk2 j (pairSemigroup (mfData d s hs0 hsd V β hβ) ρβ t R)) ∧
      IntegrableOn (fun t => cbNorm2 j (pairSemigroup (mfData d s hs0 hsd V β hβ) ρβ t R))
        (Set.Ici 0) ∧
      (∀ x y, IntegrableOn (fun t => pairSemigroup (mfData d s hs0 hsd V β hβ) ρβ t R x y)
        (Set.Ici 0)) ∧
      Tendsto (fun T : ℝ => cbNorm2 j (fun x y =>
          pairInverse (mfData d s hs0 hsd V β hβ) ρβ R x y -
            ∫ t in (0 : ℝ)..T, pairSemigroup (mfData d s hs0 hsd V β hβ) ρβ t R x y))
        atTop (𝓝 0) ∧
      IsCk2 j (pairInverse (mfData d s hs0 hsd V β hβ) ρβ R) ∧
      DoublyCentered (withDensityReal ρβ) (pairInverse (mfData d s hs0 hsd V β hβ) ρβ R) ∧
      ∀ x y, -(centeredGen (mfData d s hs0 hsd V β hβ) ρβ
            (fun x' => pairInverse (mfData d s hs0 hsd V β hβ) ρβ R x' y) x +
          centeredGen (mfData d s hs0 hsd V β hβ) ρβ
            (fun y' => pairInverse (mfData d s hs0 hsd V β hβ) ρβ R x y') y) = R x y := by
  exact MFPair.periodic_pair_inverse_aux hd s hs0 hsd β hβ V hV ρβ hρβ hρC hpos

/-! ### The nonlinear transient (prose lines 872–890; Proposition `E:prop:mean`, lines 7288–7313) -/

/-- `H:eq:nonlinear-transient` (lines 873–882), proved as Proposition `E:prop:mean`
(lines 7288–7313): `d ≥ 2`, `0 ≤ s < d`, `β > 0`, `V = 0`, `k ≠ 0` with `βĝ(k) ≤ 1/4`,
`λ = λ_{β,k}`.  There are `ε₀ > 0`, `C < ∞` and constants `C_j` (all independent of `ε`) such that for `0 < |ε| ≤ ε₀` the initial density
`ρ⁰ = 1 + εψ_k` has a global smooth positive solution `ρ` of `H:eq:meanfield` (weak form
`HRS.IsMeanFieldSolution` on every `[0,T]`, with `M = -I`), there is `A(ε)` with
`|A(ε) - ε| ≤ Cε²` and `sign A(ε) = sign ε` (so `A(ε) ≠ 0`), and for every `j ≥ 0`
`‖ρ^t - 1 - A(ε)e^{-λt}ψ_k‖_{C^j} ≤ C_j ε² e^{-3λt/2}` for `t ≥ 0`; the solution has Fourier
support in `{nk : n ∈ ℤ}` and is even in `k·x` (`ρ̂(t, nk) = ρ̂(t, -nk)`). -/
theorem nonlinear_transient (hd : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (β : ℝ)
    (hβ : 0 < β) (k : Lattice d) (hk : k ≠ 0) (hkβ : β * rieszCoeff d s k ≤ 1 / 4) :
    ∃ ε₀ C : ℝ, ∃ Cj : ℕ → ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < |ε| → |ε| ≤ ε₀ →
      ∃ ρ : ℝ → Torus d → ℝ,
        (∀ T, 0 < T → IsMeanFieldSolution (mfData d s hs0 hsd (fun _ => 0) β hβ) T ρ) ∧
        (∀ t, 0 ≤ t → Torus.IsSmooth (ρ t) ∧ ∀ x, 0 < ρ t x) ∧
        ρ 0 = (fun x => 1 + ε * cosTest k x) ∧
        ∃ A : ℝ, |A - ε| ≤ C * ε ^ 2 ∧ Real.sign A = Real.sign ε ∧
          (∀ j : ℕ, ∀ t, 0 ≤ t →
            Torus.cbNorm j (fun x =>
                ρ t x - 1 - A * Real.exp (-transientRate d s β k * t) * cosTest k x) ≤
              Cj j * ε ^ 2 * Real.exp (-3 * transientRate d s β k * t / 2)) ∧
          (∀ t, 0 ≤ t → ∀ l : Lattice d, (∀ n : ℤ, l ≠ n • k) → coeffOf (ρ t) l = 0) ∧
          (∀ t, 0 ≤ t → ∀ n : ℤ, coeffOf (ρ t) (n • k) = coeffOf (ρ t) (-(n • k))) := by
  exact HRS.PDE.MFTransient.nonlinear_transient_main hd s hs0 hsd β hβ k hk hkβ

end HRS.PDE
