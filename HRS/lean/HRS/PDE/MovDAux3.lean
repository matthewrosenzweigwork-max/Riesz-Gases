import HRS.PDE.MovDAux2

/-!
# MOVD Aux3: `movT_cond_hyp`
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory Set
open scoped ENNReal NNReal BigOperators

namespace HRS

variable {d N : ℕ}

set_option warn.classDefReducibility false in
/-- The σ-algebra generated by the path of `W`. -/
def movd_pathSigma {Ω : Type*} (W : ℝ≥0 → Ω → (Fin N → Euc d)) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => fun t : ℝ≥0 => W t ω) inferInstance

theorem movd_cond_hyp {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {D : DynData d} {T : ℝ} {ρ : ℝ → Torus d → ℝ} {X₀ : Ω → Config d N}
    {W : ℝ≥0 → Ω → (Fin N → Euc d)} {X : ℝ≥0 → Ω → Config d N}
    (h : MovHyp P D N T ρ X₀ W X) {B : Set (Config d N)} (hB : MeasurableSet B)
    (h0 : P ((X 0) ⁻¹' B) ≠ 0) : MovHyp (movT_cond P ((X 0) ⁻¹' B)) D N T ρ X₀ W X := by
  set A : Set Ω := (X 0) ⁻¹' B with hAdef
  have hX0 : Measurable (X 0) := h.sol.adapted 0
  have hA : MeasurableSet A := hX0 hB
  have hPk : IsProbabilityMeasure (movT_cond P A) := movT_cond_isProb P h0 (measure_ne_top _ _)
  have hac : movT_cond P A ≪ P := movd_cond_ac P A
  have hAB : A =ᵐ[P] X₀ ⁻¹' B := by
    filter_upwards [h.sol.init] with ω hω
    simp [hAdef, hω]
  -- independence of events of the path of `W` from `A`
  have hG := movd_indep_event P h.indep hB hAB
  -- the strong solution
  have hsol : IsStrongSolution (movT_cond P A) D T X₀ W X := by
    obtain ⟨Y, hY1, hY2⟩ := h.sol.lift
    exact ⟨⟨Y, hac.ae_le hY1, hY2⟩, hac.ae_le h.sol.init, hac.ae_le h.sol.cont, h.sol.adapted,
      hac.ae_le h.sol.no_collision⟩
  -- the filtered solution
  obtain ⟨ℱ, W', hF⟩ := h.filtered
  have hA0 : MeasurableSet[ℱ 0] A := by
    have := hF.adapted 0
    exact this hB
  have hAs : ∀ s : ℝ≥0, MeasurableSet[ℱ (s : ℝ)] A := fun s =>
    ℱ.mono (by simp) _ hA0
  have hBF := hF.brownian
  have hbf : IsBrownianFiltration (movT_cond P A) (movd_aug (movT_cond P A) ℱ) W' := by
    refine ⟨movd_aug_complete _ ℱ, fun t => (hBF.adapted t).mono le_sup_left le_rfl, hBF.zero, hBF.cont,
      ?_, ?_⟩
    · intro s t hst
      have hm1 : MeasurableSpace.comap (fun ω => W' t ω - W' s ω) inferInstance ≤ ‹MeasurableSpace Ω› := by
        refine Measurable.comap_le ?_
        exact ((hBF.adapted t).mono (ℱ.le _) le_rfl).sub ((hBF.adapted s).mono (ℱ.le _) le_rfl)
      have h1 := movd_cond_indep P hA h0 (hBF.indep_incr s t hst) (hAs s)
      exact movd_indep_null _ h1
    · intro s t hst
      have hl := hBF.gaussian_incr s t hst
      refine ⟨hl.aemeasurable.mono_ac hac, ?_⟩
      have hind := hBF.indep_incr s t hst
      rw [movd_cond_map_eq P hA h0 (G := MeasurableSpace.comap (fun ω => W' t ω - W' s ω) inferInstance)
        (comap_measurable _) hl.aemeasurable
        (fun S hS => (Indep_iff _ _ _).1 hind S A hS (hAs s))]
      exact hl.map_eq
  have hfilt : IsFilteredSolution (movT_cond P A) (movd_aug (movT_cond P A) ℱ) W' W X := by
    refine ⟨hbf, hac.ae_le hF.coords, fun t => (hF.adapted t).mono le_sup_left le_rfl, ?_⟩
    intro i
    have := hF.progressive i
    refine Measurable.mono this ?_ le_rfl
    exact sup_le_sup le_rfl (MeasurableSpace.comap_mono le_sup_left)
  -- Brownian motion
  have hpath : Measurable[movd_pathSigma W] (fun ω => fun t : ℝ≥0 => W t ω) := comap_measurable _
  have hvb : IsVectorBrownian (movT_cond P A) W := by
    refine ⟨fun i j => ?_, ?_⟩
    · have hb := h.brownian.1 i j
      refine ⟨⟨fun I => ?_⟩, hac.ae_le hb.cont⟩
      have hl := hb.hasLaw I
      refine ⟨hl.aemeasurable.mono_ac hac, ?_⟩
      have hg : Measurable (fun f : ℝ≥0 → Fin N → Euc d => I.restrict (fun t => f t i j)) := by
        refine measurable_pi_iff.2 fun k => ?_
        exact (EuclideanSpace.proj j).continuous.measurable.comp
          ((measurable_pi_apply i).comp (measurable_pi_apply (k : ℝ≥0)))
      rw [movd_cond_map_eq P hA h0 (G := movd_pathSigma W)
        (F := fun ω => I.restrict fun t => (W t ω i) j) (by exact hg.comp hpath) hl.aemeasurable hG]
      exact hl.map_eq
    · refine movd_cond_iIndepFun P hA h0 (G := movd_pathSigma W) (fun ij => ?_) h.brownian.2 hG
      have hg : Measurable (fun f : ℝ≥0 → Fin N → Euc d => fun t : ℝ≥0 => f t ij.1 ij.2) := by
        refine measurable_pi_iff.2 fun t => ?_
        exact (EuclideanSpace.proj ij.2).continuous.measurable.comp
          ((measurable_pi_apply ij.1).comp (measurable_pi_apply t))
      exact hg.comp hpath
  exact ⟨h.traj, hvb, movd_cond_indepFun P hA h0 h.indep hB hAB, hsol,
    ⟨movd_aug (movT_cond P A) ℱ, W', hfilt⟩⟩

end HRS

end
