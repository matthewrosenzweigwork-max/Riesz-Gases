import HRS.PDE.Toolbox
import HRS.PDE.MeanFieldAux
import HRS.PDE.MeanFieldThermalUnique
import HRS.Energy.Modulated

/-!
# Torus PDE layer VII (definitions): the mean-field equation with finite regularity, the
equilibrium adjoint and the nonlinear transient (package MF-01)

The definitions of `HRS/PDE/MeanField.lean`, moved here verbatim (bodies unchanged) so that the
proof files `HRS/PDE/MeanField*.lean` can import them and `MeanField.lean` can import the proof
files without an import cycle.  The representation decisions are documented in the module
docstring of `HRS/PDE/MeanField.lean`.
-/

noncomputable section

open MeasureTheory Filter Topology
open scoped ENNReal NNReal BigOperators ComplexConjugate

namespace HRS.PDE

variable {d : ℕ}

/-- The dynamics data of the mean-field equation `O:eq:mf-finite`: `M = -I`, `invβ = β⁻¹`
(`H:eq:meanfield` with `M = -I`). -/
def mfData (d : ℕ) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (V : Torus d → ℝ) (β : ℝ) (hβ : 0 < β) :
    DynData d :=
  ⟨s, -1, V, β⁻¹, hs0, hsd, inv_nonneg.mpr hβ.le⟩

/-- The right-hand side `β⁻¹Δρ + Div(ρ∇(V + g*ρ))` of `O:eq:mf-finite` (line 5774) in coefficients:
`-4π²|k|² β⁻¹ ρ̂(k) + ∑_j 2πi k_j [ρ̂ * (2πi k_j V̂ + 2πi k_j ĝ ρ̂)](k)`. -/
def mfRhsCoeff (d : ℕ) (s : ℝ) (V : Torus d → ℝ) (invβ : ℝ) (ρc : Coeff d) : Coeff d :=
  fun k => (invβ : ℂ) * laplaceCoeff ρc k +
    ∑ j : Fin d, derivCoeff j
      (mulCoeff ρc (fun k' => derivCoeff j (coeffOf V) k' + gradRieszCoeff d s j ρc k')) k

/-- A global solution of `O:eq:mf-finite` in `C([0,∞);H^K)` with initial density `ρ⁰`, at the
coefficient level: `ρ̂(0) = ρ̂⁰`, `ρ̂ ∈ C([0,∞);H^K)`, and the integrated equation for every mode
with an integrable integrand. -/
structure IsMFSolutionHK (d : ℕ) (s : ℝ) (V : Torus d → ℝ) (invβ K : ℝ) (ρ₀ : Torus d → ℝ)
    (ρc : ℝ → Coeff d) : Prop where
  init : ρc 0 = coeffOf ρ₀
  cont : ContinuousInHsOn K ρc (Set.Ici 0)
  integrable : ∀ k, ∀ t, 0 ≤ t →
    IntegrableOn (fun σ => mfRhsCoeff d s V invβ (ρc σ) k) (Set.Icc 0 t)
  eq : ∀ k, ∀ t, 0 ≤ t →
    ρc t k = coeffOf ρ₀ k + ∫ σ in (0 : ℝ)..t, mfRhsCoeff d s V invβ (ρc σ) k

/-- The density path `t ↦ ρ^t = toFun (ρ̂(t))` of a coefficient solution. -/
def mfPath (ρc : ℝ → Coeff d) : ℝ → Torus d → ℝ := fun t => toFun (ρc t)

/-- The hypotheses of Proposition 5.1 (lines 5772–5773), listed: `0 ≤ s < d`,
`0 < β₋ ≤ β₊ < ∞`, an integer `K > d/2 + 6`, `V ∈ C^{K+2}(𝕋^d)`, and a positive probability
density `ρ⁰ ∈ H^K` with `inf ρ⁰ > 0`.  (`d ≥ 1` and the range of `β` are hypotheses of the
theorems.) -/
structure FiniteRegHyp (d : ℕ) (s βm βp : ℝ) (K : ℕ) (V ρ₀ : Torus d → ℝ) : Prop where
  hs0 : 0 ≤ s
  hsd : s < d
  hβm : 0 < βm
  hββ : βm ≤ βp
  hK : (d : ℝ) / 2 + 6 < K
  hV : Torus.IsCk (K + 2) V
  hρ₀ : IsProbDensity ρ₀
  hρ₀H : MemSobolev K ρ₀
  hρ₀pos : ∃ c : ℝ, 0 < c ∧ ∀ x, c ≤ ρ₀ x

/-- The effective velocity `u^t = β⁻¹∇log ρ^t + ∇(V + g*ρ^t)` (line 5787), `∇g*ρ` with the
cancellation convention. -/
def effVelocity (d : ℕ) (s : ℝ) (V : Torus d → ℝ) (β : ℝ) (ρ : Torus d → ℝ) (x : Torus d) :
    Euc d :=
  β⁻¹ • Torus.grad (fun y => Real.log (ρ y)) x + Torus.grad V x +
    convGradConv (periodicRieszGrad d s) ρ x

/-- `-A_β L_β f = -(ν L_β f + K_β L_β f)` with `ν = β⁻¹`, `K_β = Kop g μ_β`, `L_β = Lop ρ_β`
(`C:eq:K`, `C:eq:AL`). -/
def equilibriumGen (d : ℕ) (s : ℝ) (ρβ : Torus d → ℝ) (ν : ℝ) (f : Torus d → ℝ) :
    Torus d → ℝ :=
  fun x => -(ν * Lop ρβ f x + Kop (periodicRiesz d s) (withDensityReal ρβ) (Lop ρβ f) x)

/-- The centered equilibrium backward semigroup `S_β(τ) ψ := Q_β U^{0,τ} ψ` for the frozen
coefficient `ρ_β` (generated by `-A_β L_β`, line 5892; `equilibriumSemigroup_generator`). -/
def equilibriumSemigroup (D : DynData d) (ρβ : Torus d → ℝ) (τ : ℝ) (ψ : Torus d → ℝ) :
    Torus d → ℝ :=
  projMean (withDensityReal ρβ) (propagator D (fun _ => ρβ) 0 τ ψ)

/-- A solution `η` of the linear SPDE `C:eq:linear-spde` (lines 5921–5925)
`∂_tη = νΔη + Div(η∇(V+g*ρ^t) + ρ^t∇g*η) - √(2ν) Div(√ρ^t ξ)` on `[0,∞)`, in mild form
(`H:eq:linear-mild`; modelled on `HRS.IsLinearFluctuationSolution`): `η^t - η⁰ ∘ U^{0,t}` is a
centered Gaussian family independent of `η⁰` with covariance
`2ν ∫_0^{t∧t'} μ^r(∇U^{r,t}φ·∇U^{r,t'}ψ) dr` (noise level `q = ν = D.invβ`), paths continuous in
`H^{-j}_0` (zero mass built in).  `D` carries `M = -I`, `ν = β⁻¹`. -/
structure IsLinearSPDESolution {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (D : DynData d) (ρ : ℝ → Torus d → ℝ) (j : ℝ) (η₀ : Ω → NegSobolev d j)
    (η : ℝ → Ω → NegSobolev d j) : Prop where
  init : ∀ᵐ ω ∂P, η 0 ω = η₀ ω
  cont : ∀ᵐ ω ∂P, ContinuousOn (fun t => η t ω) (Set.Ici 0)
  meas : ∀ t, Measurable (η t)
  gaussian_part : ∀ (p : ℕ) (ts : Fin p → ℝ) (φ : Fin p → Torus d → ℝ),
    (∀ a, 0 ≤ ts a) → (∀ a, Torus.IsSmooth (φ a)) →
    let G : Ω → EuclideanSpace ℝ (Fin p) := fun ω => WithLp.toLp 2 fun a =>
      NegSobolev.eval (η (ts a) ω) (φ a) - NegSobolev.eval (η₀ ω) (propagator D ρ 0 (ts a) (φ a))
    ProbabilityTheory.IndepFun G η₀ P ∧
    law P G = ProbabilityTheory.multivariateGaussian 0 (Matrix.of fun a b =>
      2 * D.invβ * ∫ r in Set.Icc 0 (min (ts a) (ts b)), ∫ x,
        inner ℝ (Torus.grad (propagator D ρ r (ts a) (φ a)) x)
          (Torus.grad (propagator D ρ r (ts b) (φ b)) x) * ρ r x)

/-- The covariance of the stationary Gaussian evolution at lags `τ_a` for tests `φ_a`
(`C:eq:stationary-cov`, lines 5908–5913, with the time structure of the stationary process):
`Σ_{ab} = 𝒞_β(φ_a, S_β(τ_b - τ_a) φ_b)` for `τ_a ≤ τ_b` (and symmetrically), where
`𝒞_β(φ,ψ) = ⟨Q_βφ, (I+βK_β)^{-1}Q_βψ⟩_{L²(μ_β)}` is `HRS.susceptibilityCov`. -/
def stationaryLagCov (d : ℕ) (s β : ℝ) (D : DynData d) (ρβ : Torus d → ℝ) {p : ℕ}
    (τ : Fin p → ℝ) (φ : Fin p → Torus d → ℝ) : Matrix (Fin p) (Fin p) ℝ :=
  Matrix.of fun a b =>
    if τ a ≤ τ b then
      susceptibilityCov (periodicRiesz d s) (withDensityReal ρβ) β (φ a)
        (equilibriumSemigroup D ρβ (τ b - τ a) (φ b))
    else
      susceptibilityCov (periodicRiesz d s) (withDensityReal ρβ) β
        (equilibriumSemigroup D ρβ (τ a - τ b) (φ a)) (φ b)

/-- The centered equilibrium generator `𝒜 f = Q_β 𝓛_β f` (`U_t = e^{t𝒜}`, line 4740). -/
def centeredGen (D : DynData d) (ρβ : Torus d → ℝ) (f : Torus d → ℝ) : Torus d → ℝ :=
  projMean (withDensityReal ρβ) (backwardGenerator D ρβ f)

/-- `R` is doubly centered: `∫ R(x,y) dμ_β(x) = 0` for all `y` and `∫ R(x,y) dμ_β(y) = 0` for all
`x`. -/
def DoublyCentered (μ : Measure (Torus d)) (R : Torus d → Torus d → ℝ) : Prop :=
  (∀ y, pair μ (fun x => R x y) = 0) ∧ ∀ x, pair μ (fun y => R x y) = 0

/-- `U_t^x U_t^y R`: the semigroup applied in each variable. -/
def pairSemigroup (D : DynData d) (ρβ : Torus d → ℝ) (t : ℝ) (R : Torus d → Torus d → ℝ) :
    Torus d → Torus d → ℝ :=
  fun x y => equilibriumSemigroup D ρβ t (fun y' => equilibriumSemigroup D ρβ t (fun x' => R x' y') x) y

/-- `Ψ_R = ∫_0^∞ U_t^x U_t^y R dt` (`eq:periodic-pair-inverse`, line 4743). -/
def pairInverse (D : DynData d) (ρβ : Torus d → ℝ) (R : Torus d → Torus d → ℝ) :
    Torus d → Torus d → ℝ :=
  fun x y => ∫ t in Set.Ici (0 : ℝ), pairSemigroup D ρβ t R x y

/-- `ψ_k = √2 cos(2πk·x)` (line 875). -/
def cosTest (k : Lattice d) (x : Torus d) : ℝ := Real.sqrt 2 * Torus.cosMode k x

/-- `λ_{β,k} = (2π|k|)²(β⁻¹ + ĝ(k))` (line 876). -/
def transientRate (d : ℕ) (s β : ℝ) (k : Lattice d) : ℝ :=
  (2 * Real.pi * Lattice.enorm k) ^ 2 * (β⁻¹ + rieszCoeff d s k)

private theorem enorm_single_aux (i : Fin d) (n : ℕ) :
    Lattice.enorm (Pi.single i (n : ℤ) : Lattice d) = n := by
  have : Lattice.toEuc (Pi.single i (n : ℤ) : Lattice d) = EuclideanSpace.single i (n : ℝ) := by
    ext j
    by_cases h : j = i
    · subst h; simp [Lattice.toEuc]
    · simp [Lattice.toEuc, Pi.single_apply, h]
  rw [Lattice.enorm, this]
  simp

/-- `E:eq:kchoice` (lines 7291–7294): "such a choice exists at every positive temperature":
for `β > 0` there is `k ≠ 0` with `β ĝ(k) ≤ 1/4`. -/
theorem exists_transient_mode (hd : 2 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d) (β : ℝ)
    (hβ : 0 < β) : ∃ k : Lattice d, k ≠ 0 ∧ β * rieszCoeff d s k ≤ 1 / 4 := by
  have hd0 : 0 < d := by omega
  set i : Fin d := ⟨0, hd0⟩
  have h1 : Tendsto (fun x : ℝ => x ^ (s - (d : ℝ))) atTop (𝓝 0) := by
    simpa [neg_sub] using tendsto_rpow_neg_atTop (y := (d : ℝ) - s) (by linarith)
  have h2 : Tendsto (fun n : ℕ => β * (rieszConst d s * (2 * Real.pi * (n : ℝ)) ^ (s - (d : ℝ))))
      atTop (𝓝 0) := by
    have h3 : Tendsto (fun n : ℕ => 2 * Real.pi * (n : ℝ)) atTop atTop :=
      tendsto_natCast_atTop_atTop.const_mul_atTop (by positivity)
    have := ((h1.comp h3).const_mul (rieszConst d s)).const_mul β
    simpa using this
  obtain ⟨N, hN, hN1⟩ := ((h2.eventually (Iio_mem_nhds (show (0:ℝ) < 1/4 by norm_num))).and
    (eventually_ge_atTop 1)).exists
  have hk : (Pi.single i (N : ℤ) : Lattice d) ≠ 0 := by
    intro h
    have := congrFun h i
    simp at this
    omega
  refine ⟨Pi.single i (N : ℤ), hk, ?_⟩
  unfold rieszCoeff
  simp only [hk, ite_false]
  rw [enorm_single_aux]
  exact le_of_lt hN

end HRS.PDE
