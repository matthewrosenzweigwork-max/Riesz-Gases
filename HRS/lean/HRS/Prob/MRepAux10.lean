import HRS.Prob.MRepAux9

/-!
# MREP, part 10: progressive modifications (Chung–Doob)

A jointly measurable adapted real process has a progressive modification: for every `t`, `Ỹ_t = Y_t` almost surely.
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal BigOperators

namespace HRS.MRep

section CtblDet

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The product σ-algebra of `ℝ` with the σ-algebra generated by `S`. -/
abbrev prodσ (S : Set (Set Ω)) : MeasurableSpace (ℝ × Ω) :=
  @Prod.instMeasurableSpace ℝ Ω _ (MeasurableSpace.generateFrom S)

/-- A set of the product σ-algebra depends only on countably many measurable sets. -/
def CtblDet (E : Set (ℝ × Ω)) : Prop :=
  ∃ S : Set (Set Ω), S.Countable ∧ (∀ s ∈ S, MeasurableSet s) ∧ MeasurableSet[prodσ S] E

lemma prodσ_mono {S S' : Set (Set Ω)} (h : S ⊆ S') : prodσ S ≤ prodσ S' := by
  unfold prodσ
  exact sup_le_sup le_rfl (MeasurableSpace.comap_mono (MeasurableSpace.generateFrom_mono h))

lemma prodσ_le (S : Set (Set Ω)) (hS : ∀ s ∈ S, MeasurableSet s) :
    prodσ S ≤ (inferInstance : MeasurableSpace (ℝ × Ω)) := by
  refine sup_le le_sup_left ?_
  exact (MeasurableSpace.comap_mono (MeasurableSpace.generateFrom_le hS)).trans le_sup_right

/-- The σ-algebra of `CtblDet` sets. -/
def ctblDetSpace : MeasurableSpace (ℝ × Ω) where
  MeasurableSet' := CtblDet
  measurableSet_empty := ⟨∅, Set.countable_empty, by simp, @MeasurableSet.empty _ (prodσ ∅)⟩
  measurableSet_compl := by
    rintro E ⟨S, hSc, hSm, hE⟩
    exact ⟨S, hSc, hSm, @MeasurableSet.compl _ _ (prodσ S) hE⟩
  measurableSet_iUnion := by
    intro f hf
    choose S hSc hSm hE using hf
    refine ⟨⋃ n, S n, Set.countable_iUnion hSc, fun s hs => ?_, ?_⟩
    · obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hs
      exact hSm n s hn
    · refine @MeasurableSet.iUnion _ _ (prodσ (⋃ n, S n)) _ _ fun n => ?_
      exact prodσ_mono (Set.subset_iUnion S n) _ (hE n)

lemma measurableSet_imp_ctblDet {E : Set (ℝ × Ω)} (hE : MeasurableSet E) : CtblDet E := by
  have h1 : (inferInstance : MeasurableSpace (ℝ × Ω)) ≤ ctblDetSpace := by
    refine sup_le ?_ ?_
    · rintro _ ⟨A, hA, rfl⟩
      refine (show CtblDet ((Prod.fst : ℝ × Ω → ℝ) ⁻¹' A) from ⟨∅, Set.countable_empty, by simp, ?_⟩)
      have : MeasurableSet[MeasurableSpace.comap (Prod.fst : ℝ × Ω → ℝ) (inferInstance : MeasurableSpace ℝ)]
          ((Prod.fst : ℝ × Ω → ℝ) ⁻¹' A) := ⟨A, hA, rfl⟩
      exact (le_sup_left : MeasurableSpace.comap (Prod.fst : ℝ × Ω → ℝ) (inferInstance : MeasurableSpace ℝ) ≤ prodσ ∅) _ this
    · rintro _ ⟨A, hA, rfl⟩
      refine (show CtblDet ((Prod.snd : ℝ × Ω → Ω) ⁻¹' A) from ⟨{A}, Set.countable_singleton _, by simpa using hA, ?_⟩)
      have : MeasurableSet[MeasurableSpace.comap (Prod.snd : ℝ × Ω → Ω) (MeasurableSpace.generateFrom ({A} : Set (Set Ω)))]
          ((Prod.snd : ℝ × Ω → Ω) ⁻¹' A) := ⟨A, MeasurableSpace.measurableSet_generateFrom rfl, rfl⟩
      exact (le_sup_right : MeasurableSpace.comap (Prod.snd : ℝ × Ω → Ω) (MeasurableSpace.generateFrom ({A} : Set (Set Ω))) ≤ prodσ {A}) _ this
  exact (show CtblDet E from h1 _ hE)

lemma exists_ctblDet_measurable {Y : ℝ × Ω → ℝ} (hY : Measurable Y) :
    ∃ S : Set (Set Ω), S.Countable ∧ (∀ s ∈ S, MeasurableSet s) ∧ Measurable[prodσ S] Y := by
  have h : ∀ q : ℚ, ∃ S : Set (Set Ω), S.Countable ∧ (∀ s ∈ S, MeasurableSet s) ∧
      MeasurableSet[prodσ S] (Y ⁻¹' Set.Ioi (q : ℝ)) := fun q =>
    measurableSet_imp_ctblDet (hY measurableSet_Ioi)
  choose S hSc hSm hE using h
  refine ⟨⋃ q, S q, Set.countable_iUnion hSc, fun s hs => ?_, ?_⟩
  · obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hs
    exact hSm n s hn
  · letI : MeasurableSpace (ℝ × Ω) := prodσ (⋃ q, S q)
    refine measurable_of_Ioi fun x => ?_
    have : Y ⁻¹' Set.Ioi x = ⋃ q : {q : ℚ // x < (q : ℝ)}, Y ⁻¹' Set.Ioi ((q.1 : ℚ) : ℝ) := by
      ext p
      simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_iUnion, Subtype.exists]
      constructor
      · intro hp
        obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn hp
        exact ⟨q, hq1, hq2⟩
      · rintro ⟨q, hq1, hq2⟩
        exact hq1.trans hq2
    rw [this]
    refine @MeasurableSet.iUnion _ _ (prodσ (⋃ q, S q)) _ _ fun q => ?_
    exact prodσ_mono (Set.subset_iUnion S q.1) _ (hE q.1)

end CtblDet

section Sep

lemma sep_aux {Ω' : Type*} [MeasurableSpace Ω'] [MeasurableSpace.CountablyGenerated Ω']
    (μ : Measure Ω') [IsFiniteMeasure μ] (f : ℝ → Ω' → ℝ) (hf : ∀ t, Measurable (f t))
    (hb : ∀ t ω, |f t ω| ≤ 1) (δ : ℝ) (hδ : 0 < δ) :
    ∃ D : Set ℝ, D.Countable ∧ ∀ t, ∃ d ∈ D,
      ∫⁻ ω, ‖f t ω - f d ω‖ₑ ^ 2 ∂μ < ENNReal.ofReal δ := by
  have hmem : ∀ t, MemLp (f t) 2 μ := fun t =>
    MemLp.of_bound (hf t).aestronglyMeasurable 1 (ae_of_all _ fun ω => by
      simpa [Real.norm_eq_abs] using hb t ω)
  haveI : Fact ((2 : ℝ≥0∞) ≠ ⊤) := ⟨by norm_num⟩
  set g : ℝ → Lp ℝ 2 μ := fun t => (hmem t).toLp (f t) with hg
  obtain ⟨c, hcsub, hcc, hdense⟩ :=
    (TopologicalSpace.IsSeparable.of_separableSpace (Set.range g)).exists_countable_dense_subset
  have hex : ∀ y : c, ∃ d, g d = y.1 := fun y => hcsub y.2
  choose dd hdd using hex
  haveI : Countable c := hcc.to_subtype
  refine ⟨Set.range dd, Set.countable_range _, fun t => ?_⟩
  have hgt : g t ∈ closure c := hdense ⟨t, rfl⟩
  obtain ⟨y, hyc, hy⟩ := Metric.mem_closure_iff.1 hgt (Real.sqrt δ) (Real.sqrt_pos.2 hδ)
  refine ⟨dd ⟨y, hyc⟩, ⟨_, rfl⟩, ?_⟩
  have h1 : ‖g t - g (dd ⟨y, hyc⟩)‖ < Real.sqrt δ := by
    rw [hdd ⟨y, hyc⟩, ← dist_eq_norm]; exact hy
  have h2 := norm_sub_toLp_sq (hmem t) (hmem (dd ⟨y, hyc⟩))
  have h3 : (∫⁻ ω, ‖f t ω - f (dd ⟨y, hyc⟩) ω‖ₑ ^ 2 ∂μ).toReal < δ := by
    rw [← h2]
    calc ‖g t - g (dd ⟨y, hyc⟩)‖ ^ 2 < Real.sqrt δ ^ 2 :=
          pow_lt_pow_left₀ h1 (norm_nonneg _) (by norm_num)
      _ = δ := Real.sq_sqrt hδ.le
  have hfin := (lintegral_enorm_sq_lt_top ((hmem t).sub (hmem (dd ⟨y, hyc⟩)))).ne
  exact (ENNReal.lt_ofReal_iff_toReal_lt hfin).2 h3

lemma meas_enorm_sq_sub {Ω' : Type*} [MeasurableSpace Ω'] {f g : Ω' → ℝ} (hf : Measurable f)
    (hg : Measurable g) : Measurable fun ω => ‖f ω - g ω‖ₑ ^ 2 :=
  ((hf.sub hg).enorm).pow_const 2

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

lemma exists_ctbl_times {P : Measure Ω} [IsProbabilityMeasure P] {Y : ℝ → Ω → ℝ}
    (hY : Measurable fun p : ℝ × Ω => Y p.1 p.2) (hb : ∀ t ω, |Y t ω| ≤ 1) (δ : ℝ) (hδ : 0 < δ) :
    ∃ D : Set ℝ, D.Countable ∧ ∀ t, ∃ d ∈ D,
      ∫⁻ ω, ‖Y t ω - Y d ω‖ₑ ^ 2 ∂P < ENNReal.ofReal δ := by
  obtain ⟨S, hSc, hSm, hYm⟩ := exists_ctblDet_measurable hY
  have hm₀ : MeasurableSpace.generateFrom S ≤ mΩ := MeasurableSpace.generateFrom_le hSm
  have hYt : ∀ t, Measurable[MeasurableSpace.generateFrom S] (Y t) := fun t =>
    @Measurable.comp Ω (ℝ × Ω) ℝ (MeasurableSpace.generateFrom S) (prodσ S) _ _ _ hYm
      (@measurable_prodMk_left ℝ Ω _ (MeasurableSpace.generateFrom S) t)
  have hcg : @MeasurableSpace.CountablyGenerated Ω (MeasurableSpace.generateFrom S) :=
    @MeasurableSpace.CountablyGenerated.mk Ω (MeasurableSpace.generateFrom S) ⟨S, hSc, rfl⟩
  have hfin : @IsFiniteMeasure Ω (MeasurableSpace.generateFrom S) (P.trim hm₀) :=
    isFiniteMeasure_trim hm₀
  obtain ⟨D, hD, h⟩ := @sep_aux Ω (MeasurableSpace.generateFrom S) hcg (P.trim hm₀) hfin Y hYt hb δ hδ
  refine ⟨D, hD, fun t => ?_⟩
  obtain ⟨d, hd, hlt⟩ := h t
  refine ⟨d, hd, ?_⟩
  have hmeas : Measurable[MeasurableSpace.generateFrom S] fun ω => ‖Y t ω - Y d ω‖ₑ ^ 2 :=
    @meas_enorm_sq_sub Ω (MeasurableSpace.generateFrom S) _ _ (hYt t) (hYt d)
  rw [← lintegral_trim hm₀ hmeas]
  exact hlt

end Sep

section Partition

lemma exists_downward_cofinal (C : Set ℝ) :
    ∃ E : Set ℝ, E ⊆ C ∧ E.Countable ∧ ∀ t ∈ C, ∃ c ∈ E, c ≤ t := by
  classical
  set c : ℚ → ℝ := fun q => if h : (C ∩ Set.Iic (q : ℝ)).Nonempty then h.some else 0 with hc
  set E₁ : Set ℝ := {t | t ∈ C ∧ ∃ q : ℚ, (q : ℝ) < t ∧ C ∩ Set.Ioo (q : ℝ) t = ∅} with hE₁
  have hE₁c : E₁.Countable := by
    have hsub : E₁ ⊆ ⋃ q : ℚ, {t | t ∈ C ∧ (q : ℝ) < t ∧ C ∩ Set.Ioo (q : ℝ) t = ∅} := by
      rintro t ⟨htC, q, hq, hqe⟩
      exact Set.mem_iUnion.2 ⟨q, htC, hq, hqe⟩
    refine (Set.countable_iUnion fun q => ?_).mono hsub
    refine (Set.Subsingleton.finite ?_).countable
    rintro t ⟨htC, hqt, hte⟩ t' ⟨htC', hqt', hte'⟩
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · have : t ∈ C ∩ Set.Ioo (q : ℝ) t' := ⟨htC, hqt, h⟩
      rw [hte'] at this; exact this
    · have : t' ∈ C ∩ Set.Ioo (q : ℝ) t := ⟨htC', hqt', h⟩
      rw [hte] at this; exact this
  set E₂ : Set ℝ := {x | ∃ q : ℚ, (C ∩ Set.Iic (q : ℝ)).Nonempty ∧ x = c q} with hE₂
  have hE₂c : E₂.Countable := by
    have : E₂ ⊆ Set.range c := fun x ⟨q, _, hx⟩ => ⟨q, hx.symm⟩
    exact (Set.countable_range c).mono this
  refine ⟨E₁ ∪ E₂, ?_, hE₁c.union hE₂c, ?_⟩
  · rintro x (hx | ⟨q, hq, rfl⟩)
    · exact hx.1
    · simp only [hc, dif_pos hq]
      exact hq.some_mem.1
  · intro t ht
    by_cases h1 : ∃ q : ℚ, (q : ℝ) < t ∧ C ∩ Set.Ioo (q : ℝ) t = ∅
    · exact ⟨t, Or.inl ⟨ht, h1⟩, le_rfl⟩
    · push Not at h1
      obtain ⟨q0, hq0⟩ := exists_rat_lt t
      obtain ⟨u, huC, hu1, hu2⟩ := h1 q0 hq0
      obtain ⟨q', hq'1, hq'2⟩ := exists_rat_btwn hu2
      have hne : (C ∩ Set.Iic (q' : ℝ)).Nonempty := ⟨u, huC, hq'1.le⟩
      refine ⟨c q', Or.inr ⟨q', hne, rfl⟩, ?_⟩
      simp only [hc, dif_pos hne]
      exact hne.some_mem.2.trans hq'2.le

lemma exists_refine_partition (C : ℕ → Set ℝ) (hC : ∀ m, MeasurableSet (C m))
    (hpart : ∀ t, ∃! m, t ∈ C m) :
    ∃ (κ : ℕ → ℝ) (K : ℕ → Set ℝ), (∀ j, MeasurableSet (K j)) ∧ (∀ t, ∃! j, t ∈ K j) ∧
      (∀ j, ∀ t ∈ K j, ∃ m, κ j ∈ C m ∧ t ∈ C m) ∧ (∀ j, ∀ t ∈ K j, κ j ≤ t) := by
  classical
  have hE : ∀ m, ∃ E : Set ℝ, E ⊆ C m ∧ E.Countable ∧ ∀ t ∈ C m, ∃ c ∈ E, c ≤ t :=
    fun m => exists_downward_cofinal (C m)
  choose E hEsub hEc hEcof using hE
  have hen : ∀ m, ∃ ee : ℕ → ℝ, (E m).Nonempty → E m = Set.range ee := by
    intro m
    by_cases hne : (E m).Nonempty
    · obtain ⟨f, hf⟩ := (hEc m).exists_eq_range hne
      exact ⟨f, fun _ => hf⟩
    · exact ⟨fun _ => 0, fun h => absurd h hne⟩
  choose ee hee using hen
  -- cells indexed by pairs
  set K' : ℕ × ℕ → Set ℝ := fun p => {t | t ∈ C p.1 ∧ ee p.1 p.2 ≤ t ∧ ∀ n' < p.2, t < ee p.1 n'} with hK'
  have hK'm : ∀ p, MeasurableSet (K' p) := by
    intro p
    have h1 : MeasurableSet {t : ℝ | ee p.1 p.2 ≤ t} := measurableSet_Ici
    have h2 : MeasurableSet {t : ℝ | ∀ n' < p.2, t < ee p.1 n'} := by
      have : {t : ℝ | ∀ n' < p.2, t < ee p.1 n'} = ⋂ n' ∈ Finset.range p.2, Set.Iio (ee p.1 n') := by
        ext t; simp
      rw [this]
      exact Finset.measurableSet_biInter _ fun n' _ => measurableSet_Iio
    exact (hC p.1).inter (h1.inter h2)
  have hK'ex : ∀ t, ∃! p, t ∈ K' p := by
    intro t
    obtain ⟨m, hm, hmu⟩ := hpart t
    have hex : ∃ n, ee m n ≤ t := by
      obtain ⟨c, hcE, hct⟩ := hEcof m t hm
      have hne : (E m).Nonempty := ⟨c, hcE⟩
      rw [hee m hne] at hcE
      obtain ⟨n, hn⟩ := hcE
      exact ⟨n, hn ▸ hct⟩
    refine ⟨(m, Nat.find hex), ⟨hm, Nat.find_spec hex, fun n' hn' => ?_⟩, ?_⟩
    · exact not_le.1 (Nat.find_min hex hn')
    · rintro ⟨m', n'⟩ ⟨hm', hn1, hn2⟩
      have : m' = m := hmu m' hm'
      subst this
      have h1 : Nat.find hex ≤ n' := Nat.find_min' hex hn1
      have h2 : ¬ (Nat.find hex < n') := fun hlt => not_le.2 (hn2 _ hlt) (Nat.find_spec hex)
      exact Prod.ext rfl (le_antisymm (not_lt.1 h2) h1)
  obtain ⟨eqv⟩ : Nonempty ((ℕ × ℕ) ≃ ℕ) := ⟨Denumerable.eqv (ℕ × ℕ)⟩
  refine ⟨fun j => ee (eqv.symm j).1 (eqv.symm j).2, fun j => K' (eqv.symm j),
    fun j => hK'm _, fun t => ?_, fun j t ht => ?_, fun j t ht => ht.2.1⟩
  · obtain ⟨p, hp, hpu⟩ := hK'ex t
    exact ⟨eqv p, by simpa using hp, fun j hj => by
      have := hpu (eqv.symm j) hj
      rw [← this]; simp⟩
  · refine ⟨(eqv.symm j).1, ?_, ht.1⟩
    obtain ⟨c, hcE, -⟩ := hEcof (eqv.symm j).1 t ht.1
    have hne : (E (eqv.symm j).1).Nonempty := ⟨c, hcE⟩
    refine hEsub (eqv.symm j).1 ?_
    rw [hee _ hne]
    exact ⟨(eqv.symm j).2, rfl⟩

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

lemma exists_time_partition {P : Measure Ω} [IsProbabilityMeasure P] {Y : ℝ → Ω → ℝ}
    (hY : Measurable fun p : ℝ × Ω => Y p.1 p.2) (hb : ∀ t ω, |Y t ω| ≤ 1) (δ : ℝ) (hδ : 0 < δ) :
    ∃ (κ : ℕ → ℝ) (K : ℕ → Set ℝ), (∀ j, MeasurableSet (K j)) ∧ (∀ t, ∃! j, t ∈ K j) ∧
      (∀ j, ∀ t ∈ K j, κ j ≤ t) ∧
      (∀ j, ∀ t ∈ K j, ∫⁻ ω, ‖Y t ω - Y (κ j) ω‖ₑ ^ 2 ∂P ≤ ENNReal.ofReal (4 * δ)) := by
  classical
  obtain ⟨D, hDc, hD⟩ := exists_ctbl_times (P := P) hY hb δ hδ
  have hDne : D.Nonempty := by
    obtain ⟨d, hd, -⟩ := hD 0
    exact ⟨d, hd⟩
  obtain ⟨d, hd⟩ := hDc.exists_eq_range hDne
  set Dist : ℝ → ℝ → ℝ≥0∞ := fun t s => ∫⁻ ω, ‖Y t ω - Y s ω‖ₑ ^ 2 ∂P with hDist
  have hYs : ∀ s, Measurable fun p : ℝ × Ω => Y s p.2 := fun s =>
    hY.comp (measurable_const.prodMk measurable_snd)
  have hYω : ∀ s, Measurable (Y s) := fun s => hY.comp measurable_prodMk_left
  have hDm : ∀ s, Measurable fun t => Dist t s := by
    intro s
    have : Measurable fun p : ℝ × Ω => ‖Y p.1 p.2 - Y s p.2‖ₑ ^ 2 :=
      ((hY.sub (hYs s)).enorm).pow_const 2
    exact this.lintegral_prod_right'
  set C' : ℕ → Set ℝ := fun m => {t | Dist t (d m) < ENNReal.ofReal δ} with hC'
  have hC'm : ∀ m, MeasurableSet (C' m) := fun m => measurableSet_lt (hDm _) measurable_const
  set C : ℕ → Set ℝ := fun m => {t | t ∈ C' m ∧ ∀ m' < m, t ∉ C' m'} with hC
  have hCm : ∀ m, MeasurableSet (C m) := by
    intro m
    have : C m = C' m ∩ ⋂ m' ∈ Finset.range m, (C' m')ᶜ := by ext t; simp [hC]
    rw [this]
    exact (hC'm m).inter (Finset.measurableSet_biInter _ fun m' _ => (hC'm m').compl)
  have hex : ∀ t, ∃ m, t ∈ C' m := by
    intro t
    obtain ⟨dd, hdd, hlt⟩ := hD t
    rw [hd] at hdd
    obtain ⟨m, rfl⟩ := hdd
    exact ⟨m, hlt⟩
  have hpart : ∀ t, ∃! m, t ∈ C m := by
    intro t
    have h := hex t
    refine ⟨Nat.find h, ⟨Nat.find_spec h, fun m' hm' => Nat.find_min h hm'⟩, ?_⟩
    rintro m ⟨hm1, hm2⟩
    refine le_antisymm ?_ (Nat.find_min' h hm1)
    by_contra hlt
    exact hm2 _ (not_le.1 hlt) (Nat.find_spec h)
  obtain ⟨κ, K, hKm, hKu, hKC, hκ⟩ := exists_refine_partition C hCm hpart
  refine ⟨κ, K, hKm, hKu, hκ, fun j t ht => ?_⟩
  obtain ⟨m, hκm, htm⟩ := hKC j t ht
  have h1 : Dist t (d m) < ENNReal.ofReal δ := htm.1
  have h2 : Dist (κ j) (d m) < ENNReal.ofReal δ := hκm.1
  have h3 : Dist (d m) (κ j) = Dist (κ j) (d m) := by
    simp only [hDist]; refine lintegral_congr fun ω => ?_; rw [enorm_sub_rev]
  have hmeas1 : Measurable fun ω => ‖Y t ω - Y (d m) ω‖ₑ ^ 2 :=
    ((hYω t).sub (hYω _)).enorm.pow_const 2
  calc Dist t (κ j) = ∫⁻ ω, ‖Y t ω - Y (κ j) ω‖ₑ ^ 2 ∂P := rfl
    _ ≤ ∫⁻ ω, (2 * ‖Y t ω - Y (d m) ω‖ₑ ^ 2 + 2 * ‖Y (d m) ω - Y (κ j) ω‖ₑ ^ 2) ∂P := by
        refine lintegral_mono fun ω => ?_
        have := HRS.enorm_add_sq_le (Y t ω - Y (d m) ω) (Y (d m) ω - Y (κ j) ω)
        simpa using this
    _ = 2 * Dist t (d m) + 2 * Dist (d m) (κ j) := by
        rw [lintegral_add_left (hmeas1.const_mul 2), lintegral_const_mul' _ _ (by simp),
          lintegral_const_mul' _ _ (by simp)]
    _ ≤ 2 * ENNReal.ofReal δ + 2 * ENNReal.ofReal δ := by
        rw [h3]
        gcongr
    _ = ENNReal.ofReal (4 * δ) := by
        rw [ENNReal.ofReal_mul (by norm_num)]
        simp only [ENNReal.ofReal_ofNat]
        ring

lemma meas_comp_J {A Ω' : Type*} [MeasurableSpace A] [MeasurableSpace Ω'] (J : A → ℕ)
    (hJ : Measurable J) (G : ℕ → Ω' → ℝ) (hG : ∀ j, Measurable (G j)) :
    Measurable fun p : A × Ω' => G (J p.1) p.2 := by
  have h1 : Measurable fun q : ℕ × Ω' => G q.1 q.2 :=
    measurable_from_prod_countable_right (fun j => hG j)
  exact h1.comp ((hJ.comp measurable_fst).prodMk measurable_snd)

lemma exists_progressive_approx {P : Measure Ω} [IsProbabilityMeasure P] {ℱ : Filtration ℝ mΩ}
    {Y : ℝ → Ω → ℝ} (hY : Measurable fun p : ℝ × Ω => Y p.1 p.2)
    (had : ∀ t, Measurable[ℱ t] (Y t)) (hb : ∀ t ω, |Y t ω| ≤ 1) (δ : ℝ) (hδ : 0 < δ) :
    ∃ Z : ℝ → Ω → ℝ, IsProgressive ℱ Z ∧ (∀ t ω, |Z t ω| ≤ 1) ∧
      ∀ t, ∫⁻ ω, ‖Z t ω - Y t ω‖ₑ ^ 2 ∂P ≤ ENNReal.ofReal (4 * δ) := by
  classical
  obtain ⟨κ, K, hKm, hKu, hκ, hD⟩ := exists_time_partition (P := P) hY hb δ hδ
  choose J hJ using fun t => (hKu t).exists
  have hJu : ∀ t j, t ∈ K j → J t = j := fun t j hj => (hKu t).unique (hJ t) hj
  have hJm : Measurable J := by
    refine measurable_to_countable' fun j => ?_
    have : J ⁻¹' {j} = K j := by
      ext t
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => h ▸ hJ t, fun h => hJu t j h⟩
    rw [this]; exact hKm j
  refine ⟨fun t ω => Y (κ (J t)) ω, ?_, fun t ω => hb _ ω, fun t => ?_⟩
  · intro i
    letI : MeasurableSpace (Set.Iic i × Ω) := Subtype.instMeasurableSpace.prod (ℱ i)
    have hG : ∀ j, Measurable[ℱ i] (fun ω => if κ j ≤ i then Y (κ j) ω else 0) := by
      intro j
      by_cases h : κ j ≤ i
      · simp only [h, if_true]
        exact (had (κ j)).mono (ℱ.mono h) le_rfl
      · simp only [h, if_false]; exact measurable_const
    have := @meas_comp_J (Set.Iic i) Ω _ (ℱ i) (fun p => J (p : ℝ))
      (hJm.comp measurable_subtype_coe) (fun j ω => if κ j ≤ i then Y (κ j) ω else 0) hG
    have e : (fun p : Set.Iic i × Ω => Y (κ (J (p.1 : ℝ))) p.2) =
        fun p => if κ (J (p.1 : ℝ)) ≤ i then Y (κ (J (p.1 : ℝ))) p.2 else 0 := by
      funext p
      have h1 : κ (J (p.1 : ℝ)) ≤ (p.1 : ℝ) := hκ _ _ (hJ _)
      simp only [(h1.trans p.1.2 : κ (J (p.1 : ℝ)) ≤ i), if_true]
    show Measurable fun p : Set.Iic i × Ω => Y (κ (J (p.1 : ℝ))) p.2
    rw [e]
    exact this
  · have := hD (J t) t (hJ t)
    rw [← lintegral_congr fun ω => by rw [enorm_sub_rev]] at this
    exact this

end Partition

section Final

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

lemma exists_progressive_modification_bdd {P : Measure Ω} [IsProbabilityMeasure P]
    {ℱ : Filtration ℝ mΩ} {Y : ℝ → Ω → ℝ} (hY : Measurable fun p : ℝ × Ω => Y p.1 p.2)
    (had : ∀ t, Measurable[ℱ t] (Y t)) (hb : ∀ t ω, |Y t ω| ≤ 1) :
    ∃ Z : ℝ → Ω → ℝ, IsProgressive ℱ Z ∧ ∀ t, Z t =ᵐ[P] Y t := by
  classical
  have hex : ∀ n : ℕ, ∃ Z : ℝ → Ω → ℝ, IsProgressive ℱ Z ∧ (∀ t ω, |Z t ω| ≤ 1) ∧
      ∀ t, ∫⁻ ω, ‖Z t ω - Y t ω‖ₑ ^ 2 ∂P ≤ ENNReal.ofReal (4 * (1 / 2 : ℝ) ^ n) :=
    fun n => exists_progressive_approx hY had hb _ (by positivity)
  choose Z hZp hZb hZ using hex
  have hZm : ∀ n t, Measurable (Z n t) := fun n t =>
    (isProgressive_measurable_uncurry (hZp n)).comp measurable_prodMk_left
  have hYm : ∀ t, Measurable (Y t) := fun t => hY.comp measurable_prodMk_left
  have hconv : ∀ t, ∀ᵐ ω ∂P, Tendsto (fun n => Z n t ω) atTop (𝓝 (Y t ω)) := by
    intro t
    have hsum : ∑' n, ∫⁻ ω, ‖Z n t ω - Y t ω‖ₑ ^ 2 ∂P ≠ ∞ := by
      refine ne_top_of_le_ne_top (b := ∑' n : ℕ, ENNReal.ofReal (4 * (1 / 2 : ℝ) ^ n)) ?_
        (ENNReal.tsum_le_tsum fun n => hZ n t)
      rw [← ENNReal.ofReal_tsum_of_nonneg (fun n => by positivity)
        ((summable_geometric_two).mul_left 4)]
      exact ENNReal.ofReal_ne_top
    have hmeas : ∀ n, Measurable fun ω => ‖Z n t ω - Y t ω‖ₑ ^ 2 := fun n =>
      (((hZm n t).sub (hYm t)).enorm).pow_const 2
    have h1 : ∫⁻ ω, ∑' n, ‖Z n t ω - Y t ω‖ₑ ^ 2 ∂P ≠ ∞ := by
      rw [lintegral_tsum (fun n => (hmeas n).aemeasurable)]
      exact hsum
    have h2 : ∀ᵐ ω ∂P, ∑' n, ‖Z n t ω - Y t ω‖ₑ ^ 2 < ∞ :=
      ae_lt_top (Measurable.ennreal_tsum hmeas) h1
    filter_upwards [h2] with ω hω
    have h3 := ENNReal.tendsto_atTop_zero_of_tsum_ne_top hω.ne
    have h4 : Tendsto (fun n => ‖Z n t ω - Y t ω‖ ^ 2) atTop (𝓝 0) := by
      have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h3
      simpa [Function.comp_def, ENNReal.toReal_pow] using this
    exact tendsto_iff_norm_sub_tendsto_zero.2 (tendsto_norm_of_sq h4)
  refine ⟨fun t ω => limsup (fun n => Z n t ω) atTop, ?_, fun t => ?_⟩
  · intro i
    exact Measurable.limsup (fun n => hZp n i)
  · filter_upwards [hconv t] with ω hω
    exact hω.limsup_eq

theorem exists_progressive_modification {P : Measure Ω} [IsProbabilityMeasure P]
    {ℱ : Filtration ℝ mΩ} {Y : ℝ → Ω → ℝ} (hY : Measurable fun p : ℝ × Ω => Y p.1 p.2)
    (had : ∀ t, Measurable[ℱ t] (Y t)) :
    ∃ Z : ℝ → Ω → ℝ, IsProgressive ℱ Z ∧ ∀ t, Z t =ᵐ[P] Y t := by
  set Y' : ℝ → Ω → ℝ := fun t ω => (2 / Real.pi) * Real.arctan (Y t ω) with hY'
  have hY'm : Measurable fun p : ℝ × Ω => Y' p.1 p.2 :=
    measurable_const.mul (Real.continuous_arctan.measurable.comp hY)
  have hY'a : ∀ t, Measurable[ℱ t] (Y' t) := fun t =>
    measurable_const.mul (Real.continuous_arctan.measurable.comp (had t))
  have hY'b : ∀ t ω, |Y' t ω| ≤ 1 := by
    intro t ω
    simp only [hY', abs_mul]
    have h1 : |Real.arctan (Y t ω)| ≤ Real.pi / 2 := by
      rw [abs_le]; exact ⟨(Real.neg_pi_div_two_lt_arctan _).le, (Real.arctan_lt_pi_div_two _).le⟩
    have hpi := Real.pi_pos
    rw [abs_of_pos (by positivity : (0 : ℝ) < 2 / Real.pi)]
    calc 2 / Real.pi * |Real.arctan (Y t ω)| ≤ 2 / Real.pi * (Real.pi / 2) :=
          mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = 1 := by field_simp
  obtain ⟨Z', hZ'p, hZ'⟩ := exists_progressive_modification_bdd (P := P) hY'm hY'a hY'b
  set G : ℝ → ℝ := fun x => if |x| < 1 then Real.tan (Real.pi / 2 * x) else 0 with hG
  have hGm : Measurable G := by
    refine Measurable.ite (measurableSet_lt (by fun_prop) measurable_const) ?_ measurable_const
    have : (fun x : ℝ => Real.tan (Real.pi / 2 * x)) = fun x => Real.sin (Real.pi / 2 * x) / Real.cos (Real.pi / 2 * x) := by
      funext x; exact Real.tan_eq_sin_div_cos _
    rw [this]
    exact (Real.continuous_sin.measurable.comp (measurable_const.mul measurable_id)).div
      (Real.continuous_cos.measurable.comp (measurable_const.mul measurable_id))
  refine ⟨fun t ω => G (Z' t ω), fun i => hGm.comp (hZ'p i), fun t => ?_⟩
  filter_upwards [hZ' t] with ω hω
  have hpi := Real.pi_pos
  have h1 : |Y' t ω| < 1 := by
    simp only [hY', abs_mul]
    have h1 : |Real.arctan (Y t ω)| < Real.pi / 2 := by
      rw [abs_lt]; exact ⟨Real.neg_pi_div_two_lt_arctan _, Real.arctan_lt_pi_div_two _⟩
    rw [abs_of_pos (by positivity : (0 : ℝ) < 2 / Real.pi)]
    calc 2 / Real.pi * |Real.arctan (Y t ω)| < 2 / Real.pi * (Real.pi / 2) :=
          mul_lt_mul_of_pos_left h1 (by positivity)
      _ = 1 := by field_simp
  show G (Z' t ω) = Y t ω
  rw [hω]
  simp only [hG, if_pos h1]
  have : Real.pi / 2 * Y' t ω = Real.arctan (Y t ω) := by
    simp only [hY']; field_simp
  rw [this, Real.tan_arctan]

end Final

end HRS.MRep
