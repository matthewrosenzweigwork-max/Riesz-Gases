section VarLimit

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- Centred Gaussians converging a.s. to `0` have variances tending to `0`. -/
theorem tendsto_var_of_gaussian_ae {Z : ℕ → Ω → ℝ} {v : ℕ → ℝ≥0} (hZ : ∀ n, Measurable (Z n))
    (hlaw : ∀ n, P.map (Z n) = gaussianReal 0 (v n))
    (hae : ∀ᵐ ω ∂P, Tendsto (fun n => Z n ω) atTop (𝓝 0)) :
    Tendsto (fun n => (v n : ℝ)) atTop (𝓝 0) := by
  have hcont : Continuous fun x : ℝ => Complex.exp (((1 : ℝ) : ℂ) * x * Complex.I) := by fun_prop
  have hDCT : Tendsto (fun n => ∫ ω, Complex.exp (((1 : ℝ) : ℂ) * Z n ω * Complex.I) ∂P) atTop
      (𝓝 (∫ _ω, Complex.exp (((1 : ℝ) : ℂ) * (0 : ℝ) * Complex.I) ∂P)) := by
    refine tendsto_integral_of_dominated_convergence (fun _ => 1) (fun n => ?_) (integrable_const _)
      (fun n => ?_) ?_
    · exact (hcont.measurable.comp (hZ n)).aestronglyMeasurable
    · refine Eventually.of_forall fun ω => ?_
      rw [Complex.norm_exp]
      simp
    · filter_upwards [hae] with ω hω
      exact (hcont.tendsto _).comp hω
  have hlhs : ∀ n, ∫ ω, Complex.exp (((1 : ℝ) : ℂ) * Z n ω * Complex.I) ∂P =
      Complex.exp (((-(v n : ℝ) / 2 : ℝ) : ℂ)) := by
    intro n
    rw [← charFun_map_eq_integral (Z n) (hZ n).aemeasurable 1, hlaw, charFun_gaussianReal]
    congr 1
    push_cast
    ring
  simp_rw [hlhs] at hDCT
  have h1 : Tendsto (fun n => Complex.exp (((-(v n : ℝ) / 2 : ℝ) : ℂ))) atTop (𝓝 1) := by
    simpa using hDCT
  have hre : Tendsto (fun n => Real.exp (-(v n : ℝ) / 2)) atTop (𝓝 1) := by
    have h2 := (Complex.continuous_re.tendsto _).comp h1
    simp only [Function.comp_def, Complex.exp_ofReal_re, Complex.one_re] at h2
    exact h2
  have hlog := (Real.continuousAt_log (one_ne_zero)).tendsto.comp hre
  simp only [Function.comp_def, Real.log_exp, Real.log_one] at hlog
  have := hlog.mul_const (-2 : ℝ)
  simpa [neg_div, mul_comm, mul_assoc] using this.congr fun n => by ring

end VarLimit


section Eta

open HRS HRS.Main HRS.Sec7

variable {d : ℕ}

/-- Index set `[0,∞) × (ℤ^d ∖ {0})` of the Fourier coefficients of a path. -/
abbrev KIdx (d : ℕ) := {t : ℝ // 0 ≤ t} × NonzeroLattice d

/-- The coefficient process `(t,k) ↦ η_t(e_k)`. -/
def etaCoef {Ω : Type} {r : ℝ} (η : ℝ → Ω → NegSobolev d r) (i : KIdx d) (ω : Ω) : ℝ :=
  NegSobolev.fourierCoeff (η i.1.1 ω) i.2

theorem eta_gaussFam (S : PreparedData d) (β₀ r : ℝ) {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (η : ℝ → Ω → NegSobolev d r)
    (hη : IsGaussianLimitField S.dyn S.ρ (withDensityReal S.ρ0) β₀ r P η) :
    GaussFam P (etaCoef η) := by
  refine ⟨fun i => ?_, fun p f => ?_, fun i => ?_⟩
  · obtain ⟨Y₀, -, hlin⟩ := hη
    exact (HRS.FieldSingAux.coordCLM r i.2).continuous.measurable.comp ((hlin 0).meas i.1.1)
  · exact (fdd_gaussian S β₀ r P η hη p (fun a => (f a).1.1) (fun a => (f a).2) (fun a => (f a).1.2)).1
  · have := (fdd_gaussian S β₀ r P η hη 1 (fun _ => i.1.1) (fun _ => i.2) (fun _ => i.1.2)).2 0
    exact this

theorem eta_cls_continuous (S : PreparedData d) (β₀ r : ℝ) {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (η : ℝ → Ω → NegSobolev d r)
    (hη : IsGaussianLimitField S.dyn S.ρ (withDensityReal S.ρ0) β₀ r P η) (k : NonzeroLattice d) :
    Continuous fun t : {t : ℝ // 0 ≤ t} => (eta_gaussFam S β₀ r P η hη).cls (t, k) := by
  classical
  set hF := eta_gaussFam S β₀ r P η hη with hFdef
  have hη' := hη
  obtain ⟨Y₀, -, hlin⟩ := hη'
  refine continuous_iff_seqContinuous.2 fun tn t htn => ?_
  rw [tendsto_iff_dist_tendsto_zero]
  choose v hv using fun n => hF.sub_gauss (tn n, k) (t, k)
  have hvn : ∀ n, dist (hF.cls (tn n, k)) (hF.cls (t, k)) ^ 2 = v n := by
    intro n
    have hz : ((hF.cls (tn n, k) - hF.cls (t, k) : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P]
        fun ω => etaCoef η (tn n, k) ω - etaCoef η (t, k) ω := by
      filter_upwards [Lp.coeFn_sub (hF.cls (tn n, k)) (hF.cls (t, k)),
        MemLp.coeFn_toLp (hF.memLp (tn n, k)), MemLp.coeFn_toLp (hF.memLp (t, k))] with ω h1 h2 h3
      rw [h1, Pi.sub_apply]
      have e2 : (⇑(hF.cls (tn n, k)) : Ω → ℝ) ω = etaCoef η (tn n, k) ω := h2
      have e3 : (⇑(hF.cls (t, k)) : Ω → ℝ) ω = etaCoef η (t, k) ω := h3
      rw [e2, e3]
    have hlaw : P.map ((hF.cls (tn n, k) - hF.cls (t, k) : Lp ℝ 2 P) : Ω → ℝ) = gaussianReal 0 (v n) := by
      rw [Measure.map_congr hz]; exact hv n
    rw [dist_eq_norm]
    exact lp_sqnorm_of_gaussian hlaw
  have hae : ∀ᵐ ω ∂P, Tendsto (fun n => etaCoef η (tn n, k) ω - etaCoef η (t, k) ω) atTop (𝓝 0) := by
    have htn' : Tendsto (fun n => (tn n).1) atTop (𝓝 t.1) := (continuous_subtype_val.tendsto t).comp htn
    have hev : ∀ᶠ n in atTop, (tn n).1 ∈ Set.Icc (0 : ℝ) (t.1 + 1) := by
      filter_upwards [htn'.eventually (Iic_mem_nhds (by linarith : t.1 < t.1 + 1))] with n hn
      exact ⟨(tn n).2, hn⟩
    filter_upwards [(hlin (t.1 + 1)).cont] with ω hω
    have hct : ContinuousWithinAt (fun s => η s ω) (Set.Icc 0 (t.1 + 1)) t.1 :=
      hω.continuousWithinAt ⟨t.2, by linarith⟩
    have h1 : Tendsto (fun n => η (tn n).1 ω) atTop (𝓝 (η t.1 ω)) :=
      hct.tendsto.comp (tendsto_nhdsWithin_iff.2 ⟨htn', hev⟩)
    have h2 := ((HRS.FieldSingAux.coordCLM r k).continuous.tendsto _).comp h1
    have h3 := h2.sub_const (NegSobolev.fourierCoeff (η t.1 ω) k)
    simpa [etaCoef, HRS.FieldSingAux.coordCLM_apply, Function.comp_def] using h3
  have hv0 := tendsto_var_of_gaussian_ae (P := P) (Z := fun n ω => etaCoef η (tn n, k) ω - etaCoef η (t, k) ω)
    (fun n => (hF.meas _).sub (hF.meas _)) hv hae
  have : ∀ n, dist (hF.cls (tn n, k)) (hF.cls (t, k)) = Real.sqrt (v n) := fun n => by
    rw [← hvn n, Real.sqrt_sq dist_nonneg]
  have key : Tendsto (fun n => Real.sqrt (v n)) atTop (𝓝 0) := by
    have h := (Real.continuous_sqrt.tendsto 0).comp hv0
    rw [Real.sqrt_zero] at h
    exact h
  exact key.congr fun n => (this n).symm

theorem eta_cls_linIndep (S : PreparedData d) (β₀ r : ℝ) (hβ₀ : 0 ≤ β₀) {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (η : ℝ → Ω → NegSobolev d r)
    (hη : IsGaussianLimitField S.dyn S.ρ (withDensityReal S.ρ0) β₀ r P η) :
    LinearIndependent ℝ fun k : NonzeroLattice d => (eta_gaussFam S β₀ r P η hη).cls (⟨0, le_rfl⟩, k) := by
  classical
  set hF := eta_gaussFam S β₀ r P η hη with hFdef
  have hη' := hη
  obtain ⟨Y₀, hcov, hlin⟩ := hη'
  have hae : η 0 =ᵐ[P] Y₀ := (hlin 0).init
  have hmeas0 : Measurable (η 0) := (hlin 0).meas 0
  have hY₀m : AEMeasurable Y₀ P := hmeas0.aemeasurable.congr hae
  obtain ⟨c, C, hc, hbd⟩ := HRS.StaticLimitsAux.comparable_of_susc S.hd S.hs0 S.hsd β₀ hβ₀ S.hρ0
  rw [linearIndependent_iff']
  intro s g hsum k hk
  -- the variance of the combination
  set Zs : Ω → ℝ := fun ω => ∑ i ∈ s, g i * NegSobolev.fourierCoeff (Y₀ ω) i with hZs
  have hzero : ∫ ω, Zs ω ^ 2 ∂P = 0 := by
    have h1 : ((∑ i ∈ s, g i • hF.cls (⟨0, le_rfl⟩, i) : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] 0 := by
      rw [hsum]; exact Lp.coeFn_zero _ _ _
    have h2 : ((∑ i ∈ s, g i • hF.cls (⟨0, le_rfl⟩, i) : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] Zs := by
      have h3 := Lp.coeFn_fun_finsetSum s (fun i => g i • hF.cls (⟨0, le_rfl⟩, i))
      have h4 : ∀ i, (⇑(g i • hF.cls (⟨0, le_rfl⟩, i)) : Ω → ℝ) =ᵐ[P]
          fun ω => g i * NegSobolev.fourierCoeff (Y₀ ω) i := fun i => by
        filter_upwards [Lp.coeFn_smul (g i) (hF.cls (⟨0, le_rfl⟩, i)),
          MemLp.coeFn_toLp (hF.memLp (⟨0, le_rfl⟩, i)), hae] with ω e1 e2 e3
        rw [e1, Pi.smul_apply, smul_eq_mul]
        have : (⇑(hF.cls (⟨0, le_rfl⟩, i)) : Ω → ℝ) ω = NegSobolev.fourierCoeff (η 0 ω) i := e2
        rw [this, e3]
      have h5 : ∀ᵐ ω ∂P, ∀ i ∈ s, (⇑(g i • hF.cls (⟨0, le_rfl⟩, i)) : Ω → ℝ) ω
          = g i * NegSobolev.fourierCoeff (Y₀ ω) i :=
        (ae_ball_iff s.countable_toSet).2 (fun i _ => h4 i)
      filter_upwards [h3, h5] with ω a b
      rw [a]
      exact Finset.sum_congr rfl fun i hi => b i hi
    have h6 : Zs =ᵐ[P] 0 := h2.symm.trans h1
    have : ∀ᵐ ω ∂P, Zs ω ^ 2 = 0 := by
      filter_upwards [h6] with ω hω
      rw [hω]; simp
    rw [integral_congr_ae this]; simp
  -- lower bound
  have hlow : c * ∑ i ∈ s, g i ^ 2 ≤ ∫ ω, Zs ω ^ 2 ∂P := by
    have hφ := HRS.FieldSingAux.isSmooth_trigPoly s g
    have hmean := HRS.FieldSingAux.mean_trigPoly s g
    have h1 := (hbd _ hφ hmean).1
    rw [HRS.FieldSingAux.integral_trigPoly_sq] at h1
    have h2 : susceptibilityCov (periodicRiesz d S.dyn.s) (withDensityReal S.ρ0) β₀
        (HRS.FieldSingAux.trigPoly s g) (HRS.FieldSingAux.trigPoly s g) =
        ∫ ω, Zs ω ^ 2 ∂P := by
      have hcl := (HRS.MC.Sec7.S7PIF4.S7PIF4_evalCLM r (HRS.A33.a33_ws_smooth r hφ)).continuous
      have hcm : Continuous fun F : NegSobolev d r => NegSobolev.eval F (HRS.FieldSingAux.trigPoly s g) *
          NegSobolev.eval F (HRS.FieldSingAux.trigPoly s g) := hcl.mul hcl
      rw [← hcov.2 _ _ hφ hφ, integral_map hY₀m hcm.aestronglyMeasurable]
      refine integral_congr_ae (Eventually.of_forall fun ω => ?_)
      simp only [HRS.FieldSingAux.eval_trigPoly, hZs]
      ring
    rw [← h2]
    exact h1
  have hnn : 0 ≤ ∑ i ∈ s, g i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hz : ∑ i ∈ s, g i ^ 2 = 0 := by
    have : c * ∑ i ∈ s, g i ^ 2 ≤ 0 := hzero ▸ hlow
    nlinarith
  have := (Finset.sum_eq_zero_iff_of_nonneg fun i _ => sq_nonneg (g i)).1 hz k hk
  exact pow_eq_zero_iff (two_ne_zero) |>.1 this

theorem eta_exists_xi (S : PreparedData d) (β₀ r : ℝ) (hβ₀ : 0 ≤ β₀) {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (η : ℝ → Ω → NegSobolev d r)
    (hη : IsGaussianLimitField S.dyn S.ρ (withDensityReal S.ρ0) β₀ r P η) :
    ∃ (ξ : ℕ → Ω → ℝ) (hm : ∀ i, Measurable (ξ i)) (hξ : IsStdGaussianSeq P ξ),
      ∀ t : ℝ, 0 ≤ t → ∀ k : NonzeroLattice d, InQ1 hξ hm (fun ω => NegSobolev.fourierCoeff (η t ω) k) := by
  classical
  set hF := eta_gaussFam S β₀ r P η hη with hFdef
  have hsep : TopologicalSpace.IsSeparable (Set.range hF.cls) := by
    have : Set.range hF.cls = ⋃ k : NonzeroLattice d, Set.range fun t : {t : ℝ // 0 ≤ t} => hF.cls (t, k) := by
      ext y
      constructor
      · rintro ⟨⟨t, k⟩, rfl⟩
        exact Set.mem_iUnion.2 ⟨k, t, rfl⟩
      · intro hy
        obtain ⟨k, t, rfl⟩ := Set.mem_iUnion.1 hy
        exact ⟨(t, k), rfl⟩
    rw [this]
    exact TopologicalSpace.IsSeparable.iUnion fun k =>
      TopologicalSpace.isSeparable_range (eta_cls_continuous S β₀ r P η hη k)
  have hinf : ¬ FiniteDimensional ℝ (Submodule.span ℝ (Set.range hF.cls)) := by
    intro hfin
    have hli := eta_cls_linIndep S β₀ r hβ₀ P η hη
    haveI : Infinite (NonzeroLattice d) :=
      Infinite.of_injective (HRS.FieldSingAux.kseq (by have := S.hd; omega)) 
        (HRS.FieldSingAux.kseq_injective (by have := S.hd; omega))
    let v : NonzeroLattice d → Submodule.span ℝ (Set.range hF.cls) := fun k =>
      ⟨hF.cls (⟨0, le_rfl⟩, k), Submodule.subset_span ⟨(⟨0, le_rfl⟩, k), rfl⟩⟩
    have hv : LinearIndependent ℝ v := by
      refine LinearIndependent.of_comp (Submodule.subtype _) ?_
      exact hli
    have := hv.finite
    exact not_finite (NonzeroLattice d)
  obtain ⟨ξ, hm, hξ, hall⟩ := hF.exists_xi hsep hinf
  exact ⟨ξ, hm, hξ, fun t ht k => hall (⟨t, ht⟩, k)⟩

end Eta

