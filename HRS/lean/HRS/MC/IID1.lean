import HRS.Prob.Gaussian

/-!
# Packet iid1: the Gaussian field generated by iid Gaussians through a factor

For an iid standard Gaussian sequence `g` and a matrix `S` whose Gram matrix `∑_k S_ik S_jk` converges to `Cm`,
the partial sums `∑_{k<n} S_ik g_k` converge in `L²` to a measurable `G_i`, and `(G_i)_{i<n}` is a centred
Gaussian vector with covariance `Cm` (`iid_field`).  The limit is a.e. unique (`iid_field_ae_unique`).
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal BigOperators

noncomputable section

namespace HRS.MC.IID

section Ortho

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {g : ℕ → Ω → ℝ}

lemma g_memLp (hg : IsStdGaussianSeq P g) (i : ℕ) : MemLp (g i) 2 P := by
  rw [memLp_two_iff_integrable_sq (hg.aemeasurable i).aestronglyMeasurable]
  exact gauss_pow_memLp hg i 2

lemma g_integral (hg : IsStdGaussianSeq P g) (i : ℕ) : ∫ ω, g i ω ∂P = 0 := by
  have h1 : ∫ ω, g i ω ∂P = ∫ x, x ∂(P.map (g i)) :=
    (integral_map (f := fun x : ℝ => x) (hg.aemeasurable i) aestronglyMeasurable_id).symm
  rw [h1, show P.map (g i) = gaussianReal 0 1 from hg.2 i, integral_id_gaussianReal]

lemma g_integral_mul (hg : IsStdGaussianSeq P g) (i j : ℕ) :
    ∫ ω, g i ω * g j ω ∂P = if i = j then 1 else 0 := by
  by_cases hij : i = j
  · subst hij
    simp only [ite_true]
    have h1 : ∫ ω, g i ω * g i ω ∂P = ∫ x, x ^ 2 ∂(P.map (g i)) := by
      rw [integral_map (hg.aemeasurable i) (by fun_prop)]
      simp [sq]
    rw [h1, show P.map (g i) = gaussianReal 0 1 from hg.2 i, gauss_sq]
  · simp only [hij, ite_false]
    have hind : IndepFun (g i) (g j) P := hg.1.indepFun hij
    have h := hind.integral_mul_eq_mul_integral (hg.aemeasurable i).aestronglyMeasurable
      (hg.aemeasurable j).aestronglyMeasurable
    simp only [Pi.mul_apply] at h
    rw [h, g_integral hg, zero_mul]

lemma memLp_lin (hg : IsStdGaussianSeq P g) (a : ℕ → ℝ) (s : Finset ℕ) :
    MemLp (fun ω => ∑ k ∈ s, a k * g k ω) 2 P :=
  memLp_finset_sum s fun k _ => (g_memLp hg k).const_mul (a k)

lemma integral_sq_lin (hg : IsStdGaussianSeq P g) (a : ℕ → ℝ) (s : Finset ℕ) :
    ∫ ω, (∑ k ∈ s, a k * g k ω) ^ 2 ∂P = ∑ k ∈ s, a k ^ 2 := by
  have hint : ∀ k ∈ s, ∀ l ∈ s, Integrable (fun ω => a k * a l * (g k ω * g l ω)) P := fun k _ l _ =>
    (((g_memLp hg k).integrable_mul (g_memLp hg l))).const_mul _
  have e : ∀ ω, (∑ k ∈ s, a k * g k ω) ^ 2 = ∑ k ∈ s, ∑ l ∈ s, a k * a l * (g k ω * g l ω) := by
    intro ω
    rw [sq, Finset.sum_mul_sum]
    exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => by ring
  simp_rw [e]
  rw [integral_finset_sum _ (fun k hk => integrable_finset_sum _ fun l hl => hint k hk l hl)]
  refine Finset.sum_congr rfl fun k hk => ?_
  rw [integral_finset_sum _ (fun l hl => hint k hk l hl)]
  simp_rw [integral_const_mul, g_integral_mul hg]
  simp [Finset.sum_ite_eq, hk, sq]

end Ortho

section Limit

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- A Cauchy sequence in `L²` has a measurable `L²` limit. -/
lemma exists_measurable_L2_limit {F : ℕ → Ω → ℝ} (hF : ∀ n, MemLp (F n) 2 P)
    (hc : ∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, ∫ ω, (F n ω - F m ω) ^ 2 ∂P < ε) :
    ∃ G : Ω → ℝ, Measurable G ∧ MemLp G 2 P ∧
      Tendsto (fun n => ∫ ω, (F n ω - G ω) ^ 2 ∂P) atTop (𝓝 0) := by
  set q : ℕ → Lp ℝ 2 P := fun n => (hF n).toLp (F n) with hq
  have hdist : ∀ m n, dist (q n) (q m) ^ 2 = ∫ ω, (F n ω - F m ω) ^ 2 ∂P := by
    intro m n
    rw [dist_eq_norm, Lp2_norm_sq]
    refine integral_congr_ae ?_
    have h1 := Lp.coeFn_sub (q n) (q m)
    have h2 := (hF n).coeFn_toLp
    have h3 := (hF m).coeFn_toLp
    filter_upwards [h1, h2, h3] with ω h1 h2 h3
    simp only [hq] at h1 h2 h3 ⊢
    rw [h1]; simp only [Pi.sub_apply]; rw [h2, h3]
  have hcau : CauchySeq q := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := hc (ε ^ 2) (by positivity)
    refine ⟨N, fun m hm n hn => ?_⟩
    have hb : dist (q m) (q n) ^ 2 < ε ^ 2 := by
      rw [dist_comm, hdist m n]; exact hN m hm n hn
    exact lt_of_pow_lt_pow_left₀ 2 hε.le hb
  obtain ⟨qlim, hqlim⟩ := cauchySeq_tendsto_of_complete hcau
  have hae : (Lp.aestronglyMeasurable qlim).mk qlim =ᵐ[P] qlim :=
    (Lp.aestronglyMeasurable qlim).ae_eq_mk.symm
  refine ⟨(Lp.aestronglyMeasurable qlim).mk qlim,
    (Lp.aestronglyMeasurable qlim).stronglyMeasurable_mk.measurable,
    (Lp.memLp qlim).ae_eq hae.symm, ?_⟩
  have hd : Tendsto (fun n => dist (q n) qlim ^ 2) atTop (𝓝 0) := by
    have := (tendsto_iff_dist_tendsto_zero.1 hqlim).pow 2
    simpa using this
  have hE : ∀ n, dist (q n) qlim ^ 2 =
      ∫ ω, (F n ω - (Lp.aestronglyMeasurable qlim).mk qlim ω) ^ 2 ∂P := by
    intro n
    rw [dist_eq_norm, Lp2_norm_sq]
    refine integral_congr_ae ?_
    have h1 := Lp.coeFn_sub (q n) qlim
    have h2 := (hF n).coeFn_toLp
    filter_upwards [h1, h2, hae] with ω h1 h2 h3
    simp only [hq] at h1 h2 ⊢
    rw [h1]; simp only [Pi.sub_apply]; rw [h2, h3]
  simpa [hE] using hd

end Limit


section Field

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {g : ℕ → Ω → ℝ}

/-- The partial sums `∑_{k<n} S_ik g_k`. -/
def pSum (S : ℕ → ℕ → ℝ) (g : ℕ → Ω → ℝ) (i n : ℕ) (ω : Ω) : ℝ :=
  ∑ k ∈ Finset.range n, S i k * g k ω

lemma memLp_pSum (hg : IsStdGaussianSeq P g) (S : ℕ → ℕ → ℝ) (i n : ℕ) :
    MemLp (pSum S g i n) 2 P := memLp_lin hg (S i) (Finset.range n)

lemma integral_pSum_diff (hg : IsStdGaussianSeq P g) (S : ℕ → ℕ → ℝ) (i : ℕ) {m n : ℕ} (hmn : m ≤ n) :
    ∫ ω, (pSum S g i n ω - pSum S g i m ω) ^ 2 ∂P =
      ∑ k ∈ Finset.range n, S i k ^ 2 - ∑ k ∈ Finset.range m, S i k ^ 2 := by
  have e : ∀ ω, pSum S g i n ω - pSum S g i m ω = ∑ k ∈ Finset.Ico m n, S i k * g k ω := by
    intro ω
    simp only [pSum]
    rw [Finset.sum_Ico_eq_sub _ hmn]
  simp_rw [e]
  rw [integral_sq_lin hg (S i) (Finset.Ico m n), Finset.sum_Ico_eq_sub _ hmn]

/-- The `L²` limits of the partial sums, as measurable functions. -/
lemma exists_field (hg : IsStdGaussianSeq P g) (S : ℕ → ℕ → ℝ)
    (hS2 : ∀ i, Summable fun k => S i k ^ 2) :
    ∃ G : ℕ → Ω → ℝ, (∀ i, Measurable (G i)) ∧ (∀ i, MemLp (G i) 2 P) ∧
      ∀ i, Tendsto (fun n => ∫ ω, (pSum S g i n ω - G i ω) ^ 2 ∂P) atTop (𝓝 0) := by
  have h : ∀ i, ∃ G : Ω → ℝ, Measurable G ∧ MemLp G 2 P ∧
      Tendsto (fun n => ∫ ω, (pSum S g i n ω - G ω) ^ 2 ∂P) atTop (𝓝 0) := by
    intro i
    refine exists_measurable_L2_limit (memLp_pSum hg S i) fun ε hε => ?_
    have hcs := ((hS2 i).hasSum.tendsto_sum_nat).cauchySeq
    rw [Metric.cauchySeq_iff] at hcs
    obtain ⟨N, hN⟩ := hcs ε hε
    refine ⟨N, fun m hm n hn => ?_⟩
    have := hN n hn m hm
    rw [Real.dist_eq] at this
    rcases le_total m n with hmn | hmn
    · rw [integral_pSum_diff hg S i hmn]
      exact lt_of_le_of_lt (le_abs_self _) this
    · have e : ∫ ω, (pSum S g i n ω - pSum S g i m ω) ^ 2 ∂P =
          ∫ ω, (pSum S g i m ω - pSum S g i n ω) ^ 2 ∂P := by
        congr 1; ext ω; ring
      rw [e, integral_pSum_diff hg S i hmn]
      exact lt_of_le_of_lt (neg_le_abs _ |>.trans_eq' (by ring)) this
  choose G hGm hGL hGt using h
  exact ⟨G, hGm, hGL, hGt⟩

end Field


section CharFun

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {g : ℕ → Ω → ℝ}

lemma integrable_cexp {f : Ω → ℝ} (hf : AEStronglyMeasurable f P) :
    Integrable (fun ω => Complex.exp (f ω * Complex.I)) P := by
  refine Integrable.mono' (integrable_const (1 : ℝ)) ?_ (Eventually.of_forall fun ω => ?_)
  · exact (Complex.continuous_exp.comp
      (Complex.continuous_ofReal.mul continuous_const)).comp_aestronglyMeasurable hf
  · rw [Complex.norm_exp_ofReal_mul_I]

lemma norm_cexp_sub_le (a b : ℝ) :
    ‖Complex.exp (a * Complex.I) - Complex.exp (b * Complex.I)‖ ≤ |a - b| := by
  have h : Complex.exp (a * Complex.I) - Complex.exp (b * Complex.I) =
      Complex.exp (b * Complex.I) * (Complex.exp (Complex.I * ((a - b : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, ← Complex.exp_add]
    push_cast
    ring_nf
  rw [h, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  simpa using Real.norm_exp_I_mul_ofReal_sub_one_le (x := a - b)

/-- `L²` convergence gives convergence of the characteristic integrals. -/
lemma tendsto_integral_cexp {Y : ℕ → Ω → ℝ} {Z : Ω → ℝ} (hY : ∀ m, MemLp (Y m) 2 P)
    (hZ : MemLp Z 2 P) (h : Tendsto (fun m => ∫ ω, (Y m ω - Z ω) ^ 2 ∂P) atTop (𝓝 0)) :
    Tendsto (fun m => ∫ ω, Complex.exp (Y m ω * Complex.I) ∂P) atTop
      (𝓝 (∫ ω, Complex.exp (Z ω * Complex.I) ∂P)) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.1 h) (ε ^ 2) (by positivity)
  refine ⟨N, fun m hm => ?_⟩
  have hd : MemLp (fun ω => Y m ω - Z ω) 2 P := (hY m).sub hZ
  have hsq : Integrable (fun ω => (Y m ω - Z ω) ^ 2) P := hd.integrable_sq
  have hI : ∫ ω, (Y m ω - Z ω) ^ 2 ∂P < ε ^ 2 := by
    have := hN m hm
    rw [Real.dist_eq, sub_zero] at this
    exact lt_of_le_of_lt (le_abs_self _) this
  rw [dist_eq_norm, ← integral_sub (integrable_cexp (hY m).aestronglyMeasurable)
    (integrable_cexp hZ.aestronglyMeasurable)]
  have habs : Integrable (fun ω => |Y m ω - Z ω|) P := (hd.integrable (by norm_num)).abs
  calc ‖∫ ω, (Complex.exp (Y m ω * Complex.I) - Complex.exp (Z ω * Complex.I)) ∂P‖
      ≤ ∫ ω, |Y m ω - Z ω| ∂P :=
        norm_integral_le_of_norm_le habs (Eventually.of_forall fun ω => norm_cexp_sub_le _ _)
    _ ≤ ∫ ω, (ε / 2 + (Y m ω - Z ω) ^ 2 / (2 * ε)) ∂P := by
        refine integral_mono habs ((integrable_const _).add (hsq.div_const _)) fun ω => ?_
        simp only
        have h2 : (Y m ω - Z ω) ^ 2 = |Y m ω - Z ω| ^ 2 := (sq_abs _).symm
        have h3 : ε / 2 + |Y m ω - Z ω| ^ 2 / (2 * ε) - |Y m ω - Z ω| =
            (|Y m ω - Z ω| - ε) ^ 2 / (2 * ε) := by
          field_simp
          ring
        have h4 : 0 ≤ (|Y m ω - Z ω| - ε) ^ 2 / (2 * ε) := by positivity
        rw [h2]
        linarith
    _ < ε := by
        rw [integral_add (integrable_const _) (hsq.div_const _), integral_const, integral_div]
        simp only [probReal_univ, one_smul]
        have : (∫ ω, (Y m ω - Z ω) ^ 2 ∂P) / (2 * ε) < ε / 2 := by
          rw [div_lt_iff₀ (by positivity)]; nlinarith
        linarith

lemma tendsto_L2_finsum {n : ℕ} (t : Fin n → ℝ) {F : Fin n → ℕ → Ω → ℝ} {H : Fin n → Ω → ℝ}
    (hF : ∀ i m, MemLp (F i m) 2 P) (hH : ∀ i, MemLp (H i) 2 P)
    (h : ∀ i, Tendsto (fun m => ∫ ω, (F i m ω - H i ω) ^ 2 ∂P) atTop (𝓝 0)) :
    Tendsto (fun m => ∫ ω, (∑ i, t i * F i m ω - ∑ i, t i * H i ω) ^ 2 ∂P) atTop (𝓝 0) := by
  have hd : ∀ i m, MemLp (fun ω => F i m ω - H i ω) 2 P := fun i m => (hF i m).sub (hH i)
  have hbound : Tendsto (fun m => (∑ i, t i ^ 2) * ∑ i, ∫ ω, (F i m ω - H i ω) ^ 2 ∂P) atTop (𝓝 0) := by
    have := (tendsto_finset_sum Finset.univ (fun i _ => h i)).const_mul (∑ i, t i ^ 2)
    simpa using this
  refine squeeze_zero (fun m => integral_nonneg fun ω => sq_nonneg _) (fun m => ?_) hbound
  have e : ∀ ω, ∑ i, t i * F i m ω - ∑ i, t i * H i ω = ∑ i, t i * (F i m ω - H i ω) := by
    intro ω; simp [mul_sub, Finset.sum_sub_distrib]
  simp_rw [e]
  have hint : ∀ i, Integrable (fun ω => (F i m ω - H i ω) ^ 2) P := fun i => (hd i m).integrable_sq
  have hlhs : Integrable (fun ω => (∑ i, t i * (F i m ω - H i ω)) ^ 2) P :=
    (memLp_finset_sum Finset.univ fun i _ => (hd i m).const_mul (t i)).integrable_sq
  rw [← integral_finset_sum _ (fun i _ => hint i), ← integral_const_mul]
  refine integral_mono hlhs ((integrable_finset_sum _ fun i _ => hint i).const_mul _) fun ω => ?_
  exact Finset.sum_mul_sq_le_sq_mul_sq Finset.univ t _


/-- The characteristic integral of a finite linear combination of the `g_k`. -/
lemma integral_cexp_lin (hg : IsStdGaussianSeq P g) (b : ℕ → ℝ) (m : ℕ) :
    ∫ ω, Complex.exp ((∑ k ∈ Finset.range m, b k * g k ω : ℝ) * Complex.I) ∂P =
      Complex.exp (-((∑ k ∈ Finset.range m, b k ^ 2 : ℝ) : ℂ) / 2) := by
  set Z : Ω → EuclideanSpace ℝ (Fin m) := fun ω => WithLp.toLp 2 (fun j : Fin m => g j ω) with hZ
  have hZm : AEMeasurable Z P := by
    have : AEMeasurable (fun ω (j : Fin m) => g j ω) P := aemeasurable_pi_iff.2 fun j => hg.aemeasurable j
    exact (by fun_prop : Measurable (WithLp.toLp 2 : (Fin m → ℝ) → EuclideanSpace ℝ (Fin m))).comp_aemeasurable this
  have hmap : P.map Z = stdGaussian (EuclideanSpace ℝ (Fin m)) := by
    have hZ' : Z = (WithLp.toLp 2 : (Fin m → ℝ) → EuclideanSpace ℝ (Fin m)) ∘ (fun ω (j : Fin m) => g j ω) := rfl
    have : AEMeasurable (fun ω (j : Fin m) => g j ω) P := aemeasurable_pi_iff.2 fun j => hg.aemeasurable j
    rw [hZ', ← AEMeasurable.map_map_of_aemeasurable
      (by fun_prop : Measurable (WithLp.toLp 2 : (Fin m → ℝ) → EuclideanSpace ℝ (Fin m))).aemeasurable this,
      law_vec hg m, map_pi_eq_stdGaussian]
  set bv : EuclideanSpace ℝ (Fin m) := WithLp.toLp 2 (fun j : Fin m => b j) with hbv
  have hinner : ∀ ω, ∑ k ∈ Finset.range m, b k * g k ω = inner ℝ (Z ω) bv := by
    intro ω
    rw [← Fin.sum_univ_eq_sum_range (fun k => b k * g k ω) m]
    simp [hZ, hbv, PiLp.inner_apply, mul_comm]
  have hch := charFun_stdGaussian (E := EuclideanSpace ℝ (Fin m)) bv
  rw [charFun_apply, ← hmap, integral_map hZm (by fun_prop)] at hch
  simp_rw [hinner]
  rw [hch]
  have hn : ‖bv‖ ^ 2 = ∑ k ∈ Finset.range m, b k ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq, ← Fin.sum_univ_eq_sum_range (fun k => b k ^ 2) m]
  congr 2
  rw [← Complex.ofReal_pow, hn]

end CharFun

section Main

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {g : ℕ → Ω → ℝ}

lemma quad_tendsto {S Cm : ℕ → ℕ → ℝ} (hS : ∀ i j, HasSum (fun k => S i k * S j k) (Cm i j))
    {n : ℕ} (t : Fin n → ℝ) :
    Tendsto (fun m => ∑ k ∈ Finset.range m, (∑ i : Fin n, t i * S i k) ^ 2) atTop
      (𝓝 (∑ i : Fin n, ∑ j : Fin n, t i * Cm i j * t j)) := by
  have e : ∀ m, ∑ k ∈ Finset.range m, (∑ i : Fin n, t i * S i k) ^ 2 =
      ∑ i : Fin n, ∑ j : Fin n, t i * t j * ∑ k ∈ Finset.range m, S i k * S j k := by
    intro m
    simp_rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => by ring
  simp_rw [e]
  refine tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ => ?_
  have := ((hS i j).tendsto_sum_nat).const_mul (t i * t j)
  convert this using 2
  ring

lemma posSemidef_cov {S Cm : ℕ → ℕ → ℝ} (hS : ∀ i j, HasSum (fun k => S i k * S j k) (Cm i j))
    (n : ℕ) : (Matrix.of fun i j : Fin n => Cm i j).PosSemidef := by
  refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ ?_
  · ext i j
    have : Cm j i = Cm i j := by
      refine (hS j i).unique ?_
      simpa [mul_comm] using hS i j
    simp [Matrix.conjTranspose_apply, this]
  · intro x
    have hq := quad_tendsto hS x
    have hnn : 0 ≤ ∑ i : Fin n, ∑ j : Fin n, x i * Cm i j * x j :=
      ge_of_tendsto' hq fun m => Finset.sum_nonneg fun k _ => sq_nonneg _
    convert hnn using 1
    simp [dotProduct, Matrix.mulVec, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring


lemma law_eq (hg : IsStdGaussianSeq P g) {S Cm : ℕ → ℕ → ℝ}
    (hS : ∀ i j, HasSum (fun k => S i k * S j k) (Cm i j)) {G : ℕ → Ω → ℝ}
    (hGm : ∀ i, Measurable (G i)) (hGL : ∀ i, MemLp (G i) 2 P)
    (hGt : ∀ i, Tendsto (fun n => ∫ ω, (pSum S g i n ω - G i ω) ^ 2 ∂P) atTop (𝓝 0)) (n : ℕ) :
    law P (fun ω => (WithLp.toLp 2 fun i : Fin n => G i ω : EuclideanSpace ℝ (Fin n))) =
      multivariateGaussian 0 (Matrix.of fun i j : Fin n => Cm i j) := by
  have hpsd := posSemidef_cov hS n
  have hXm : Measurable (fun ω => (WithLp.toLp 2 fun i : Fin n => G i ω : EuclideanSpace ℝ (Fin n))) :=
    (by fun_prop : Measurable (WithLp.toLp 2 : (Fin n → ℝ) → EuclideanSpace ℝ (Fin n))).comp
      (measurable_pi_iff.2 fun i => hGm i)
  refine Measure.ext_of_charFun ?_
  funext t
  rw [charFun_multivariateGaussian hpsd, charFun_apply, law, integral_map hXm.aemeasurable (by fun_prop)]
  set tv : Fin n → ℝ := fun i => t i with htv
  have hin : ∀ ω, inner ℝ (WithLp.toLp 2 fun i : Fin n => G i ω : EuclideanSpace ℝ (Fin n)) t =
      ∑ i : Fin n, tv i * G i ω := by
    intro ω; simp [PiLp.inner_apply, mul_comm, htv]
  simp_rw [hin]
  have hY := tendsto_integral_cexp (P := P)
    (Y := fun m ω => ∑ i : Fin n, tv i * pSum S g i m ω) (Z := fun ω => ∑ i : Fin n, tv i * G i ω)
    (fun m => memLp_finset_sum Finset.univ fun i _ => (memLp_pSum hg S i m).const_mul (tv i))
    (memLp_finset_sum Finset.univ fun i _ => (hGL i).const_mul (tv i))
    (tendsto_L2_finsum tv (F := fun (i : Fin n) m => pSum S g i m) (H := fun (i : Fin n) => G i)
      (fun i m => memLp_pSum hg S i m) (fun i => hGL i) (fun i => hGt i))
  have hlin : ∀ m ω, ∑ i : Fin n, tv i * pSum S g i m ω =
      ∑ k ∈ Finset.range m, (∑ i : Fin n, tv i * S i k) * g k ω := by
    intro m ω
    simp only [pSum, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun i _ => by ring
  have hq := quad_tendsto hS tv
  have hlim : Tendsto (fun m => Complex.exp (-((∑ k ∈ Finset.range m, (∑ i : Fin n, tv i * S i k) ^ 2 : ℝ) : ℂ) / 2))
      atTop (𝓝 (Complex.exp (-((∑ i : Fin n, ∑ j : Fin n, tv i * Cm i j * tv j : ℝ) : ℂ) / 2))) := by
    refine (Complex.continuous_exp.tendsto _).comp ?_
    exact ((Complex.continuous_ofReal.tendsto _).comp hq).neg.div_const _
  have hY' : Tendsto (fun m => Complex.exp (-((∑ k ∈ Finset.range m, (∑ i : Fin n, tv i * S i k) ^ 2 : ℝ) : ℂ) / 2))
      atTop (𝓝 (∫ ω, Complex.exp ((∑ i : Fin n, tv i * G i ω : ℝ) * Complex.I) ∂P)) := by
    refine hY.congr fun m => ?_
    simp_rw [hlin]
    exact integral_cexp_lin hg (fun k => ∑ i : Fin n, tv i * S i k) m
  rw [tendsto_nhds_unique hY' hlim]
  congr 1
  simp [dotProduct, Matrix.mulVec, Finset.mul_sum, htv]
  simp only [mul_assoc]
  ring

end Main

/-- The Gaussian field generated by an iid standard Gaussian sequence through a factor: the partial sums
`∑_{k<n} S_ik g_k` converge in `L²` to a measurable `G_i`, and `(G_i)_{i<n}` is centred Gaussian with
covariance `Cm` (the Gram limit of `S`). -/
theorem iid_field {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (g : ℕ → Ω → ℝ) (hg : IsStdGaussianSeq P g) (S Cm : ℕ → ℕ → ℝ)
    (hS : ∀ i j, HasSum (fun k => S i k * S j k) (Cm i j)) :
    ∃ G : ℕ → Ω → ℝ, (∀ i, Measurable (G i)) ∧
      (∀ i, TendstoL2 P (fun n ω => ∑ k ∈ Finset.range n, S i k * g k ω) (G i)) ∧
      ∀ n : ℕ, law P (fun ω => (WithLp.toLp 2 fun i : Fin n => G i ω : EuclideanSpace ℝ (Fin n))) =
        multivariateGaussian 0 (Matrix.of fun i j : Fin n => Cm i j) := by
  have hS2 : ∀ i, Summable fun k => S i k ^ 2 := fun i =>
    (hS i i).summable.congr fun k => (sq _).symm
  obtain ⟨G, hGm, hGL, hGt⟩ := exists_field hg S hS2
  exact ⟨G, hGm, fun i => tendstoL2_of_memLp (Qn := pSum S g i) (hGL i) (memLp_pSum hg S i) (hGt i),
    fun n => law_eq hg hS hGm hGL hGt n⟩

/-- Two `L²` limits of the partial sums agree almost everywhere. -/
theorem iid_field_ae_unique {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (g : ℕ → Ω → ℝ) (hg : IsStdGaussianSeq P g) (S : ℕ → ℕ → ℝ) (i : ℕ) {Q Q' : Ω → ℝ}
    (h : TendstoL2 P (fun n ω => ∑ k ∈ Finset.range n, S i k * g k ω) Q)
    (h' : TendstoL2 P (fun n ω => ∑ k ∈ Finset.range n, S i k * g k ω) Q') : Q =ᵐ[P] Q' :=
  TendstoL2.ae_unique (fun n => (memLp_pSum hg S i n).aestronglyMeasurable) h h'

end HRS.MC.IID
