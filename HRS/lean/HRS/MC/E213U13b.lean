import HRS.MC.E213U13a
open MeasureTheory ProbabilityTheory Filter Topology HRS
open scoped ENNReal

set_option linter.unusedSectionVars false

noncomputable section

namespace HRS.MC.E213U13

section Gen

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- The σ-algebra generated by `ξ_0, …, ξ_{n-1}`. -/
def sig (ξ : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (i : Finset.range n) => ξ i ω) inferInstance

theorem sig_le {ξ : ℕ → Ω → ℝ} (hm : ∀ i, Measurable (ξ i)) (n : ℕ) : sig ξ n ≤ mΩ := by
  have : Measurable (fun ω (i : Finset.range n) => ξ i ω) := measurable_pi_iff.2 (fun i => hm i)
  exact this.comap_le

theorem measurable_sig {ξ : ℕ → Ω → ℝ} {n i : ℕ} (hi : i < n) : Measurable[sig ξ n] (ξ i) := by
  have h : Measurable[sig ξ n] (fun ω (j : Finset.range n) => ξ j ω) := comap_measurable _
  exact (measurable_pi_apply (⟨i, Finset.mem_range.2 hi⟩ : Finset.range n)).comp h

theorem indep_sig {ξ : ℕ → Ω → ℝ} (hξ : iIndepFun ξ P) (hm : ∀ i, Measurable (ξ i)) (n : ℕ)
    (T : Finset ℕ) (hT : Disjoint (Finset.range n) T) :
    Indep (sig ξ n) (MeasurableSpace.comap (fun ω (i : T) => ξ i ω) inferInstance) P :=
  hξ.indepFun_finset (Finset.range n) T hT hm


variable {ξ : ℕ → Ω → ℝ}

theorem memLp_xi (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (i : ℕ) : MemLp (ξ i) 2 P := by
  rw [memLp_two_iff_integrable_sq (hm i).aestronglyMeasurable]
  exact gauss_pow_memLp hξ i 2

theorem integral_xi (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (i : ℕ) : ∫ ω, ξ i ω ∂P = 0 := by
  have h1 : ∫ ω, ξ i ω ∂P = ∫ x, x ∂(P.map (ξ i)) := by
    exact (integral_map (f := fun x : ℝ => x) (hm i).aemeasurable aestronglyMeasurable_id).symm
  have h2 : P.map (ξ i) = gaussianReal 0 1 := hξ.2 i
  rw [h1, h2, integral_id_gaussianReal]

theorem integral_xi_mul (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (i j : ℕ) :
    ∫ ω, ξ i ω * ξ j ω ∂P = if i = j then 1 else 0 := by
  by_cases hij : i = j
  · subst hij
    simp only [ite_true]
    have h1 : ∫ ω, ξ i ω * ξ i ω ∂P = ∫ x, x ^ 2 ∂(P.map (ξ i)) := by
      rw [integral_map (hm i).aemeasurable (by fun_prop)]
      simp [sq]
    rw [h1, show P.map (ξ i) = gaussianReal 0 1 from hξ.2 i, gauss_sq]
  · simp only [hij, ite_false]
    have hind : IndepFun (ξ i) (ξ j) P := hξ.1.indepFun hij
    have h := hind.integral_mul_eq_mul_integral (hm i).aestronglyMeasurable (hm j).aestronglyMeasurable
    simp only [Pi.mul_apply] at h
    rw [h, integral_xi hξ hm, zero_mul]


theorem condExp_vec_const (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (k : ℕ) (T : Finset ℕ)
    (hT : Disjoint (Finset.range k) T) (F : (T → ℝ) → ℝ) (hF : Measurable F) :
    P[fun ω => F (fun i : T => ξ i ω) | sig ξ k] =ᵐ[P] fun _ => ∫ ω, F (fun i : T => ξ i ω) ∂P := by
  have hvec : Measurable (fun ω (i : T) => ξ i ω) := measurable_pi_iff.2 (fun i => hm i)
  have hle1 : MeasurableSpace.comap (fun ω (i : T) => ξ i ω) inferInstance ≤ mΩ := hvec.comap_le
  have hsm : StronglyMeasurable[MeasurableSpace.comap (fun ω (i : T) => ξ i ω) inferInstance]
      (fun ω => F (fun i : T => ξ i ω)) := (hF.comp (comap_measurable _)).stronglyMeasurable
  exact condExp_indep_eq hle1 (sig_le hm k) hsm (indep_sig hξ.1 hm k T hT).symm

theorem condExp_xi_lt (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i : ℕ} (hi : i < k) :
    P[ξ i | sig ξ k] = ξ i :=
  condExp_of_stronglyMeasurable (sig_le hm k) (measurable_sig hi).stronglyMeasurable
    ((memLp_xi hξ hm i).integrable (by norm_num))

theorem condExp_xi_ge (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i : ℕ} (hi : k ≤ i) :
    P[ξ i | sig ξ k] =ᵐ[P] fun _ => 0 := by
  have hT : Disjoint (Finset.range k) ({i} : Finset ℕ) := by
    simp [Finset.disjoint_singleton_right, hi]
  have := condExp_vec_const hξ hm k {i} hT (fun z => z ⟨i, Finset.mem_singleton_self i⟩)
    (measurable_pi_apply _)
  simpa [integral_xi hξ hm] using this

theorem condExp_term_lt (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i j : ℕ} (hi : i < k)
    (hj : j < k) :
    P[fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 | sig ξ k] = fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 := by
  refine condExp_of_stronglyMeasurable (sig_le hm k) ?_ ((memLp_term hξ i j).integrable (by norm_num))
  exact (((measurable_sig hi).mul (measurable_sig hj)).sub measurable_const).stronglyMeasurable

theorem condExp_term_ge (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i j : ℕ} (hi : k ≤ i)
    (hj : k ≤ j) :
    P[fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 | sig ξ k] =ᵐ[P] fun _ => 0 := by
  classical
  have hT : Disjoint (Finset.range k) ({i, j} : Finset ℕ) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_range] at hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx'
    rcases hx' with rfl | rfl <;> omega
  have := condExp_vec_const hξ hm k {i, j} hT (fun z => z ⟨i, by simp⟩ * z ⟨j, by simp⟩ - if i = j then 1 else 0)
    (by fun_prop)
  have hprod : Integrable (fun ω => ξ i ω * ξ j ω) P :=
    (memLp_xi hξ hm i).integrable_mul (memLp_xi hξ hm j)
  have hint : ∫ ω, (ξ i ω * ξ j ω - if i = j then 1 else 0) ∂P = 0 := by
    rw [integral_sub hprod (integrable_const _), integral_xi_mul hξ hm]
    simp
  simpa [hint] using this


theorem condExp_term_mixed (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i j : ℕ} (hi : i < k)
    (hj : k ≤ j) :
    P[fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 | sig ξ k] =ᵐ[P] fun _ => 0 := by
  have hij : i ≠ j := by omega
  have e : (fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0) = ξ i * ξ j := by
    funext ω; simp [hij]
  rw [e]
  have hprod : Integrable (ξ i * ξ j) P := (memLp_xi hξ hm i).integrable_mul (memLp_xi hξ hm j)
  have h := condExp_mul_of_stronglyMeasurable_left (m := sig ξ k) (μ := P) (f := ξ i) (g := ξ j)
    (measurable_sig hi).stronglyMeasurable hprod ((memLp_xi hξ hm j).integrable (by norm_num))
  filter_upwards [h, condExp_xi_ge hξ hm hj] with ω h1 h2
  simp [h1, h2]

theorem condExp_term_mixed' (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {k i j : ℕ} (hi : k ≤ i)
    (hj : j < k) :
    P[fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 | sig ξ k] =ᵐ[P] fun _ => 0 := by
  have e : (fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0) =
      fun ω => ξ j ω * ξ i ω - if j = i then 1 else 0 := by
    funext ω; simp only [mul_comm, eq_comm]
  rw [e]
  exact condExp_term_mixed hξ hm hj hi

/-- The class of `ξ_i` in `L²`. -/
def g1 (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (i : ℕ) : Lp ℝ 2 P :=
  (memLp_xi hξ hm i).toLp (ξ i)

/-- The class of `ξ_iξ_j - δ_ij` in `L²`. -/
def g2 (hξ : IsStdGaussianSeq P ξ) (i j : ℕ) : Lp ℝ 2 P :=
  (memLp_term hξ i j).toLp (fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0)

/-- Linear polynomials of degree `< n` in the `ξ_i`. -/
def K1 (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n : ℕ) : Submodule ℝ (Lp ℝ 2 P) :=
  Submodule.span ℝ (Set.range fun i : Fin n => g1 hξ hm i)

/-- Centred quadratic Wick polynomials in `ξ_0, …, ξ_{n-1}`. -/
def K2 (hξ : IsStdGaussianSeq P ξ) (n : ℕ) : Submodule ℝ (Lp ℝ 2 P) :=
  Submodule.span ℝ (Set.range fun p : Fin n × Fin n => g2 hξ p.1 p.2)

instance (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n : ℕ) : FiniteDimensional ℝ (K1 hξ hm n) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

instance (hξ : IsStdGaussianSeq P ξ) (n : ℕ) : FiniteDimensional ℝ (K2 hξ n) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

theorem K1_mono (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) : Monotone (K1 hξ hm) := by
  intro n n' h
  refine Submodule.span_mono ?_
  rintro _ ⟨i, rfl⟩
  exact ⟨⟨i, lt_of_lt_of_le i.2 h⟩, rfl⟩

theorem K2_mono (hξ : IsStdGaussianSeq P ξ) : Monotone (K2 hξ) := by
  intro n n' h
  refine Submodule.span_mono ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact ⟨(⟨i, lt_of_lt_of_le i.2 h⟩, ⟨j, lt_of_lt_of_le j.2 h⟩), rfl⟩


theorem span_condExp {S : Set (Lp ℝ 2 P)} {K' : Submodule ℝ (Lp ℝ 2 P)} {m : MeasurableSpace Ω}
    (h : ∀ x ∈ S, ∃ y ∈ K', P[(x : Ω → ℝ) | m] =ᵐ[P] (y : Ω → ℝ)) :
    ∀ x ∈ Submodule.span ℝ S, ∃ y ∈ K', P[(x : Ω → ℝ) | m] =ᵐ[P] (y : Ω → ℝ) := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero =>
    refine ⟨0, K'.zero_mem, ?_⟩
    have h0 : ((0 : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] 0 := Lp.coeFn_zero ℝ 2 P
    refine (condExp_congr_ae h0).trans ?_
    have hz : P[(fun _ => 0 : Ω → ℝ) | m] = 0 := condExp_zero
    exact (Filter.EventuallyEq.of_eq hz).trans (Lp.coeFn_zero ℝ 2 P).symm
  | add x y _ _ hx hy =>
    obtain ⟨x', hx', hxe⟩ := hx
    obtain ⟨y', hy', hye⟩ := hy
    refine ⟨x' + y', K'.add_mem hx' hy', ?_⟩
    have i1 : Integrable (x : Ω → ℝ) P := (Lp.memLp x).integrable (by norm_num)
    have i2 : Integrable (y : Ω → ℝ) P := (Lp.memLp y).integrable (by norm_num)
    have e1 : ((x + y : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] (x : Ω → ℝ) + (y : Ω → ℝ) := Lp.coeFn_add x y
    refine (condExp_congr_ae e1).trans ?_
    refine (condExp_add i1 i2 m).trans ?_
    filter_upwards [hxe, hye, Lp.coeFn_add x' y'] with ω h1 h2 h3
    simp only [Pi.add_apply, h1, h2]
    exact h3.symm
  | smul c x _ hx =>
    obtain ⟨x', hx', hxe⟩ := hx
    refine ⟨c • x', K'.smul_mem c hx', ?_⟩
    have e1 : ((c • x : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] c • (x : Ω → ℝ) := Lp.coeFn_smul c x
    refine (condExp_congr_ae e1).trans ?_
    refine (condExp_smul c (x : Ω → ℝ) m).trans ?_
    filter_upwards [hxe, Lp.coeFn_smul c x'] with ω h1 h2
    simp only [Pi.smul_apply, h1]
    exact h2.symm

theorem span_condExp_self {S : Set (Lp ℝ 2 P)} {m : MeasurableSpace Ω}
    (h : ∀ x ∈ S, P[(x : Ω → ℝ) | m] =ᵐ[P] (x : Ω → ℝ)) :
    ∀ x ∈ Submodule.span ℝ S, P[(x : Ω → ℝ) | m] =ᵐ[P] (x : Ω → ℝ) := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero =>
    have h0 : ((0 : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] 0 := Lp.coeFn_zero ℝ 2 P
    refine (condExp_congr_ae h0).trans ?_
    have hz : P[(fun _ => 0 : Ω → ℝ) | m] = 0 := condExp_zero
    exact (Filter.EventuallyEq.of_eq hz).trans h0.symm
  | add x y _ _ hx hy =>
    have i1 : Integrable (x : Ω → ℝ) P := (Lp.memLp x).integrable (by norm_num)
    have i2 : Integrable (y : Ω → ℝ) P := (Lp.memLp y).integrable (by norm_num)
    have e1 : ((x + y : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] (x : Ω → ℝ) + (y : Ω → ℝ) := Lp.coeFn_add x y
    refine (condExp_congr_ae e1).trans ?_
    refine (condExp_add i1 i2 m).trans ?_
    filter_upwards [hx, hy, Lp.coeFn_add x y] with ω h1 h2 h3
    simp only [Pi.add_apply, h1, h2]
    exact h3.symm
  | smul c x _ hx =>
    have e1 : ((c • x : Lp ℝ 2 P) : Ω → ℝ) =ᵐ[P] c • (x : Ω → ℝ) := Lp.coeFn_smul c x
    refine (condExp_congr_ae e1).trans ?_
    refine (condExp_smul c (x : Ω → ℝ) m).trans ?_
    filter_upwards [hx, Lp.coeFn_smul c x] with ω h1 h2
    simp only [Pi.smul_apply, h1]
    exact h2.symm


theorem coe_g1 (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (i : ℕ) :
    (g1 hξ hm i : Ω → ℝ) =ᵐ[P] ξ i := MemLp.coeFn_toLp _

theorem coe_g2 (hξ : IsStdGaussianSeq P ξ) (i j : ℕ) :
    (g2 hξ i j : Ω → ℝ) =ᵐ[P] fun ω => ξ i ω * ξ j ω - if i = j then 1 else 0 := MemLp.coeFn_toLp _

theorem K1_hmem (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n k : ℕ) :
    ∀ x ∈ K1 hξ hm n, ∃ y ∈ K1 hξ hm k, P[(x : Ω → ℝ) | sig ξ k] =ᵐ[P] (y : Ω → ℝ) := by
  refine span_condExp ?_
  rintro _ ⟨i, rfl⟩
  by_cases hik : (i : ℕ) < k
  · refine ⟨g1 hξ hm i, Submodule.subset_span ⟨⟨i, hik⟩, rfl⟩, ?_⟩
    refine (condExp_congr_ae (coe_g1 hξ hm i)).trans ?_
    rw [condExp_xi_lt hξ hm hik]
    exact (coe_g1 hξ hm i).symm
  · refine ⟨0, Submodule.zero_mem _, ?_⟩
    refine (condExp_congr_ae (coe_g1 hξ hm i)).trans ?_
    exact (condExp_xi_ge hξ hm (not_lt.1 hik)).trans (Lp.coeFn_zero ℝ 2 P).symm

theorem K1_hself (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n : ℕ) :
    ∀ x ∈ K1 hξ hm n, ∀ k, n ≤ k → P[(x : Ω → ℝ) | sig ξ k] =ᵐ[P] (x : Ω → ℝ) := by
  intro x hx k hk
  revert x
  refine span_condExp_self ?_
  rintro _ ⟨i, rfl⟩
  have hik : (i : ℕ) < k := lt_of_lt_of_le i.2 hk
  refine (condExp_congr_ae (coe_g1 hξ hm i)).trans ?_
  rw [condExp_xi_lt hξ hm hik]
  exact (coe_g1 hξ hm i).symm

theorem K2_hmem (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n k : ℕ) :
    ∀ x ∈ K2 hξ n, ∃ y ∈ K2 hξ k, P[(x : Ω → ℝ) | sig ξ k] =ᵐ[P] (y : Ω → ℝ) := by
  refine span_condExp ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  by_cases hik : (i : ℕ) < k
  · by_cases hjk : (j : ℕ) < k
    · refine ⟨g2 hξ i j, Submodule.subset_span ⟨(⟨i, hik⟩, ⟨j, hjk⟩), rfl⟩, ?_⟩
      refine (condExp_congr_ae (coe_g2 hξ i j)).trans ?_
      rw [condExp_term_lt hξ hm hik hjk]
      exact (coe_g2 hξ i j).symm
    · refine ⟨0, Submodule.zero_mem _, ?_⟩
      refine (condExp_congr_ae (coe_g2 hξ i j)).trans ?_
      exact (condExp_term_mixed hξ hm hik (not_lt.1 hjk)).trans (Lp.coeFn_zero ℝ 2 P).symm
  · refine ⟨0, Submodule.zero_mem _, ?_⟩
    refine (condExp_congr_ae (coe_g2 hξ i j)).trans ?_
    by_cases hjk : (j : ℕ) < k
    · exact (condExp_term_mixed' hξ hm (not_lt.1 hik) hjk).trans (Lp.coeFn_zero ℝ 2 P).symm
    · exact (condExp_term_ge hξ hm (not_lt.1 hik) (not_lt.1 hjk)).trans (Lp.coeFn_zero ℝ 2 P).symm

theorem K2_hself (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) (n : ℕ) :
    ∀ x ∈ K2 hξ n, ∀ k, n ≤ k → P[(x : Ω → ℝ) | sig ξ k] =ᵐ[P] (x : Ω → ℝ) := by
  intro x hx k hk
  revert x
  refine span_condExp_self ?_
  rintro _ ⟨⟨i, j⟩, rfl⟩
  have hik : (i : ℕ) < k := lt_of_lt_of_le i.2 hk
  have hjk : (j : ℕ) < k := lt_of_lt_of_le j.2 hk
  refine (condExp_congr_ae (coe_g2 hξ i j)).trans ?_
  rw [condExp_term_lt hξ hm hik hjk]
  exact (coe_g2 hξ i j).symm


theorem K1_poly (hξ : IsStdGaussianSeq P ξ) (hm : ∀ i, Measurable (ξ i)) {n : ℕ} :
    ∀ x ∈ K1 hξ hm n, ∃ a : ℕ → ℝ, (x : Ω → ℝ) =ᵐ[P] fun ω => ∑ i ∈ Finset.range n, ξ i ω • a i := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    refine ⟨fun j => if j = (i : ℕ) then 1 else 0, ?_⟩
    refine (coe_g1 hξ hm i).trans (Filter.Eventually.of_forall fun ω => ?_)
    simp [Finset.sum_ite_eq', i.2]
  | zero =>
    refine ⟨0, ?_⟩
    filter_upwards [Lp.coeFn_zero ℝ 2 P] with ω h
    simp [h]
  | add x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    refine ⟨a + b, ?_⟩
    filter_upwards [ha, hb, Lp.coeFn_add x y] with ω h1 h2 h3
    rw [h3, Pi.add_apply, h1, h2]
    simp only [Pi.add_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
  | smul c x _ hx =>
    obtain ⟨a, ha⟩ := hx
    refine ⟨c • a, ?_⟩
    filter_upwards [ha, Lp.coeFn_smul c x] with ω h1 h2
    rw [h2, Pi.smul_apply, h1, smul_eq_mul]
    simp [Finset.mul_sum, mul_left_comm]

theorem K2_poly (hξ : IsStdGaussianSeq P ξ) {n : ℕ} :
    ∀ x ∈ K2 hξ n, ∃ A : ℕ → ℕ → ℝ, (x : Ω → ℝ) =ᵐ[P] fun ω =>
      ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range n,
        (ξ i ω * ξ j ω - if i = j then 1 else 0) • A i j := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨i, j⟩, rfl⟩ := hx
    refine ⟨fun a b => if a = (i : ℕ) ∧ b = (j : ℕ) then 1 else 0, ?_⟩
    refine (coe_g2 hξ i j).trans (Filter.Eventually.of_forall fun ω => ?_)
    dsimp only
    rw [Finset.sum_eq_single (i : ℕ)]
    · rw [Finset.sum_eq_single (j : ℕ)]
      · simp
      · intro b _ hb; simp [hb]
      · intro h; exact absurd (Finset.mem_range.2 j.2) h
    · intro a _ ha; simp [ha]
    · intro h; exact absurd (Finset.mem_range.2 i.2) h
  | zero =>
    refine ⟨0, ?_⟩
    filter_upwards [Lp.coeFn_zero ℝ 2 P] with ω h
    simp [h]
  | add x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    refine ⟨a + b, ?_⟩
    filter_upwards [ha, hb, Lp.coeFn_add x y] with ω h1 h2 h3
    rw [h3, Pi.add_apply, h1, h2]
    simp only [Pi.add_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
  | smul c x _ hx =>
    obtain ⟨a, ha⟩ := hx
    refine ⟨c • a, ?_⟩
    filter_upwards [ha, Lp.coeFn_smul c x] with ω h1 h2
    rw [h2, Pi.smul_apply, h1, smul_eq_mul]
    simp [Finset.mul_sum, mul_left_comm]

end Gen

end HRS.MC.E213U13
