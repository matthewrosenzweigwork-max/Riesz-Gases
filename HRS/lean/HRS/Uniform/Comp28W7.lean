import HRS.Uniform.Comp28W6

/-!
# COMP-28, Wasserstein part, W7: joint law of an `ℱ_0`-measurable vector and the path of a Hilbert martingale
-/

noncomputable section

open MeasureTheory Filter Topology Set ProbabilityTheory
open scoped ENNReal NNReal

namespace HRS.Uniform.Comp28

open HRS HRS.Uniform HRS.Uniform.Q45 HRS.Uniform.Q07c

section Joint

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H]

/-- The window path of an everywhere continuous process is measurable for the σ-algebra generated by the sections. -/
theorem measurable_path_sup {Ω : Type*} {T : ℝ} (hT : 0 ≤ T) {G : ℝ → Ω → H}
    (hc : ∀ ω, Continuous fun s => G s ω) :
    Measurable[⨆ τ ∈ {τ : ℝ | 0 ≤ τ ∧ τ ≤ T}, MeasurableSpace.comap (G τ) inferInstance]
      (windowPath 0 T G) := by
  haveI : Nonempty (Set.Icc (0 : ℝ) T) := ⟨⟨0, le_rfl, hT⟩⟩
  set s : ℕ → Set.Icc (0 : ℝ) T := TopologicalSpace.denseSeq (Set.Icc (0 : ℝ) T) with hsdef
  have hs : DenseRange s := TopologicalSpace.denseRange_denseSeq _
  have hemb := measurableEmbedding_pathEvals (H := H) T s hs
  obtain ⟨g, hgm, hg⟩ := hemb.exists_measurable_extend (g := id) measurable_id (fun _ => ⟨0⟩)
  set m : MeasurableSpace Ω := ⨆ τ ∈ {τ : ℝ | 0 ≤ τ ∧ τ ≤ T}, MeasurableSpace.comap (G τ) inferInstance with hm
  have hΨ : @Measurable Ω (ℕ → H) m _ (fun ω n => G (s n : ℝ) ω) := by
    refine @measurable_pi_iff Ω ℕ (fun _ => H) m _ _ |>.2 fun n => ?_
    exact (comap_measurable (G (s n : ℝ))).mono
      (le_iSup₂ (f := fun τ (_ : τ ∈ {τ : ℝ | 0 ≤ τ ∧ τ ≤ T}) => MeasurableSpace.comap (G τ) inferInstance)
        (s n : ℝ) ⟨(s n).2.1, (s n).2.2⟩) le_rfl
  have hfun : windowPath 0 T G = g ∘ (fun ω n => G (s n : ℝ) ω) := by
    funext ω
    have h2 := congrFun hg (windowPath 0 T G ω)
    simp only [Function.comp, id] at h2
    have := pathEvals_windowPath s G (hc ω).continuousOn
    simp only [Function.comp]
    rw [← this, h2]
  rw [hfun]
  exact hgm.comp hΨ

/-- The joint law of an `ℱ_0`-measurable vector and the path of a Hilbert martingale is a product. -/
theorem joint_law_prod {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {ℱ : Filtration ℝ mΩ} {G : ℝ → Ω → H} {d : ℝ → H →L[ℝ] H →L[ℝ] ℝ} {T : ℝ} (hT : 0 ≤ T)
    (hG : IsHilbertMartingaleWithCovariation P ℱ T G (fun r _ => d r))
    (hc : ∀ ω, Continuous fun s => G s ω) (hz : ∀ ω, G 0 ω = 0) {ξ : Ω → H} (hξ : Measurable[ℱ 0] ξ) :
    P.map (fun ω => (ξ ω, windowPath 0 T G ω)) = (P.map ξ).prod (P.map (windowPath 0 T G)) := by
  set 𝒢 : InitialSigma ℱ := ⟨MeasurableSpace.comap ξ inferInstance, hξ.comap_le⟩ with h𝒢
  have hind := indep_path hG hT hc hz 𝒢
  have hpm := measurable_path_sup (H := H) hT hc
  have hsup : (⨆ τ ∈ {τ : ℝ | 0 ≤ τ ∧ τ ≤ T}, MeasurableSpace.comap (G τ) inferInstance) ≤ mΩ :=
    iSup₂_le fun τ _ => (measurable_of_isHM hG τ).comap_le
  have hind' : Indep (MeasurableSpace.comap ξ inferInstance)
      (MeasurableSpace.comap (windowPath 0 T G) inferInstance) P :=
    indep_of_indep_of_le_right hind hpm.comap_le
  have hmξ : Measurable ξ := hξ.mono (ℱ.le 0) le_rfl
  have hmP : Measurable (windowPath 0 T G) := hpm.mono hsup le_rfl
  exact (indepFun_iff_map_prod_eq_prod_map_map hmξ.aemeasurable hmP.aemeasurable).1
    ((IndepFun_iff_Indep _ _ _).2 hind')

/-- **Joint law.**  Two everywhere continuous Hilbert martingales with the same covariation density, each started
independently of an `ℱ_0`-measurable vector with the same law, give the same joint law of `(vector, path)`. -/
theorem joint_law_eq {Ω₁ Ω₂ : Type*} {m₁ : MeasurableSpace Ω₁} {m₂ : MeasurableSpace Ω₂}
    {P₁ : Measure Ω₁} {P₂ : Measure Ω₂} [IsProbabilityMeasure P₁] [IsProbabilityMeasure P₂]
    {ℱ₁ : Filtration ℝ m₁} {ℱ₂ : Filtration ℝ m₂} {G₁ : ℝ → Ω₁ → H} {G₂ : ℝ → Ω₂ → H}
    {d : ℝ → H →L[ℝ] H →L[ℝ] ℝ} {T : ℝ} (hT : 0 ≤ T)
    (hG₁ : IsHilbertMartingaleWithCovariation P₁ ℱ₁ T G₁ (fun r _ => d r))
    (hG₂ : IsHilbertMartingaleWithCovariation P₂ ℱ₂ T G₂ (fun r _ => d r))
    (hc₁ : ∀ ω, Continuous fun s => G₁ s ω) (hz₁ : ∀ ω, G₁ 0 ω = 0)
    (hc₂ : ∀ ω, Continuous fun s => G₂ s ω) (hz₂ : ∀ ω, G₂ 0 ω = 0)
    {ξ₁ : Ω₁ → H} {ξ₂ : Ω₂ → H} (hξ₁ : Measurable[ℱ₁ 0] ξ₁) (hξ₂ : Measurable[ℱ₂ 0] ξ₂)
    (hlaw : P₁.map ξ₁ = P₂.map ξ₂) :
    P₁.map (fun ω => (ξ₁ ω, windowPath 0 T G₁ ω)) = P₂.map (fun ω => (ξ₂ ω, windowPath 0 T G₂ ω)) := by
  rw [joint_law_prod hT hG₁ hc₁ hz₁ hξ₁, joint_law_prod hT hG₂ hc₂ hz₂ hξ₂, hlaw]
  congr 1
  have hf := law_path_eq_of_fdd (H := H) hT P₁ P₂ G₁ G₂ (fun t => measurable_of_isHM hG₁ t)
    (fun t => measurable_of_isHM hG₂ t) (Filter.Eventually.of_forall fun ω => (hc₁ ω).continuousOn)
    (Filter.Eventually.of_forall fun ω => (hc₂ ω).continuousOn)
    (fun p ts hts => law_fdd_eq_G hT hG₁ hG₂ hc₁ hz₁ hc₂ hz₂ ts hts)
  exact hf

end Joint

end HRS.Uniform.Comp28
