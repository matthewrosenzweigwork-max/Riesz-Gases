import Mathlib
import HRS.Prob.CLT

/-!
# Filtrations on real time, null sets, stopping times, and the `ℝ≥0`/`ℝ` time bridge

Package SI-01 (stochastic integration), foundations.

## Time index

Mathlib's Brownian motion `ProbabilityTheory.IsBrownianReal` is indexed by `ℝ≥0`, and so are the
Brownian motions `IsVectorBrownian` and the paths of `HRS/Dynamics/Setup.lean`.  The martingale
predicates of `HRS/Prob/CLT.lean` (`IsContSqMartingale`, `IsQuadraticVariation`,
`IsVectorMartingaleWithCovariation`) use `Filtration ℝ` and processes `ℝ → Ω → ℝ` that are
`Martingale` over *all* real times.  The library therefore uses:

* filtrations `Filtration ℝ mΩ` (constant on negative times is not required, but the generated
  filtrations built here are constant there);
* integrands and integrals indexed by `ℝ`, with every stochastic integral *vanishing at
  times `≤ 0`*; this makes all the martingale statements over `ℝ` literally true (for `s ≤ t`
  with `s < 0`, `E[M_t | ℱ_s] = E[E[M_t | ℱ_0] | ℱ_s] = E[M_0 | ℱ_s] = 0 = M_s`);
* driving Brownian motions indexed by `ℝ≥0` (as in Mathlib and `Setup.lean`), evaluated at
  real times through `Real.toNNReal` (`ofNNRealTime`), exactly as `IsStrongSolution` already does
  for its time integrals.

## Null sets

`Filtration ℝ mΩ` is a filtration of sub-σ-algebras of the fixed `mΩ`; `mΩ` is not assumed
`P`-complete.  Continuous versions of processes are only defined up to measurable null sets, so
to obtain *adapted* continuous versions we require that every `mΩ`-measurable `P`-null set belong
to every `ℱ t` (`IsCompleteFiltration`).  This is the only "usual condition" used; right-continuity
is never assumed (hitting times of closed sets by continuous adapted processes are stopping times
without it).  The filtration generated by initial data and a Brownian motion, augmented by the
null sets (`generatedFiltration`), satisfies it by construction.
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal

namespace HRS

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-! ### Null sets and complete filtrations -/

set_option warn.classDefReducibility false in
/-- The σ-algebra generated by the `mΩ`-measurable `P`-null sets (its measurable sets are the
measurable `P`-null and `P`-conull sets). -/
def nullSets (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | MeasurableSet s ∧ P s = 0}

theorem nullSets_le (P : Measure Ω) : nullSets P ≤ mΩ :=
  MeasurableSpace.generateFrom_le fun _ hs => hs.1

/-- Every measurable set of `nullSets P` is `P`-null or `P`-conull. -/
theorem measurableSet_nullSets_iff (P : Measure Ω) (s : Set Ω) :
    MeasurableSet[nullSets P] s ↔ MeasurableSet s ∧ (P s = 0 ∨ P sᶜ = 0) := by
  constructor
  · intro h
    let m : MeasurableSpace Ω :=
      { MeasurableSet' := fun s => MeasurableSet s ∧ (P s = 0 ∨ P sᶜ = 0)
        measurableSet_empty := ⟨MeasurableSet.empty, Or.inl (by simp)⟩
        measurableSet_compl := fun s hs => ⟨hs.1.compl, by
          rcases hs.2 with h | h
          · exact Or.inr (by simpa using h)
          · exact Or.inl h⟩
        measurableSet_iUnion := fun f hf => by
          refine ⟨MeasurableSet.iUnion fun i => (hf i).1, ?_⟩
          by_cases hall : ∀ i, P (f i) = 0
          · exact Or.inl (measure_iUnion_null hall)
          · push Not at hall
            obtain ⟨j, hj⟩ := hall
            have : P (f j)ᶜ = 0 := ((hf j).2).resolve_left hj
            refine Or.inr (measure_mono_null ?_ this)
            exact Set.compl_subset_compl.2 (Set.subset_iUnion f j) }
    have hle : nullSets P ≤ m := MeasurableSpace.generateFrom_le fun s hs =>
      ⟨hs.1, Or.inl hs.2⟩
    exact hle s h
  · rintro ⟨hs, h | h⟩
    · exact MeasurableSpace.measurableSet_generateFrom ⟨hs, h⟩
    · have : MeasurableSet[nullSets P] sᶜ :=
        MeasurableSpace.measurableSet_generateFrom ⟨hs.compl, h⟩
      simpa using this.compl

/-- A filtration (indexed by `ℝ`) is complete for `P` if every `mΩ`-measurable `P`-null set
belongs to `ℱ t` for every `t` (including negative `t`). -/
def IsCompleteFiltration (P : Measure Ω) (ℱ : Filtration ℝ mΩ) : Prop :=
  ∀ t : ℝ, ∀ s : Set Ω, MeasurableSet s → P s = 0 → MeasurableSet[ℱ t] s

/-- Auxiliary form of `IsCompleteFiltration.measurable_of_ae_eq`. -/
theorem IsCompleteFiltration.measurable_of_ae_eq_aux {E : Type*} [MeasurableSpace E]
    [MeasurableSingletonClass E] {P : Measure Ω} {ℱ : Filtration ℝ mΩ}
    (hℱ : IsCompleteFiltration P ℱ) (t : ℝ) {X Y : Ω → E} (hX : Measurable[ℱ t] X)
    (hY : Measurable Y) (hXY : X =ᵐ[P] Y) : Measurable[ℱ t] Y := by
  obtain ⟨N, hNsub, hNm, hN0⟩ : ∃ N : Set Ω, {ω | X ω ≠ Y ω} ⊆ N ∧ MeasurableSet N ∧ P N = 0 := by
    have h0 : P {ω | X ω ≠ Y ω} = 0 := ae_iff.1 hXY
    exact ⟨toMeasurable P {ω | X ω ≠ Y ω}, subset_toMeasurable _ _, measurableSet_toMeasurable _ _,
      by rw [measure_toMeasurable]; exact h0⟩
  have hNt : MeasurableSet[ℱ t] N := hℱ t N hNm hN0
  intro B hB
  have key : Y ⁻¹' B = (X ⁻¹' B \ N) ∪ (Y ⁻¹' B ∩ N) := by
    ext ω
    by_cases hω : ω ∈ N
    · simp [hω]
    · have : X ω = Y ω := by
        by_contra h
        exact hω (hNsub h)
      simp [hω, this]
  rw [key]
  refine ((hX hB).diff hNt).union ?_
  exact hℱ t _ ((hY hB).inter hNm) (measure_mono_null Set.inter_subset_right hN0)

/-- In a complete filtration, an a.e.-modification of an adapted process that is `mΩ`-measurable
is again adapted. -/
theorem IsCompleteFiltration.adapted_of_ae_eq {E : Type*} [MeasurableSpace E]
    [MeasurableSingletonClass E] {P : Measure Ω} {ℱ : Filtration ℝ mΩ}
    (hℱ : IsCompleteFiltration P ℱ) {X Y : ℝ → Ω → E} (hX : Adapted ℱ X)
    (hY : ∀ t, Measurable (Y t)) (hXY : ∀ t, X t =ᵐ[P] Y t) : Adapted ℱ Y :=
  fun t => hℱ.measurable_of_ae_eq_aux t (hX t) (hY t) (hXY t)

/-- In a complete filtration, an `mΩ`-measurable function that is a.e. equal to an
`ℱ t`-measurable function is `ℱ t`-measurable. -/
theorem IsCompleteFiltration.measurable_of_ae_eq {E : Type*} [MeasurableSpace E]
    [MeasurableSingletonClass E] {P : Measure Ω} {ℱ : Filtration ℝ mΩ}
    (hℱ : IsCompleteFiltration P ℱ) (t : ℝ) {X Y : Ω → E} (hX : Measurable[ℱ t] X)
    (hY : Measurable Y) (hXY : X =ᵐ[P] Y) : Measurable[ℱ t] Y :=
  hℱ.measurable_of_ae_eq_aux t hX hY hXY

/-! ### Real time from nonnegative time -/

/-- A process indexed by `ℝ≥0` viewed as a process indexed by `ℝ`, constant equal to its
time-`0` value on `(-∞, 0]`. -/
def ofNNRealTime {E : Type*} (X : ℝ≥0 → Ω → E) : ℝ → Ω → E :=
  fun t ω => X (Real.toNNReal t) ω

@[simp]
theorem ofNNRealTime_apply {E : Type*} (X : ℝ≥0 → Ω → E) (t : ℝ) (ω : Ω) :
    ofNNRealTime X t ω = X (Real.toNNReal t) ω := rfl

theorem ofNNRealTime_of_nonneg {E : Type*} (X : ℝ≥0 → Ω → E) (t : ℝ≥0) (ω : Ω) :
    ofNNRealTime X t ω = X t ω := by
  simp [ofNNRealTime]

/-- Continuity transfers along `Real.toNNReal`. -/
theorem continuous_ofNNRealTime {E : Type*} [TopologicalSpace E] (X : ℝ≥0 → Ω → E) (ω : Ω)
    (h : Continuous fun t => X t ω) : Continuous fun t => ofNNRealTime X t ω :=
  h.comp continuous_real_toNNReal

/-! ### Indistinguishability of continuous processes -/

/-- Two processes with (everywhere) continuous paths that agree a.s. at every fixed time agree
a.s. at all times simultaneously. -/
theorem ae_forall_eq_of_continuous {E : Type*} [TopologicalSpace E] [T2Space E]
    (P : Measure Ω) (X Y : ℝ → Ω → E) (hX : ∀ ω, Continuous fun t => X t ω)
    (hY : ∀ ω, Continuous fun t => Y t ω) (h : ∀ t, X t =ᵐ[P] Y t) :
    ∀ᵐ ω ∂P, ∀ t, X t ω = Y t ω := by
  have hq : ∀ᵐ ω ∂P, ∀ q : ℚ, X (q : ℝ) ω = Y (q : ℝ) ω :=
    ae_all_iff.2 fun q => h (q : ℝ)
  filter_upwards [hq] with ω hω t
  have heq : (fun t => X t ω) = fun t => Y t ω :=
    Rat.denseRange_cast.equalizer (hX ω) (hY ω) (funext hω)
  exact congrFun heq t

/-- A process with a.s. continuous paths, each `X t` measurable, has an everywhere-continuous
measurable modification (the paths on a measurable null set are replaced by a constant). -/
theorem exists_continuous_modification {E : Type*} [TopologicalSpace E] [MeasurableSpace E]
    [Inhabited E] (P : Measure Ω) (X : ℝ≥0 → Ω → E) (hmeas : ∀ t, Measurable (X t))
    (hcont : ∀ᵐ ω ∂P, Continuous fun t => X t ω) :
    ∃ Y : ℝ≥0 → Ω → E, (∀ t, Measurable (Y t)) ∧ (∀ ω, Continuous fun t => Y t ω) ∧
      ∀ᵐ ω ∂P, ∀ t, Y t ω = X t ω := by
  obtain ⟨N, hNsub, hNm, hN0⟩ : ∃ N : Set Ω, {ω | ¬ Continuous fun t => X t ω} ⊆ N ∧
      MeasurableSet N ∧ P N = 0 := by
    have h0 : P {ω | ¬ Continuous fun t => X t ω} = 0 := ae_iff.1 hcont
    exact ⟨toMeasurable P {ω | ¬ Continuous fun t => X t ω}, subset_toMeasurable _ _,
      measurableSet_toMeasurable _ _, by rw [measure_toMeasurable]; exact h0⟩
  classical
  refine ⟨fun t ω => if ω ∈ N then default else X t ω, fun t => ?_, fun ω => ?_, ?_⟩
  · exact Measurable.ite hNm measurable_const (hmeas t)
  · by_cases hω : ω ∈ N
    · simp only [hω, ite_true]
      exact continuous_const
    · simp only [hω, ite_false]
      by_contra hc
      exact hω (hNsub hc)
  · have : ∀ᵐ ω ∂P, ω ∉ N := by
      rw [ae_iff]; simpa using hN0
    filter_upwards [this] with ω hω t
    simp [hω]

/-! ### Generated (and augmented) filtrations -/

/-- The filtration generated by an initial datum `X₀` and a process `W` (indexed by `ℝ≥0`),
augmented by the `P`-null sets: `ℱ t = σ(X₀) ⊔ σ(W s : s ≤ t) ⊔ nullSets P` (for `t < 0` this is
`σ(X₀) ⊔ nullSets P`). -/
def generatedFiltration (P : Measure Ω) {E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    (X₀ : Ω → E) (hX₀ : Measurable X₀) (W : ℝ≥0 → Ω → F) (hW : ∀ t, Measurable (W t)) :
    Filtration ℝ mΩ where
  seq t := (MeasurableSpace.comap X₀ inferInstance ⊔
      ⨆ (s : ℝ≥0) (_ : (s : ℝ) ≤ t), MeasurableSpace.comap (W s) inferInstance) ⊔ nullSets P
  mono' := by
    intro t t' htt'
    refine sup_le_sup_right (sup_le_sup_left ?_ _) _
    exact iSup_mono fun s => iSup_mono' fun hs => ⟨hs.trans htt', le_rfl⟩
  le' t := by
    refine sup_le (sup_le hX₀.comap_le (iSup_le fun s => iSup_le fun _ => (hW s).comap_le))
      (nullSets_le P)

theorem generatedFiltration_isComplete (P : Measure Ω) {E F : Type*} [MeasurableSpace E]
    [MeasurableSpace F] (X₀ : Ω → E) (hX₀ : Measurable X₀) (W : ℝ≥0 → Ω → F)
    (hW : ∀ t, Measurable (W t)) : IsCompleteFiltration P (generatedFiltration P X₀ hX₀ W hW) := by
  intro t s hs hP
  have h1 : MeasurableSet[nullSets P] s := MeasurableSpace.measurableSet_generateFrom ⟨hs, hP⟩
  exact (le_sup_right : nullSets P ≤ _) s h1

theorem generatedFiltration_measurable_init (P : Measure Ω) {E F : Type*} [MeasurableSpace E]
    [MeasurableSpace F] (X₀ : Ω → E) (hX₀ : Measurable X₀) (W : ℝ≥0 → Ω → F)
    (hW : ∀ t, Measurable (W t)) (t : ℝ) : Measurable[generatedFiltration P X₀ hX₀ W hW t] X₀ := by
  refine Measurable.of_comap_le (m₁ := generatedFiltration P X₀ hX₀ W hW t) ?_
  exact le_sup_left.trans le_sup_left

theorem generatedFiltration_measurable_W (P : Measure Ω) {E F : Type*} [MeasurableSpace E]
    [MeasurableSpace F] (X₀ : Ω → E) (hX₀ : Measurable X₀) (W : ℝ≥0 → Ω → F)
    (hW : ∀ t, Measurable (W t)) (s : ℝ≥0) (t : ℝ) (hst : (s : ℝ) ≤ t) :
    Measurable[generatedFiltration P X₀ hX₀ W hW t] (W s) := by
  refine Measurable.of_comap_le (m₁ := generatedFiltration P X₀ hX₀ W hW t) ?_
  refine le_trans ?_ (le_sup_right.trans le_sup_left)
  exact le_iSup₂_of_le s hst le_rfl

/-! ### Stopping times on real time

Stopping times are `τ : Ω → WithTop ℝ` (Mathlib's convention at this pin), `⊤` meaning "never".
The stopped process `stoppedProcess M τ t ω = M (min t (τ ω)) ω` and `stoppedValue` are Mathlib's.
-/

/-- For a closed set and a continuous path, the hitting time is `≤ t` iff the path visits the
set in `[n, t]`. -/
theorem hittingAfter_le_iff_of_isClosed {E : Type*} [TopologicalSpace E] (X : ℝ → Ω → E) (ω : Ω)
    (hcont : Continuous fun t => X t ω) {s : Set E} (hs : IsClosed s) (n t : ℝ) :
    hittingAfter X s n ω ≤ (t : WithTop ℝ) ↔ ∃ r, n ≤ r ∧ r ≤ t ∧ X r ω ∈ s := by
  constructor
  · intro h
    have hex : ∃ j, n ≤ j ∧ X j ω ∈ s := by
      by_contra hne
      simp [hittingAfter, hne] at h
    have hSc : IsClosed {i : ℝ | n ≤ i ∧ X i ω ∈ s} :=
      isClosed_Ici.inter (hs.preimage hcont)
    have hmem := hSc.csInf_mem (by obtain ⟨j, hj⟩ := hex; exact ⟨j, hj⟩)
      ⟨n, fun b hb => hb.1⟩
    refine ⟨sInf {i : ℝ | n ≤ i ∧ X i ω ∈ s}, hmem.1, ?_, hmem.2⟩
    rw [hittingAfter, ite_eq_left hex] at h
    exact_mod_cast h
  · rintro ⟨r, hnr, hrt, hr⟩
    exact (hittingAfter_le_of_mem hnr hr).trans (by exact_mod_cast hrt)

/-- At a finite hitting time of a closed set by a continuous path, the path is in the set. -/
theorem mem_of_hittingAfter_eq_of_isClosed {E : Type*} [TopologicalSpace E] (X : ℝ → Ω → E)
    (ω : Ω) (hcont : Continuous fun t => X t ω) {s : Set E} (hs : IsClosed s) (n t : ℝ)
    (h : hittingAfter X s n ω = (t : WithTop ℝ)) : X t ω ∈ s := by
  have hex : ∃ j, n ≤ j ∧ X j ω ∈ s := by
    by_contra hne
    simp [hittingAfter, hne] at h
  have hSc : IsClosed {i : ℝ | n ≤ i ∧ X i ω ∈ s} :=
    isClosed_Ici.inter (hs.preimage hcont)
  have hmem := hSc.csInf_mem (by obtain ⟨j, hj⟩ := hex; exact ⟨j, hj⟩)
    ⟨n, fun b hb => hb.1⟩
  rw [hittingAfter, ite_eq_left hex] at h
  have : sInf {i : ℝ | n ≤ i ∧ X i ω ∈ s} = t := by exact_mod_cast h
  rw [← this]
  exact hmem.2

/-- The first hitting time (after time `n`) of a *closed* set by a process with everywhere
continuous paths, adapted to `ℱ`, is a stopping time (no right-continuity of `ℱ` is needed). -/
theorem isStoppingTime_hittingAfter_of_isClosed {E : Type*} [PseudoMetricSpace E]
    [MeasurableSpace E] [BorelSpace E] (ℱ : Filtration ℝ mΩ) (X : ℝ → Ω → E)
    (hX : Adapted ℱ X) (hcont : ∀ ω, Continuous fun t => X t ω) {s : Set E} (hs : IsClosed s)
    (n : ℝ) : IsStoppingTime ℱ (hittingAfter X s n) := by
  intro t
  have hset : {ω | hittingAfter X s n ω ≤ (t : WithTop ℝ)} =
      {ω | ∃ r, n ≤ r ∧ r ≤ t ∧ X r ω ∈ s} := by
    ext ω
    exact hittingAfter_le_iff_of_isClosed X ω (hcont ω) hs n t
  rw [hset]
  rcases s.eq_empty_or_nonempty with rfl | hne
  · simp
  by_cases hnt : n ≤ t
  swap
  · have : {ω | ∃ r, n ≤ r ∧ r ≤ t ∧ X r ω ∈ s} = ∅ := by
      ext ω
      simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨r, hnr, hrt, -⟩
      exact hnt (hnr.trans hrt)
    rw [this]
    exact @MeasurableSet.empty _ (ℱ t)
  -- clamp rationals into `[n, t]`
  let c : ℚ → ℝ := fun q => max n (min t (q : ℝ))
  have hc_mem : ∀ q, n ≤ c q ∧ c q ≤ t := fun q =>
    ⟨le_max_left _ _, max_le hnt (min_le_left _ _)⟩
  have hc_cont : Continuous fun x : ℝ => max n (min t x) :=
    continuous_const.max (continuous_const.min continuous_id)
  have hmeasf : ∀ q : ℚ, Measurable[ℱ t] fun ω => Metric.infDist (X (c q) ω) s := fun q =>
    (Metric.continuous_infDist_pt s).measurable.comp
      ((hX (c q)).mono (ℱ.mono (hc_mem q).2) le_rfl)
  have hkey : {ω | ∃ r, n ≤ r ∧ r ≤ t ∧ X r ω ∈ s} =
      ⋂ k : ℕ, ⋃ q : ℚ, {ω | Metric.infDist (X (c q) ω) s < 1 / ((k : ℝ) + 1)} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_iUnion]
    have hf : Continuous fun r => Metric.infDist (X r ω) s :=
      (Metric.continuous_infDist_pt s).comp (hcont ω)
    constructor
    · rintro ⟨r, hnr, hrt, hr⟩ k
      have hr0 : Metric.infDist (X r ω) s = 0 := (hs.mem_iff_infDist_zero hne).1 hr
      have hcr : max n (min t r) = r := by
        rw [min_eq_right hrt, max_eq_right hnr]
      have hg : Continuous fun x : ℝ => Metric.infDist (X (max n (min t x)) ω) s :=
        hf.comp hc_cont
      have hev : ∀ᶠ x in 𝓝 r, Metric.infDist (X (max n (min t x)) ω) s < 1 / ((k : ℝ) + 1) := by
        apply hg.continuousAt.eventually_lt continuousAt_const
        simp only [hcr, hr0]
        positivity
      obtain ⟨U, hUsub, hUopen, hrU⟩ := eventually_nhds_iff.1 hev
      obtain ⟨q, hq⟩ := Rat.denseRange_cast.exists_mem_open hUopen ⟨r, hrU⟩
      exact ⟨q, hUsub _ hq⟩
    · intro h
      obtain ⟨r₀, hr₀, hmin⟩ := isCompact_Icc.exists_isMinOn (Set.nonempty_Icc.2 hnt)
        hf.continuousOn
      refine ⟨r₀, hr₀.1, hr₀.2, ?_⟩
      rw [hs.mem_iff_infDist_zero hne]
      refine le_antisymm ?_ Metric.infDist_nonneg
      refine le_of_forall_pos_lt_add fun ε hε => ?_
      obtain ⟨k, hk⟩ := exists_nat_one_div_lt hε
      obtain ⟨q, hq⟩ := h k
      have := hmin (show c q ∈ Set.Icc n t from hc_mem q)
      simp only [Set.mem_ofPred_eq] at this
      linarith
  rw [hkey]
  exact MeasurableSet.iInter fun k => MeasurableSet.iUnion fun q =>
    (hmeasf q) measurableSet_Iio

/-- The exit time from an open set `U` (after time `n`) of a continuous adapted process: the
hitting time of the closed set `Uᶜ`. -/
def exitTime {E : Type*} [TopologicalSpace E] (X : ℝ → Ω → E) (U : Set E) (n : ℝ) :
    Ω → WithTop ℝ :=
  hittingAfter X Uᶜ n

theorem isStoppingTime_exitTime {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E]
    [BorelSpace E] (ℱ : Filtration ℝ mΩ) (X : ℝ → Ω → E) (hX : Adapted ℱ X)
    (hcont : ∀ ω, Continuous fun t => X t ω) {U : Set E} (hU : IsOpen U) (n : ℝ) :
    IsStoppingTime ℱ (exitTime X U n) :=
  isStoppingTime_hittingAfter_of_isClosed ℱ X hX hcont hU.isClosed_compl n

/-- Before the exit time the process stays in `U`: for `n ≤ t < exitTime X U n ω`, `X t ω ∈ U`. -/
theorem mem_of_lt_exitTime {E : Type*} [TopologicalSpace E] (X : ℝ → Ω → E) (U : Set E) (n : ℝ)
    (ω : Ω) (t : ℝ) (hnt : n ≤ t) (ht : (t : WithTop ℝ) < exitTime X U n ω) : X t ω ∈ U := by
  have := notMem_of_lt_hittingAfter (u := X) (s := Uᶜ) (n := n) (ω := ω) (k := t) ht hnt
  simpa using this

/-- At a finite exit time from an open set the continuous path is on the boundary (in `Uᶜ`). -/
theorem notMem_of_exitTime_eq {E : Type*} [TopologicalSpace E] (X : ℝ → Ω → E) (U : Set E)
    (hU : IsOpen U) (n : ℝ) (ω : Ω) (hcont : Continuous fun t => X t ω) (t : ℝ)
    (ht : exitTime X U n ω = t) : X t ω ∉ U :=
  mem_of_hittingAfter_eq_of_isClosed X ω hcont hU.isClosed_compl n t ht

/-- The first time a continuous adapted real process reaches level `c` (after time `0`) is a
stopping time; this is the stopping time used for localisation
(`τ_R = inf {t : A_t ≥ R}` for a continuous nondecreasing adapted `A`). -/
theorem isStoppingTime_hittingAfter_Ici (ℱ : Filtration ℝ mΩ) (A : ℝ → Ω → ℝ) (hA : Adapted ℱ A)
    (hcont : ∀ ω, Continuous fun t => A t ω) (c : ℝ) :
    IsStoppingTime ℱ (hittingAfter A (Set.Ici c) 0) :=
  isStoppingTime_hittingAfter_of_isClosed ℱ A hA hcont isClosed_Ici 0

/-- Along stopping times `τ_n = inf {t ≥ 0 : A_t ≥ n}` of a continuous process `A` that is finite
at every time, `τ_n → ⊤` pointwise: for every `T` there is `n` with `T ≤ τ_n ω`. -/
theorem hittingAfter_Ici_tendsto_top (A : ℝ → Ω → ℝ) (ω : Ω) (hcont : Continuous fun t => A t ω)
    (T : ℝ) : ∃ n : ℕ, (T : WithTop ℝ) ≤ hittingAfter A (Set.Ici (n : ℝ)) 0 ω := by
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := T)).bddAbove_image hcont.continuousOn
  obtain ⟨n, hn⟩ := exists_nat_gt B
  refine ⟨n, ?_⟩
  by_contra hlt
  rw [not_le] at hlt
  have hne : hittingAfter A (Set.Ici (n : ℝ)) 0 ω ≠ ⊤ := ne_top_of_lt hlt
  obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.1 hne
  have ha' : hittingAfter A (Set.Ici (n : ℝ)) 0 ω = (a : WithTop ℝ) := ha.symm
  have hmem := mem_of_hittingAfter_eq_of_isClosed A ω hcont isClosed_Ici 0 a ha'
  have h0a : (0 : WithTop ℝ) ≤ (a : WithTop ℝ) := ha' ▸ le_hittingAfter ω
  have haT : a < T := by
    rw [ha'] at hlt
    exact_mod_cast hlt
  have h0a' : (0 : ℝ) ≤ a := by exact_mod_cast h0a
  have := hB ⟨a, ⟨h0a', haT.le⟩, rfl⟩
  have h2 : (n : ℝ) ≤ A a ω := hmem
  linarith

/-- The indicator process `1_{t ≤ τ}` of a stopping time is progressively measurable. -/
theorem isProgressive_indicator_le_stoppingTime (ℱ : Filtration ℝ mΩ) {τ : Ω → WithTop ℝ}
    (hτ : IsStoppingTime ℱ τ) :
    IsProgressive ℱ fun (t : ℝ) ω => Set.indicator {ω | (t : WithTop ℝ) ≤ τ ω} (fun _ => (1 : ℝ)) ω := by
  intro t
  let S : Set (Set.Iic t × Ω) := {p | τ p.2 < ((p.1 : ℝ) : WithTop ℝ)}
  have hS : MeasurableSet[Subtype.instMeasurableSpace.prod (ℱ t)] S := by
    have hSeq : S = ⋃ q : ℚ, ⋃ (_ : (q : ℝ) ≤ t),
        ({u : Set.Iic t | (q : ℝ) < (u : ℝ)} ×ˢ {ω | τ ω < ((q : ℝ) : WithTop ℝ)}) := by
      ext ⟨u, ω⟩
      simp only [S, Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_prod]
      constructor
      · intro h
        cases hτω : τ ω with
        | top => simp [hτω] at h
        | coe a =>
          rw [hτω] at h
          have h' : a < (u : ℝ) := by exact_mod_cast h
          obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn h'
          exact ⟨q, (hq2.le.trans u.2), hq2, by exact_mod_cast hq1⟩
      · rintro ⟨q, hqt, hq1, hq2⟩
        exact hq2.trans (by exact_mod_cast hq1)
    rw [hSeq]
    refine MeasurableSet.iUnion fun q => MeasurableSet.iUnion fun hq => ?_
    refine MeasurableSet.prod ?_ ?_
    · exact measurableSet_lt measurable_const measurable_subtype_coe
    · exact ℱ.mono hq _ (hτ.measurableSet_lt (q : ℝ))
  have heq : (fun p : Set.Iic t × Ω => Set.indicator {ω | ((p.1 : ℝ) : WithTop ℝ) ≤ τ ω}
      (fun _ => (1 : ℝ)) p.2) = Sᶜ.indicator (fun _ => (1 : ℝ)) := by
    ext ⟨u, ω⟩
    by_cases h : ((u : ℝ) : WithTop ℝ) ≤ τ ω
    · have : (⟨u, ω⟩ : Set.Iic t × Ω) ∈ Sᶜ := by
        simp only [S, Set.mem_compl_iff, Set.mem_ofPred_eq, not_lt]; exact h
      simp [Set.indicator_of_mem this, h]
    · have : (⟨u, ω⟩ : Set.Iic t × Ω) ∉ Sᶜ := by
        simp only [S, Set.mem_compl_iff, Set.mem_ofPred_eq, not_not]; exact not_le.1 h
      simp [Set.indicator_of_notMem this, h]
  rw [heq]
  exact measurable_const.indicator hS.compl

/-! #### Dyadic approximation of a stopping time from above -/

/-- Upper dyadic approximation of a `WithTop ℝ`-valued function. -/
def dyadicUp (m : ℕ) (τ : Ω → WithTop ℝ) : Ω → WithTop ℝ :=
  fun ω => (τ ω).map fun a => (⌈(2 : ℝ) ^ m * a⌉ : ℝ) / 2 ^ m

theorem dyadicUp_le_iff (m : ℕ) (τ : Ω → WithTop ℝ) (ω : Ω) (t : ℝ) :
    dyadicUp m τ ω ≤ (t : WithTop ℝ) ↔
      τ ω ≤ (((⌊(2 : ℝ) ^ m * t⌋ : ℝ) / 2 ^ m : ℝ) : WithTop ℝ) := by
  unfold dyadicUp
  cases h : τ ω with
  | top => simp
  | coe a =>
    simp only [WithTop.map_coe, WithTop.coe_le_coe]
    have hpos : (0 : ℝ) < 2 ^ m := by positivity
    rw [div_le_iff₀ hpos, le_div_iff₀ hpos, mul_comm t, mul_comm a]
    constructor
    · intro h1
      have : ⌈(2 : ℝ) ^ m * a⌉ ≤ ⌊(2 : ℝ) ^ m * t⌋ := Int.le_floor.2 (by exact_mod_cast h1)
      exact le_trans (Int.ceil_le.1 this) (le_refl _)
    · intro h1
      have : ⌈(2 : ℝ) ^ m * a⌉ ≤ ⌊(2 : ℝ) ^ m * t⌋ := Int.ceil_le.2 h1
      exact le_trans (by exact_mod_cast this) (Int.floor_le _)


theorem isStoppingTime_dyadicUp (ℱ : Filtration ℝ mΩ) {τ : Ω → WithTop ℝ}
    (hτ : IsStoppingTime ℱ τ) (m : ℕ) : IsStoppingTime ℱ (dyadicUp m τ) := by
  intro t
  have : {ω | dyadicUp m τ ω ≤ (t : WithTop ℝ)} =
      {ω | τ ω ≤ (((⌊(2 : ℝ) ^ m * t⌋ : ℝ) / 2 ^ m : ℝ) : WithTop ℝ)} := by
    ext ω; exact dyadicUp_le_iff m τ ω t
  rw [this]
  refine ℱ.mono ?_ _ (hτ _)
  have hpos : (0 : ℝ) < 2 ^ m := by positivity
  rw [div_le_iff₀ hpos, mul_comm t]
  exact Int.floor_le _

theorem countable_range_dyadicUp (m : ℕ) (τ : Ω → WithTop ℝ) :
    (Set.range (dyadicUp m τ)).Countable := by
  have : Set.range (dyadicUp m τ) ⊆ insert ⊤ (Set.range fun k : ℤ => (((k : ℝ) / 2 ^ m : ℝ) : WithTop ℝ)) := by
    rintro _ ⟨ω, rfl⟩
    unfold dyadicUp
    cases τ ω with
    | top => simp
    | coe a => exact Or.inr ⟨⌈(2 : ℝ) ^ m * a⌉, by simp⟩
  exact ((Set.countable_range _).insert _).mono this

theorem le_dyadicUp (m : ℕ) (τ : Ω → WithTop ℝ) (ω : Ω) : τ ω ≤ dyadicUp m τ ω := by
  unfold dyadicUp
  cases τ ω with
  | top => simp
  | coe a =>
    simp only [WithTop.map_coe, WithTop.coe_le_coe]
    have hpos : (0 : ℝ) < 2 ^ m := by positivity
    rw [le_div_iff₀ hpos, mul_comm]
    exact Int.le_ceil _

theorem dyadicUp_eq_top_iff (m : ℕ) (τ : Ω → WithTop ℝ) (ω : Ω) :
    dyadicUp m τ ω = ⊤ ↔ τ ω = ⊤ := by
  unfold dyadicUp
  cases τ ω <;> simp

theorem dyadicUp_lt_add {m : ℕ} {τ : Ω → WithTop ℝ} {ω : Ω} {a : ℝ} (h : τ ω = a) :
    ∃ c : ℝ, dyadicUp m τ ω = c ∧ a ≤ c ∧ c < a + (1 / 2) ^ m := by
  refine ⟨(⌈(2 : ℝ) ^ m * a⌉ : ℝ) / 2 ^ m, by simp [dyadicUp, h], ?_, ?_⟩
  · have hpos : (0 : ℝ) < 2 ^ m := by positivity
    rw [le_div_iff₀ hpos, mul_comm]
    exact Int.le_ceil _
  · have hpos : (0 : ℝ) < 2 ^ m := by positivity
    rw [div_lt_iff₀ hpos]
    have := Int.ceil_lt_add_one ((2 : ℝ) ^ m * a)
    have e : (a + (1 / 2) ^ m) * 2 ^ m = 2 ^ m * a + 1 := by
      rw [add_mul, one_div, inv_pow, inv_mul_cancel₀ hpos.ne']
      ring
    rw [e]
    exact this


theorem stoppedProcess_apply_coe {M : ℝ → Ω → ℝ} {σ : Ω → WithTop ℝ} {ω : Ω} {c : ℝ}
    (h : σ ω = c) (u : ℝ) : stoppedProcess M σ u ω = M (min u c) ω := by
  have : min (u : WithTop ℝ) (σ ω) = ((min u c : ℝ) : WithTop ℝ) := by
    rw [h]; exact (WithTop.coe_min u c).symm
  unfold stoppedProcess
  rw [this]
  rfl

theorem stoppedProcess_apply_top {M : ℝ → Ω → ℝ} {σ : Ω → WithTop ℝ} {ω : Ω}
    (h : σ ω = ⊤) (u : ℝ) : stoppedProcess M σ u ω = M u ω := by
  simp [stoppedProcess, h]

theorem tendsto_stoppedProcess_dyadicUp (M : ℝ → Ω → ℝ) (ω : Ω)
    (hcont : Continuous fun t => M t ω) (τ : Ω → WithTop ℝ) (u : ℝ) :
    Tendsto (fun m : ℕ => stoppedProcess M (dyadicUp m τ) u ω) atTop
      (𝓝 (stoppedProcess M τ u ω)) := by
  cases h : τ ω with
  | top =>
    have h1 : ∀ m : ℕ, dyadicUp m τ ω = ⊤ := fun m => (dyadicUp_eq_top_iff m τ ω).2 h
    simp only [stoppedProcess_apply_top h, stoppedProcess_apply_top (h1 _)]
    exact tendsto_const_nhds
  | coe a =>
    choose c hc1 hc2 hc3 using fun m : ℕ => dyadicUp_lt_add (m := m) (τ := τ) (ω := ω) h
    have hc : Tendsto c atTop (𝓝 a) := by
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ hc2
        (fun m => (hc3 m).le)
      have : Tendsto (fun m : ℕ => a + (1 / 2 : ℝ) ^ m) atTop (𝓝 (a + 0)) :=
        tendsto_const_nhds.add (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num))
      simpa using this
    simp only [stoppedProcess_apply_coe h, stoppedProcess_apply_coe (hc1 _)]
    exact ((hcont.tendsto _).comp (tendsto_const_nhds.min hc))


section OptionalStopping

variable {P : Measure Ω} [IsProbabilityMeasure P] {ℱ : Filtration ℝ mΩ} {M : ℝ → Ω → ℝ}

theorem countable_range_min_const (c : WithTop ℝ) {σ : Ω → WithTop ℝ}
    (h : (Set.range σ).Countable) : (Set.range fun ω => min c (σ ω)).Countable :=
  (h.image (fun x => min c x)).mono (by rintro _ ⟨ω, rfl⟩; exact ⟨σ ω, ⟨ω, rfl⟩, rfl⟩)

theorem stoppedValue_ae_eq_condExp_aux (hM : Martingale M ℱ P) {σ : Ω → WithTop ℝ}
    (hσ : IsStoppingTime ℱ σ) {t : ℝ} (hle : ∀ ω, σ ω ≤ (t : WithTop ℝ))
    (hc : (Set.range σ).Countable) :
    stoppedValue M σ =ᵐ[P] P[M t | hσ.measurableSpace] := by
  have : SigmaFinite (P.trim (hσ.measurableSpace_le_of_le hle)) := inferInstance
  exact hM.stoppedValue_ae_eq_condExp_of_le_const_of_countable_range hσ hle hc

theorem integrable_stoppedValue_aux (hM : Martingale M ℱ P) {σ : Ω → WithTop ℝ}
    (hσ : IsStoppingTime ℱ σ) {t : ℝ} (hle : ∀ ω, σ ω ≤ (t : WithTop ℝ))
    (hc : (Set.range σ).Countable) : Integrable (stoppedValue M σ) P :=
  integrable_condExp.congr (stoppedValue_ae_eq_condExp_aux hM hσ hle hc).symm

/-- Optional stopping at a stopping time with countable range, in set-integral form. -/
theorem setIntegral_stoppedProcess_countable (hM : Martingale M ℱ P) {σ : Ω → WithTop ℝ}
    (hσ : IsStoppingTime ℱ σ) (hc : (Set.range σ).Countable) {s t : ℝ} (hst : s ≤ t)
    {A : Set Ω} (hA : MeasurableSet[ℱ s] A) :
    ∫ ω in A, stoppedProcess M σ s ω ∂P = ∫ ω in A, stoppedProcess M σ t ω ∂P := by
  classical
  have hAm : MeasurableSet A := ℱ.le s A hA
  let ρ : Ω → WithTop ℝ := A.piecewise (fun _ => (s : WithTop ℝ)) fun _ => (t : WithTop ℝ)
  have hρ : IsStoppingTime ℱ ρ := isStoppingTime_piecewise_const (mod_cast hst) hA
  have hρle : ∀ ω, ρ ω ≤ (t : WithTop ℝ) := fun ω => by
    by_cases hx : ω ∈ A
    · simp only [ρ, Set.piecewise_eq_of_mem _ _ _ hx]; exact_mod_cast hst
    · simp only [ρ, Set.piecewise_eq_of_notMem _ _ _ hx]; exact le_rfl
  let σ1 : Ω → WithTop ℝ := fun ω => min (ρ ω) (σ ω)
  let σ2 : Ω → WithTop ℝ := fun ω => min (t : WithTop ℝ) (σ ω)
  have hσ1 : IsStoppingTime ℱ σ1 := hρ.min hσ
  have hσ2 : IsStoppingTime ℱ σ2 := (isStoppingTime_const ℱ t).min hσ
  have hle1 : ∀ ω, σ1 ω ≤ (t : WithTop ℝ) := fun ω => (min_le_left _ _).trans (hρle ω)
  have hle2 : ∀ ω, σ2 ω ≤ (t : WithTop ℝ) := fun ω => min_le_left _ _
  have hle12 : σ1 ≤ σ2 := fun ω => min_le_min_right _ (hρle ω)
  have hc2 : (Set.range σ2).Countable := countable_range_min_const _ hc
  have hc1 : (Set.range σ1).Countable := by
    refine ((hc.image (fun x => min (s : WithTop ℝ) x)).union
      (hc.image (fun x => min (t : WithTop ℝ) x))).mono ?_
    rintro _ ⟨ω, rfl⟩
    by_cases hx : ω ∈ A
    · left; exact ⟨σ ω, ⟨ω, rfl⟩, by simp [σ1, ρ, hx]⟩
    · right; exact ⟨σ ω, ⟨ω, rfl⟩, by simp [σ1, ρ, hx]⟩
  have hint1 : Integrable (stoppedValue M σ1) P := integrable_stoppedValue_aux hM hσ1 hle1 hc1
  have hint2 : Integrable (stoppedValue M σ2) P := integrable_stoppedValue_aux hM hσ2 hle2 hc2
  have : SigmaFinite (P.trim (hσ1.measurableSpace_le_of_le hle1)) := inferInstance
  have hcond := hM.stoppedValue_ae_eq_condExp_of_le_of_countable_range hσ2 hσ1 hle12 hle2 hc2 hc1
  have hint_eq : ∫ ω, stoppedValue M σ1 ω ∂P = ∫ ω, stoppedValue M σ2 ω ∂P := by
    rw [integral_congr_ae hcond, integral_condExp (hσ1.measurableSpace_le_of_le hle1)]
  have hv1 : ∀ ω ∈ A, stoppedValue M σ1 ω = stoppedProcess M σ s ω := fun ω hx => by
    simp [stoppedValue, stoppedProcess, σ1, ρ, hx]
  have hv2 : ∀ ω ∈ Aᶜ, stoppedValue M σ1 ω = stoppedProcess M σ t ω := fun ω hx => by
    simp only [Set.mem_compl_iff] at hx
    simp [stoppedValue, stoppedProcess, σ1, ρ, hx]
  have hsplit1 := integral_add_compl hAm hint1
  have hsplit2 := integral_add_compl hAm hint2
  have e1 : ∫ ω in A, stoppedValue M σ1 ω ∂P = ∫ ω in A, stoppedProcess M σ s ω ∂P :=
    setIntegral_congr_fun hAm hv1
  have e2 : ∫ ω in Aᶜ, stoppedValue M σ1 ω ∂P = ∫ ω in Aᶜ, stoppedProcess M σ t ω ∂P :=
    setIntegral_congr_fun hAm.compl hv2
  have e3 : stoppedValue M σ2 = stoppedProcess M σ t := rfl
  rw [e3] at hsplit2 hint_eq
  rw [e1, e2] at hsplit1
  linarith

theorem tendsto_setIntegral_stoppedProcess_dyadicUp (hM : Martingale M ℱ P)
    (hcont : ∀ ω, Continuous fun t => M t ω) {τ : Ω → WithTop ℝ} (hτ : IsStoppingTime ℱ τ)
    (u : ℝ) (A : Set Ω) :
    Integrable (stoppedProcess M τ u) P ∧
      Tendsto (fun m : ℕ => ∫ ω in A, stoppedProcess M (dyadicUp m τ) u ω ∂P) atTop
        (𝓝 (∫ ω in A, stoppedProcess M τ u ω ∂P)) := by
  have hσm : ∀ m : ℕ, IsStoppingTime ℱ (fun ω => min (u : WithTop ℝ) (dyadicUp m τ ω)) :=
    fun m => (isStoppingTime_const ℱ u).min (isStoppingTime_dyadicUp ℱ hτ m)
  have hle : ∀ (m : ℕ) ω, min (u : WithTop ℝ) (dyadicUp m τ ω) ≤ (u : WithTop ℝ) :=
    fun m ω => min_le_left _ _
  have hae : ∀ m : ℕ, stoppedProcess M (dyadicUp m τ) u =ᵐ[P] P[M u | (hσm m).measurableSpace] :=
    fun m => stoppedValue_ae_eq_condExp_aux hM (hσm m) (hle m)
      (countable_range_min_const _ (countable_range_dyadicUp m τ))
  have hUI : UniformIntegrable (fun m : ℕ => stoppedProcess M (dyadicUp m τ) u) 1 P :=
    ((hM.integrable u).uniformIntegrable_condExp
      (ℱ := fun m : ℕ => (hσm m).measurableSpace)
      (fun m => (hσm m).measurableSpace_le_of_le (hle m))).ae_eq (fun m => (hae m).symm)
  have hlim : ∀ᵐ ω ∂P, Tendsto (fun m : ℕ => stoppedProcess M (dyadicUp m τ) u ω) atTop
      (𝓝 (stoppedProcess M τ u ω)) :=
    Eventually.of_forall fun ω => tendsto_stoppedProcess_dyadicUp M ω (hcont ω) τ u
  have hfm : ∀ m : ℕ, AEStronglyMeasurable (stoppedProcess M (dyadicUp m τ) u) P :=
    fun m => hUI.aestronglyMeasurable m
  have hint : Integrable (stoppedProcess M τ u) P :=
    hUI.integrable_of_tendstoInMeasure (tendstoInMeasure_of_tendsto_ae hfm hlim)
  refine ⟨hint, tendsto_setIntegral_of_L1' _
    (Eventually.of_forall fun m => integrable_condExp.congr (hae m).symm) ?_ A⟩
  exact tendsto_Lp_finite_of_tendsto_ae le_rfl ENNReal.one_ne_top hfm (memLp_one_iff_integrable.2 hint)
    hUI.unifIntegrable hlim

theorem stoppedProcess_martingale_aux (hM : Martingale M ℱ P)
    (hcont : ∀ ω, Continuous fun t => M t ω) {τ : Ω → WithTop ℝ} (hτ : IsStoppingTime ℱ τ) :
    Martingale (stoppedProcess M τ) ℱ P := by
  have hadapt := hM.1.stoppedProcess hcont hτ
  refine ⟨hadapt, fun s t hst => ?_⟩
  refine (ae_eq_condExp_of_forall_setIntegral_eq (ℱ.le s)
    (tendsto_setIntegral_stoppedProcess_dyadicUp hM hcont hτ t ∅).1
    (fun A _ _ => (tendsto_setIntegral_stoppedProcess_dyadicUp hM hcont hτ s A).1.integrableOn)
    (fun A hA _ => ?_) (hadapt s).aestronglyMeasurable).symm
  have h1 := (tendsto_setIntegral_stoppedProcess_dyadicUp hM hcont hτ s A).2
  have h2 := (tendsto_setIntegral_stoppedProcess_dyadicUp hM hcont hτ t A).2
  have h3 : ∀ m : ℕ, ∫ ω in A, stoppedProcess M (dyadicUp m τ) s ω ∂P =
      ∫ ω in A, stoppedProcess M (dyadicUp m τ) t ω ∂P := fun m =>
    setIntegral_stoppedProcess_countable hM (isStoppingTime_dyadicUp ℱ hτ m)
      (countable_range_dyadicUp m τ) hst hA
  simp_rw [h3] at h1
  exact tendsto_nhds_unique h1 h2

end OptionalStopping

/-- Continuous-time optional stopping for continuous martingales: for a martingale `M` with
everywhere continuous paths and a stopping time `τ`, the stopped process `M_{t ∧ τ}` is a
martingale (optional sampling at bounded stopping times, by discrete approximation of `τ` from
above along dyadic grids and uniform integrability of `(M_s)_{s ≤ t}`). -/
theorem Martingale.stoppedProcess_of_continuous (P : Measure Ω) [IsProbabilityMeasure P]
    (ℱ : Filtration ℝ mΩ) (M : ℝ → Ω → ℝ) (hM : Martingale M ℱ P)
    (hcont : ∀ ω, Continuous fun t => M t ω) {τ : Ω → WithTop ℝ} (hτ : IsStoppingTime ℱ τ) :
    Martingale (stoppedProcess M τ) ℱ P :=
  stoppedProcess_martingale_aux hM hcont hτ

/-- Consequence: a continuous martingale stopped at a stopping time has constant expectation. -/
theorem Martingale.integral_stoppedProcess_of_continuous (P : Measure Ω) [IsProbabilityMeasure P]
    (ℱ : Filtration ℝ mΩ) (M : ℝ → Ω → ℝ) (hM : Martingale M ℱ P)
    (hcont : ∀ ω, Continuous fun t => M t ω) {τ : Ω → WithTop ℝ} (hτ : IsStoppingTime ℱ τ)
    (s t : ℝ) (hst : s ≤ t) :
    ∫ ω, stoppedProcess M τ t ω ∂P = ∫ ω, stoppedProcess M τ s ω ∂P := by
  have hN := Martingale.stoppedProcess_of_continuous P ℱ M hM hcont hτ
  calc ∫ ω, stoppedProcess M τ t ω ∂P
      = ∫ ω, (P[stoppedProcess M τ t | ℱ s]) ω ∂P := (integral_condExp (ℱ.le s)).symm
    _ = ∫ ω, stoppedProcess M τ s ω ∂P := integral_congr_ae (hN.2 s t hst)

/-! ### Partitions of an interval (used for quadratic variation along partitions) -/

/-- A partition `a = t_0 ≤ t_1 ≤ ⋯ ≤ t_n = b` of `[a, b]`. -/
structure Partition (a b : ℝ) where
  /-- number of subintervals -/
  n : ℕ
  /-- the partition points -/
  pt : Fin (n + 1) → ℝ
  mono : Monotone pt
  first : pt 0 = a
  last : pt (Fin.last n) = b

namespace Partition

variable {a b : ℝ} (π : Partition a b)

/-- The mesh `max_i (t_{i+1} - t_i)` (`0` for the trivial partition). -/
def mesh : ℝ := Finset.univ.sup' Finset.univ_nonempty (fun i : Fin (π.n + 1) =>
  if h : (i : ℕ) < π.n then π.pt ⟨i + 1, by omega⟩ - π.pt i else 0)

/-- The sum of `g` over the subintervals, `∑_i g (t_i) (t_{i+1})`. -/
def sumIncrements (g : ℝ → ℝ → ℝ) : ℝ :=
  ∑ i : Fin π.n, g (π.pt i.castSucc) (π.pt i.succ)

/-- The dyadic partition of `[a, b]` with `2^m` subintervals. -/
def dyadic (a b : ℝ) (hab : a ≤ b) (m : ℕ) : Partition a b where
  n := 2 ^ m
  pt i := a + (i : ℝ) * ((b - a) / 2 ^ m)
  mono := by
    intro i j hij
    have : (0 : ℝ) ≤ (b - a) / 2 ^ m := by
      have := sub_nonneg.2 hab
      positivity
    have hij' : ((i : ℕ) : ℝ) ≤ ((j : ℕ) : ℝ) := by exact_mod_cast hij
    simp only
    nlinarith
  first := by simp
  last := by
    simp only [Fin.val_last]
    push_cast
    field_simp
    ring

theorem mesh_le {c : ℝ} (hc : 0 ≤ c) (h : ∀ i : Fin π.n, π.pt i.succ - π.pt i.castSucc ≤ c) :
    π.mesh ≤ c := by
  unfold mesh
  refine Finset.sup'_le _ _ fun i _ => ?_
  by_cases hi : (i : ℕ) < π.n
  · simp only [hi, ↓reduceDIte]
    exact h ⟨i, hi⟩
  · simp only [hi, ↓reduceDIte]
    exact hc

theorem le_mesh (i : Fin π.n) : π.pt i.succ - π.pt i.castSucc ≤ π.mesh := by
  unfold mesh
  refine le_trans ?_ (Finset.le_sup' _ (Finset.mem_univ i.castSucc))
  have hi : ((i.castSucc : Fin (π.n + 1)) : ℕ) < π.n := i.isLt
  simp only [hi, ↓reduceDIte]
  exact le_rfl

theorem mesh_dyadic (a b : ℝ) (hab : a ≤ b) (m : ℕ) :
    (dyadic a b hab m).mesh = (b - a) / 2 ^ m := by
  have hd : (0 : ℝ) ≤ (b - a) / 2 ^ m := by
    have := sub_nonneg.2 hab
    positivity
  have hstep : ∀ i : Fin (dyadic a b hab m).n,
      (dyadic a b hab m).pt i.succ - (dyadic a b hab m).pt i.castSucc = (b - a) / 2 ^ m := by
    intro i
    show a + ((i.succ : ℕ) : ℝ) * ((b - a) / 2 ^ m) -
      (a + ((i.castSucc : ℕ) : ℝ) * ((b - a) / 2 ^ m)) = _
    rw [Fin.val_succ, Fin.val_castSucc]
    push_cast
    ring
  apply le_antisymm
  · exact mesh_le _ hd fun i => (hstep i).le
  · have h0 : 0 < (dyadic a b hab m).n := by
      show 0 < 2 ^ m
      positivity
    have := le_mesh (dyadic a b hab m) ⟨0, h0⟩
    rw [hstep] at this
    exact this

end Partition

end HRS
