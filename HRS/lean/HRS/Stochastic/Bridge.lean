import HRS.Stochastic.SDE
import HRS.Stochastic.DDS
import HRS.Dynamics.Setup

/-!
# Bridge to `HRS/Dynamics/Setup.lean`: Brownian families and the particle system

Package SI-01, bridging statements.  `Setup.lean` represents the `N` independent
`d`-dimensional Brownian motions as `W : ℝ≥0 → Ω → (Fin N → Euc d)` (`IsVectorBrownian`) and a
strong solution of the particle system pathwise on the covering space `(ℝ^d)^N`
(`IsStrongSolution`, ISSUES §D1).  Here:

* `exists_isBrownianFiltration_of_isVectorBrownian`: from `IsVectorBrownian P W` and a measurable
  initial datum `X₀` independent of `W` (the hypotheses of `particle_wellposed`), an everywhere
  continuous measurable modification `W'` indexed by `ι = Fin N × Fin d`, Brownian relative to
  the augmented generated filtration `σ(X₀) ⊔ σ(W'_s, s ≤ t) ⊔ nullSets P`.
* `isVectorBrownian_of_isBrownianFiltration`: the converse re-indexing.
* The lifted particle SDE on the covering space: drift `liftedDrift D Y = b(mk ∘ Y)`
  (`particleDrift` through `Torus.mk`), additive noise `liftedNoise D (i,j) = √(2 invβ) e_{i,j}`,
  state space `liftedFree d N = {Y | mk ∘ Y ∉ collisionSet d N}` (open).
* `isStrongSolution_of_sde`: a global collision-free strong solution of the lifted SDE
  (`IsAdditiveSDESolution` with `τ = ⊤`) projects to an `IsStrongSolution` for every horizon `T`
  (note: `IsStrongSolution.cont` demands continuity on all of `ℝ≥0` even for the `[0,T]`
  solution concept, so only global solutions can satisfy it; Proposition B.1 provides global
  ones).
* `IsStrongSolution.exists_lift_isPathSolution`: conversely, the lift of an `IsStrongSolution`
  is a pathwise solution on `[0, T)` of the lifted SDE for a.e. `ω` (for the uniqueness
  transfer).
* Reduction lemmas for `particle_wellposed` (Proposition B.1, M L11645-11656):
  `pathwiseUnique_of_locLipschitz` (uniqueness from local Lipschitz continuity of the lifted
  drift off the collision set — the analytic input KERN-01c must supply) and
  `exists_isStrongSolution_of_no_exit` (existence from the same input plus the "no exit from
  compacts of the collision-free set in finite time" property of the maximal solution, which is
  the cluster-dispersion argument of M L11759-11880).
-/

noncomputable section

open MeasureTheory Filter Topology ProbabilityTheory
open scoped ENNReal NNReal BigOperators

namespace HRS

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {d N : ℕ}

/-! ### Re-indexing of Brownian families -/

/-- `Fin N × Fin d`-indexed real coordinates of a `Fin N → Euc d`-valued family. -/
def toCoords (W : ℝ≥0 → Ω → (Fin N → Euc d)) : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ :=
  fun t ω ij => W t ω ij.1 ij.2

/-- The `Fin N → Euc d`-valued family of a `Fin N × Fin d`-indexed real family. -/
def ofCoords (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) : ℝ≥0 → Ω → (Fin N → Euc d) :=
  fun t ω i => WithLp.toLp 2 fun j => W' t ω (i, j)

theorem ofCoords_toCoords (W : ℝ≥0 → Ω → (Fin N → Euc d)) : ofCoords (toCoords W) = W := by
  funext t ω i
  rfl

theorem toCoords_ofCoords (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) : toCoords (ofCoords W') = W' := by
  funext t ω ij
  rfl

/-- A Brownian family relative to a filtration (coordinates `Fin N × Fin d`) is an
`IsVectorBrownian` family in the sense of `Setup.lean`. -/
theorem isVectorBrownian_of_isBrownianFiltration (P : Measure Ω) [IsProbabilityMeasure P]
    (ℱ : Filtration ℝ mΩ) (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) (hW' : IsBrownianFiltration P ℱ W') :
    IsVectorBrownian P (ofCoords W') :=
  ⟨fun i j => hW'.isBrownianReal (i, j), hW'.iIndepFun_coord⟩

/-- From the hypotheses of `particle_wellposed` (`IsVectorBrownian P W`, `X₀` measurable and
independent of `W`): an everywhere continuous measurable modification `W'` of the coordinates
of `W`, Brownian relative to the augmented filtration generated by `X₀` and `W'`, in which `X₀`
is measurable at every time. -/
theorem exists_isBrownianFiltration_of_isVectorBrownian (P : Measure Ω) [IsProbabilityMeasure P]
    (W : ℝ≥0 → Ω → (Fin N → Euc d)) (hW : IsVectorBrownian P W)
    {E : Type*} [MeasurableSpace E] (X₀ : Ω → E) (hX₀ : Measurable X₀)
    (hind : IndepFun X₀ (fun ω => fun t => W t ω) P) :
    ∃ (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) (hW' : ∀ t, Measurable (W' t)),
      (∀ᵐ ω ∂P, ∀ t i j, W' t ω (i, j) = W t ω i j) ∧
      IsBrownianFiltration P (generatedFiltration P X₀ hX₀ W' hW') W' ∧
      ∀ t : ℝ, Measurable[generatedFiltration P X₀ hX₀ W' hW' t] X₀ := by
  have hmeas : Measurable (fun (f : ℝ≥0 → Fin N → Euc d) => fun t (ij : Fin N × Fin d) =>
      f t ij.1 ij.2) := by
    refine measurable_pi_iff.2 fun t => measurable_pi_iff.2 fun ij => ?_
    exact ((EuclideanSpace.proj ij.2).continuous.measurable).comp
      ((measurable_pi_apply ij.1).comp (measurable_pi_apply t))
  have hind' : IndepFun X₀ (fun ω => fun t => toCoords W t ω) P :=
    hind.comp measurable_id hmeas
  obtain ⟨W', hW'm, hae, hBF⟩ := exists_isBrownianFiltration P (toCoords W)
    (fun k => hW.1 k.1 k.2) hW.2 X₀ hX₀ hind'
  refine ⟨W', hW'm, ?_, hBF, generatedFiltration_measurable_init P X₀ hX₀ W' hW'm⟩
  filter_upwards [hae] with ω h t i j
  exact congrFun (h t) (i, j)

/-! ### The lifted particle SDE -/

/-- The particle drift on the covering space: `b_i(mk ∘ Y)`. -/
def liftedDrift (D : DynData d) (Y : Fin N → Euc d) : Fin N → Euc d :=
  fun i => particleDrift D (fun i => Torus.mk (Y i)) i

/-- The additive noise coefficients `σ_{(i,j)} = √(2 invβ) e_{i,j}`. -/
def liftedNoise (D : DynData d) (ij : Fin N × Fin d) : Fin N → Euc d :=
  Real.sqrt (2 * D.invβ) • Pi.single ij.1 (EuclideanSpace.single ij.2 1)

/-- The collision-free region of the covering space. -/
def liftedFree (d N : ℕ) : Set (Fin N → Euc d) :=
  {Y | (fun i => Torus.mk (Y i)) ∉ collisionSet d N}

theorem isClosed_collisionSet (d N : ℕ) : IsClosed (collisionSet d N) := by
  have : collisionSet d N = ⋃ i, ⋃ j, ⋃ _ : i ≠ j, {X : Config d N | X i = X j} := by
    ext X; simp [collisionSet]
  rw [this]
  refine isClosed_iUnion_of_finite fun i => isClosed_iUnion_of_finite fun j =>
    isClosed_iUnion_of_finite fun _ => ?_
  exact isClosed_eq (continuous_apply i) (continuous_apply j)

theorem continuous_mkPi (d N : ℕ) :
    Continuous (fun (Y : Fin N → Euc d) => fun i => Torus.mk (Y i)) :=
  continuous_pi fun i => Torus.continuous_mk.comp (continuous_apply i)

theorem isOpen_liftedFree (d N : ℕ) : IsOpen (liftedFree d N) :=
  (isClosed_collisionSet d N).isOpen_compl.preimage (continuous_mkPi d N)

/-- `∑_{(i,j)} W'^{(i,j)}_t σ_{(i,j)} = √(2 invβ) • (ofCoords W') t`. -/
theorem sum_liftedNoise (D : DynData d) (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) (t : ℝ≥0) (ω : Ω) :
    ∑ ij, W' t ω ij • liftedNoise (N := N) D ij = Real.sqrt (2 * D.invβ) • ofCoords W' t ω := by
  funext i
  ext j
  simp [liftedNoise, ofCoords, Pi.single_apply, Fintype.sum_prod_type,
    Finset.sum_apply, mul_comm]

theorem continuous_nnreal_of_continuousOn_Icc {F : Type*} [TopologicalSpace F] (f : ℝ → F)
    (h : ∀ t : ℝ, 0 ≤ t → ContinuousOn f (Set.Icc 0 t)) :
    Continuous fun t : ℝ≥0 => f (t : ℝ) := by
  have hc : ContinuousOn f (Set.Ici 0) := by
    intro x hx
    have hx' : (0 : ℝ) ≤ x := hx
    have h1 := (h (x + 1) (by linarith)) x ⟨hx', by linarith⟩
    refine h1.mono_of_mem_nhdsWithin ?_
    exact mem_nhdsWithin.2 ⟨Set.Iio (x + 1), isOpen_Iio, by simp,
      fun y hy => ⟨hy.2, hy.1.le⟩⟩
  exact hc.comp_continuous NNReal.continuous_coe (fun t => t.2)

/-- A global collision-free strong solution of the lifted SDE projects to an `IsStrongSolution`
of the particle system for every horizon `T`, with respect to the original Brownian family `W`
(of which `W'` is an indistinguishable modification). -/
theorem isStrongSolution_of_sde (P : Measure Ω) [IsProbabilityMeasure P] (ℱ : Filtration ℝ mΩ)
    (D : DynData d) (W : ℝ≥0 → Ω → (Fin N → Euc d)) (hW : IsVectorBrownian P W)
    (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ) (hW' : IsBrownianFiltration P ℱ W')
    (hWW' : ∀ᵐ ω ∂P, ∀ t i j, W' t ω (i, j) = W t ω i j)
    (Y₀ : Ω → (Fin N → Euc d)) (Y : ℝ → Ω → (Fin N → Euc d))
    (hY : IsAdditiveSDESolution P ℱ W' (fun _ Z => liftedDrift D Z) (liftedNoise D) Y₀
      (fun _ => ⊤) Y)
    (hfree : ∀ᵐ ω ∂P, ∀ t : ℝ, 0 ≤ t → Y t ω ∈ liftedFree d N) (T : ℝ) :
    IsStrongSolution P D T (fun ω i => Torus.mk (Y₀ ω i)) W
      (projectPath fun t ω => Y (t : ℝ) ω) := by
  have hW0 : ∀ᵐ ω ∂P, ∀ i j, W 0 ω i j = 0 := by
    filter_upwards [hWW'] with ω h i j
    rw [← h 0 i j, hW'.zero ω]; rfl
  have hofC : ∀ ω, (∀ t i j, W' t ω (i, j) = W t ω i j) → ∀ t i, ofCoords W' t ω i = W t ω i := by
    intro ω h t i
    ext j
    exact h t i j
  refine ⟨⟨fun t ω => Y (t : ℝ) ω, ?_, rfl⟩, ?_, ?_, ?_, ?_⟩
  · filter_upwards [hY.eq, hWW', hW0] with ω hω hw hw0 t _
    have hdr : ∀ s : ℝ, s ∈ Set.Icc (0 : ℝ) t → ∀ i,
        particleDrift D (projectPath (fun t ω => Y (t : ℝ) ω) (Real.toNNReal s) ω) i =
          liftedDrift D (Y s ω) i := by
      intro s hs i
      have : ((Real.toNNReal s : ℝ≥0) : ℝ) = s := Real.coe_toNNReal _ hs.1
      show particleDrift D (fun j => Torus.mk (Y ((Real.toNNReal s : ℝ≥0) : ℝ) ω j)) i =
        particleDrift D (fun j => Torus.mk (Y s ω j)) i
      rw [this]
    obtain ⟨hint, heq⟩ := hω t t.2 (WithTop.coe_lt_top _)
    refine ⟨fun i => ?_, fun i => ?_⟩
    · have : IntegrableOn (fun s => liftedDrift D (Y s ω) i) (Set.Icc 0 (t : ℝ)) :=
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin N => Euc d) i).integrable_comp hint
      exact this.congr_fun (fun s hs => (hdr s hs i).symm) measurableSet_Icc
    · have h1 := congrFun heq i
      have hnoise : ∑ k, ofNNRealTime W' (t : ℝ) ω k • liftedNoise (N := N) D k =
          Real.sqrt (2 * D.invβ) • W t ω := by
        have e : ofNNRealTime W' (t : ℝ) ω = W' t ω := by
          simp [ofNNRealTime, Real.toNNReal_coe]
        rw [e, sum_liftedNoise]
        congr 1
        funext i
        exact hofC ω hw t i
      rw [hnoise] at h1
      have h2 : (∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y s ω)) i =
          ∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y s ω) i := by
        have := (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin N => Euc d) i).integral_comp_comm
          hint
        simpa using this.symm
      have h3 : (∫ s in Set.Icc (0 : ℝ) t,
          particleDrift D (projectPath (fun t ω => Y (t : ℝ) ω) (Real.toNNReal s) ω) i) =
          ∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y s ω) i :=
        setIntegral_congr_fun measurableSet_Icc (fun s hs => hdr s hs i)
      have hW0i : W 0 ω i = 0 := by
        ext j; exact hw0 i j
      rw [h3, hW0i, sub_zero]
      have h4 : Y ((0 : ℝ≥0) : ℝ) ω i = Y₀ ω i := by
        rw [NNReal.coe_zero, hY.init ω]
      rw [h4]
      simpa [h2, add_assoc] using h1
  · refine Eventually.of_forall fun ω => ?_
    funext i
    show Torus.mk (Y ((0 : ℝ≥0) : ℝ) ω i) = Torus.mk (Y₀ ω i)
    rw [NNReal.coe_zero, hY.init ω]
  · refine Eventually.of_forall fun ω i => ?_
    exact Torus.continuous_mk.comp ((continuous_apply i).comp
      (continuous_nnreal_of_continuousOn_Icc (fun s => Y s ω)
        (fun t ht => hY.cont ω t ht (WithTop.coe_lt_top _))))
  · intro t
    have hm : Measurable (Y (t : ℝ)) := (hY.adapted (t : ℝ)).mono (ℱ.le _) le_rfl
    exact measurable_pi_iff.2 fun i =>
      Torus.continuous_mk.measurable.comp ((measurable_pi_apply i).comp hm)
  · filter_upwards [hfree] with ω h t _
    exact h (t : ℝ) t.2

theorem IsVectorBrownian.ae_cont {P : Measure Ω} [IsProbabilityMeasure P]
    {W : ℝ≥0 → Ω → (Fin N → Euc d)} (hW : IsVectorBrownian P W) :
    ∀ᵐ ω ∂P, Continuous fun t => toCoords W t ω := by
  have := ae_all_iff.2 fun i => ae_all_iff.2 fun j => (hW.1 i j).cont
  filter_upwards [this] with ω h
  exact continuous_pi fun ij => h ij.1 ij.2

theorem IsVectorBrownian.ae_zero {P : Measure Ω} [IsProbabilityMeasure P]
    {W : ℝ≥0 → Ω → (Fin N → Euc d)} (hW : IsVectorBrownian P W) :
    ∀ᵐ ω ∂P, ∀ i j, W 0 ω i j = 0 := by
  refine ae_all_iff.2 fun i => ae_all_iff.2 fun j => ?_
  filter_upwards [(hW.1 i j).toIsPreBrownianReal.eval_zero_ae_eq_zero] with ω h using h

/-- The lift of an `IsStrongSolution` on `[0, T]` is, for a.e. `ω`, a pathwise solution of the
lifted SDE on `[0, T)` with values in the collision-free region. -/
theorem IsStrongSolution.exists_lift_isPathSolution (P : Measure Ω) [IsProbabilityMeasure P]
    (D : DynData d) (T : ℝ) (X₀ : Ω → Config d N) (W : ℝ≥0 → Ω → (Fin N → Euc d))
    (hW : IsVectorBrownian P W) (X : ℝ≥0 → Ω → Config d N) (hX : IsStrongSolution P D T X₀ W X) :
    ∃ Y : ℝ≥0 → Ω → (Fin N → Euc d), X = projectPath Y ∧
      ∀ᵐ ω ∂P, IsPathSolution (fun _ Z => liftedDrift D Z) (liftedNoise D)
        (fun t => toCoords W t ω) (Y 0 ω) (T : WithTop ℝ) (fun t => Y (Real.toNNReal t) ω) ∧
        ∀ t : ℝ, 0 ≤ t → t ≤ T → Y (Real.toNNReal t) ω ∈ liftedFree d N := by
  obtain ⟨⟨Y, hYeq, rfl⟩, hinit, hcont, hadapted, hnocoll⟩ := hX
  refine ⟨Y, rfl, ?_⟩
  filter_upwards [hYeq, hW.ae_cont, hW.ae_zero, hnocoll] with ω hω hwc hw0 hnc
  -- integrability and the integral equation, in the space `Fin N → Euc d`
  have key : ∀ t : ℝ≥0, (t : ℝ) ≤ T →
      IntegrableOn (fun s : ℝ => liftedDrift D (Y (Real.toNNReal s) ω)) (Set.Icc 0 (t : ℝ)) ∧
      Y t ω = Y 0 ω + (∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y (Real.toNNReal s) ω)) +
        ∑ k, toCoords W t ω k • liftedNoise (N := N) D k := by
    intro t ht
    obtain ⟨hint, heq⟩ := hω t ht
    have hintE : IntegrableOn (fun s : ℝ => liftedDrift D (Y (Real.toNNReal s) ω))
        (Set.Icc 0 (t : ℝ)) := Integrable.of_eval hint
    refine ⟨hintE, ?_⟩
    have hnoise : ∑ k, toCoords W t ω k • liftedNoise (N := N) D k =
        Real.sqrt (2 * D.invβ) • W t ω := by
      rw [sum_liftedNoise, ofCoords_toCoords]
    rw [hnoise]
    funext i
    have h2 : (∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y (Real.toNNReal s) ω)) i =
        ∫ s in Set.Icc (0 : ℝ) t, liftedDrift D (Y (Real.toNNReal s) ω) i := by
      have := (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin N => Euc d) i).integral_comp_comm
        hintE
      simpa using this.symm
    have hW0i : W 0 ω i = 0 := by
      ext j; exact hw0 i j
    have h1 := heq i
    rw [hW0i, sub_zero] at h1
    simp only [Pi.add_apply, Pi.smul_apply]
    rw [h2]
    exact h1
  have hy0 : Y (Real.toNNReal 0) ω = Y 0 ω := by simp
  refine ⟨⟨hy0, fun t ht htT => ?_⟩, fun t ht htT => ?_⟩
  · have htT' : t ≤ T := by exact_mod_cast htT.le
    have hcoe : ((Real.toNNReal t : ℝ≥0) : ℝ) = t := Real.coe_toNNReal _ ht
    obtain ⟨hint, heq⟩ := key (Real.toNNReal t) (by rw [hcoe]; exact htT')
    rw [hcoe] at hint heq
    refine ⟨?_, hint, ?_⟩
    · -- continuity on `[0, t]`
      have hF : ContinuousOn (fun s : ℝ => Y 0 ω + (∫ u in (0 : ℝ)..s, liftedDrift D (Y (Real.toNNReal u) ω))
          + addNoise (liftedNoise (N := N) D) (fun t => toCoords W t ω) s) (Set.Icc 0 t) := by
        refine (continuousOn_const.add ?_).add
          (continuous_addNoise (liftedNoise (N := N) D) hwc).continuousOn
        have := intervalIntegral.continuousOn_primitive_interval (a := 0) (b := t)
          (μ := volume) (f := fun u => liftedDrift D (Y (Real.toNNReal u) ω))
          (by rwa [Set.uIcc_of_le ht])
        rwa [Set.uIcc_of_le ht] at this
      refine hF.congr fun s hs => ?_
      have hs0 : 0 ≤ s := hs.1
      have hcs : ((Real.toNNReal s : ℝ≥0) : ℝ) = s := Real.coe_toNNReal _ hs0
      obtain ⟨_, heqs⟩ := key (Real.toNNReal s) (by rw [hcs]; exact hs.2.trans htT')
      rw [hcs] at heqs
      rw [heqs, setIntegral_Icc_eq_interval hs0]
      rfl
    · exact heq
  · have hnc' := hnc (Real.toNNReal t) (by rw [Real.coe_toNNReal _ ht]; exact htT)
    exact hnc'

theorem mk_sub' (x y : Euc d) : Torus.mk (x - y) = Torus.mk x - Torus.mk y := by
  funext i; simp [Torus.mk]

/-- Translating a covering-space configuration by a vector projecting to `0` does not change its
projection. -/
theorem mkPi_sub_of_mk_eq_zero (Y c : Fin N → Euc d) (hc : ∀ i, Torus.mk (c i) = 0) :
    (fun i => Torus.mk ((Y - c) i)) = fun i => Torus.mk (Y i) := by
  funext i
  simp [mk_sub', hc i]

theorem liftedDrift_sub_of_mk_eq_zero (D : DynData d) (Y c : Fin N → Euc d)
    (hc : ∀ i, Torus.mk (c i) = 0) : liftedDrift D (Y - c) = liftedDrift D Y := by
  unfold liftedDrift
  rw [mkPi_sub_of_mk_eq_zero Y c hc]

theorem eq_of_forall_lt_of_continuous {α : Type*} [TopologicalSpace α] [T2Space α] {F G : ℝ≥0 → α}
    (hF : Continuous F) (hG : Continuous G) (t : ℝ≥0) (h0 : F 0 = G 0)
    (h : ∀ u < t, F u = G u) : F t = G t := by
  rcases eq_or_ne t 0 with rfl | ht
  · exact h0
  · have hne : (Set.Iio t).Nonempty := ⟨0, pos_iff_ne_zero.2 ht⟩
    have := Set.EqOn.closure (s := Set.Iio t) (f := F) (g := G) (fun u hu => h u hu) hF hG
    rw [closure_Iio' hne] at this
    exact this (Set.mem_Iic.2 le_rfl)

/-- **Reduction for pathwise uniqueness** (Proposition B.1): if the lifted drift is continuous
and locally Lipschitz on the collision-free region, the particle system is pathwise unique among
collision-free strong solutions (`PathwiseUnique` of `Setup.lean`).  The Lipschitz input is the
regularity of `∇g` off the diagonal (KERN-01c) and `V ∈ C²`. -/
theorem pathwiseUnique_of_locLipschitz (P : Measure Ω) [IsProbabilityMeasure P] (D : DynData d)
    (hb : IsLocLipschitzDrift (liftedFree d N) (fun _ Z => liftedDrift D Z)) (T : ℝ)
    (X₀ : Ω → Config d N) (W : ℝ≥0 → Ω → (Fin N → Euc d)) (hW : IsVectorBrownian P W) :
    PathwiseUnique P D T X₀ W := by
  intro X X' hX hX'
  obtain ⟨Y, rfl, hY⟩ := IsStrongSolution.exists_lift_isPathSolution P D T X₀ W hW X hX
  obtain ⟨Y', rfl, hY'⟩ := IsStrongSolution.exists_lift_isPathSolution P D T X₀ W hW X' hX'
  filter_upwards [hY, hY', hX.init, hX'.init, hX.cont, hX'.cont, hW.ae_cont] with ω hp hp' hi hi'
    hc hc' hwc
  obtain ⟨⟨hp0, hp1⟩, hf⟩ := hp
  obtain ⟨⟨hp0', hp1'⟩, hf'⟩ := hp'
  set c : Fin N → Euc d := Y' 0 ω - Y 0 ω with hcdef
  have hmk : ∀ i, Torus.mk (c i) = 0 := by
    intro i
    have h1 := congrFun (hi.trans hi'.symm) i
    have h2 : Torus.mk (Y 0 ω i) = Torus.mk (Y' 0 ω i) := h1
    simp [hcdef, mk_sub', h2]
  have hZ : IsPathSolution (fun _ Z => liftedDrift D Z) (liftedNoise D)
      (fun t => toCoords W t ω) (Y 0 ω) (T : WithTop ℝ)
      (fun t => Y' (Real.toNNReal t) ω - c) := by
    refine ⟨?_, fun t ht htT => ?_⟩
    · simp only [Real.toNNReal_zero, hcdef]
      abel
    · obtain ⟨h1, h2, h3⟩ := hp1' t ht htT
      have hd : ∀ s, liftedDrift D (Y' (Real.toNNReal s) ω - c) =
          liftedDrift D (Y' (Real.toNNReal s) ω) := fun s =>
        liftedDrift_sub_of_mk_eq_zero D _ c hmk
      refine ⟨h1.sub continuousOn_const, ?_, ?_⟩
      · simpa only [hd] using h2
      · simp only [hd]
        have h3' : Y' (Real.toNNReal t) ω = (Y' 0 ω + ∫ s in Set.Icc (0 : ℝ) t,
            liftedDrift D (Y' (Real.toNNReal s) ω)) +
            ∑ k, toCoords W (Real.toNNReal t) ω k • liftedNoise (N := N) D k := h3
        show Y' (Real.toNNReal t) ω - c = _
        rw [h3', hcdef]
        abel
  have hZU : ∀ t : ℝ, 0 ≤ t → (t : WithTop ℝ) < (T : WithTop ℝ) →
      (Y' (Real.toNNReal t) ω - c) ∈ liftedFree d N := by
    intro t ht htT
    have := hf' t ht (by exact_mod_cast htT.le)
    show (fun i => Torus.mk ((Y' (Real.toNNReal t) ω - c) i)) ∉ collisionSet d N
    rw [mkPi_sub_of_mk_eq_zero _ c hmk]
    exact this
  have huniq := ode_additive_unique (liftedFree d N) (isOpen_liftedFree d N)
    (fun _ Z => liftedDrift D Z) hb (liftedNoise D) (fun t => toCoords W t ω) hwc (Y 0 ω)
    (τ := (T : WithTop ℝ)) (τ' := (T : WithTop ℝ)) ⟨hp0, hp1⟩ hZ
    (fun t ht htT => hf t ht (by exact_mod_cast htT.le)) hZU
  have hFc : Continuous fun t : ℝ≥0 => projectPath Y t ω := continuous_pi hc
  have hGc : Continuous fun t : ℝ≥0 => projectPath Y' t ω := continuous_pi hc'
  intro t ht
  refine eq_of_forall_lt_of_continuous hFc hGc t (hi.trans hi'.symm) fun u hu => ?_
  have hu' : (u : ℝ) < t := by exact_mod_cast hu
  have := huniq (u : ℝ) u.2 (by rw [min_self]; exact_mod_cast hu'.trans_le ht)
  simp only [Real.toNNReal_coe] at this
  show (fun i => Torus.mk (Y u ω i)) = fun i => Torus.mk (Y' u ω i)
  rw [this]
  exact mkPi_sub_of_mk_eq_zero _ c hmk

theorem measurable_torusRep (d : ℕ) : Measurable (Torus.rep : Torus d → Euc d) := by
  have h : Measurable (fun (x : Torus d) (i : Fin d) =>
      ((AddCircle.equivIco (1 : ℝ) 0 (x i) : Set.Ico (0 : ℝ) (0 + 1)) : ℝ)) :=
    measurable_pi_iff.2 fun i => measurable_subtype_coe.comp
      ((AddCircle.measurableEquivIco (1 : ℝ) 0).measurable.comp (measurable_pi_apply i))
  exact (WithLp.measurable_toLp 2 _).comp h

/-- **Reduction for existence** (Proposition B.1): with the lifted drift locally Lipschitz on the
collision-free region, and given that every maximal collision-free solution of the lifted SDE
(for every Brownian filtration carrying `X₀`) has infinite lifetime a.s. — the content of the
cluster-dispersion argument, M L11759-11880 — the particle system has a global collision-free
strong solution. -/
theorem exists_isStrongSolution_of_no_exit (P : Measure Ω) [IsProbabilityMeasure P] (D : DynData d)
    (hb : IsLocLipschitzDrift (liftedFree d N) (fun _ Z => liftedDrift D Z))
    (X₀ : Ω → Config d N) (hX₀ : Measurable X₀) (hdist : ∀ᵐ ω ∂P, X₀ ω ∉ collisionSet d N)
    (W : ℝ≥0 → Ω → (Fin N → Euc d)) (hW : IsVectorBrownian P W)
    (hind : IndepFun X₀ (fun ω => fun t => W t ω) P)
    (hnoexit : ∀ (ℱ : Filtration ℝ mΩ) (W' : ℝ≥0 → Ω → (Fin N × Fin d) → ℝ),
      IsBrownianFiltration P ℱ W' → (∀ᵐ ω ∂P, ∀ t i j, W' t ω (i, j) = W t ω i j) →
      ∀ (Y₀ : Ω → (Fin N → Euc d)), (∀ t : ℝ, Measurable[ℱ t] Y₀) →
      (∀ᵐ ω ∂P, (fun i => Torus.mk (Y₀ ω i)) = X₀ ω) →
      ∀ (τ : Ω → WithTop ℝ) (Y : ℝ → Ω → (Fin N → Euc d)), IsStoppingTime ℱ τ →
      (∀ ω, 0 < τ ω) →
      IsAdditiveSDESolution P ℱ W' (fun _ Z => liftedDrift D Z) (liftedNoise D) Y₀ τ Y →
      (∀ ω, ∀ t : ℝ, 0 ≤ t → (t : WithTop ℝ) < τ ω → Y t ω ∈ liftedFree d N) →
      (∀ ω, τ ω < ⊤ → ∀ K : Set (Fin N → Euc d), IsCompact K → K ⊆ liftedFree d N →
        ∀ t₀ : ℝ, (t₀ : WithTop ℝ) < τ ω → ∃ t : ℝ, t₀ < t ∧ (t : WithTop ℝ) < τ ω ∧ Y t ω ∉ K) →
      ∀ᵐ ω ∂P, τ ω = ⊤)
    (T : ℝ) : ∃ X, IsStrongSolution P D T X₀ W X := by
  classical
  obtain ⟨W', hW'm, hWW', hBF, hX₀ℱ⟩ :=
    exists_isBrownianFiltration_of_isVectorBrownian P W hW X₀ hX₀ hind
  set ℱ := generatedFiltration P X₀ hX₀ W' hW'm with hℱ
  obtain ⟨ω₀, hω₀⟩ : ∃ ω₀, X₀ ω₀ ∉ collisionSet d N := hdist.exists
  let rep : Ω → Fin N → Euc d := fun ω i => Torus.rep (X₀ ω i)
  have hmk : ∀ ω, (fun i => Torus.mk (rep ω i)) = X₀ ω := fun ω =>
    funext fun i => Torus.mk_rep _
  have hcoll : MeasurableSet (collisionSet d N) := (isClosed_collisionSet d N).measurableSet
  let Y₀ : Ω → Fin N → Euc d := fun ω => if X₀ ω ∈ collisionSet d N then rep ω₀ else rep ω
  have hY₀m : ∀ t : ℝ, Measurable[ℱ t] Y₀ := by
    intro t
    let _ : MeasurableSpace Ω := ℱ t
    have hrep : Measurable rep := measurable_pi_iff.2 fun i =>
      (measurable_torusRep d).comp ((measurable_pi_apply i).comp (hX₀ℱ t))
    exact Measurable.ite (hX₀ℱ t hcoll) measurable_const hrep
  have hY₀0 : ∀ ω, Y₀ ω ∈ liftedFree d N := by
    intro ω
    show (fun i => Torus.mk (Y₀ ω i)) ∉ collisionSet d N
    by_cases h : X₀ ω ∈ collisionSet d N
    · simp only [Y₀, h, ↓reduceIte]
      rw [hmk ω₀]
      exact hω₀
    · simp only [Y₀, h, ↓reduceIte]
      rw [hmk ω]
      exact h
  have hY₀ae : ∀ᵐ ω ∂P, (fun i => Torus.mk (Y₀ ω i)) = X₀ ω := by
    filter_upwards [hdist] with ω h
    simp only [Y₀, h, ↓reduceIte]
    exact hmk ω
  obtain ⟨τ, Y, hstop, hpos, hsol, hmem, hexit, hmax⟩ := exists_sde_solution_maximal hBF
    (liftedFree d N) (isOpen_liftedFree d N) (fun _ Z => liftedDrift D Z) hb (liftedNoise D) Y₀
    hY₀m hY₀0
  have htop : ∀ᵐ ω ∂P, τ ω = ⊤ :=
    hnoexit ℱ W' hBF hWW' Y₀ hY₀m hY₀ae τ Y hstop hpos hsol hmem hexit
  -- redefine on the null set `{τ ≠ ⊤}`
  have hAmeas : MeasurableSet {ω | τ ω ≠ ⊤} := by
    have : {ω | τ ω ≠ ⊤} = ⋃ n : ℕ, {ω | τ ω ≤ ((n : ℝ) : WithTop ℝ)} := by
      ext ω
      simp only [Set.mem_ofPred_eq, Set.mem_iUnion]
      constructor
      · intro h
        obtain ⟨r, hr⟩ := WithTop.ne_top_iff_exists.1 h
        obtain ⟨n, hn⟩ := exists_nat_ge r
        exact ⟨n, by rw [← hr]; exact_mod_cast hn⟩
      · rintro ⟨n, hn⟩ h
        rw [h] at hn
        exact absurd hn (by simp)
    rw [this]
    exact MeasurableSet.iUnion fun n => ℱ.le _ _ (hstop (n : ℝ))
  have hA0 : P {ω | τ ω ≠ ⊤} = 0 := ae_iff.1 htop
  have hAt : ∀ t : ℝ, MeasurableSet[ℱ t] {ω | τ ω = ⊤} := fun t => by
    have := (hBF.complete t _ hAmeas hA0).compl
    have e : {ω | τ ω = ⊤} = {ω | τ ω ≠ ⊤}ᶜ := by ext ω; simp
    rw [e]
    exact this
  let Yg : ℝ → Ω → Fin N → Euc d := fun t ω => if τ ω = ⊤ then Y t ω else Y₀ ω
  have hsolTop : IsAdditiveSDESolution P ℱ W' (fun _ Z => liftedDrift D Z) (liftedNoise D) Y₀
      (fun _ => ⊤) Yg := by
    refine ⟨fun t => ?_, fun ω => ?_, fun ω t ht _ => ?_, ?_⟩
    · let _ : MeasurableSpace Ω := ℱ t
      exact Measurable.ite (hAt t) (hsol.adapted t) (hY₀m t)
    · by_cases h : τ ω = ⊤
      · simp only [Yg, h, ↓reduceIte]; exact hsol.init ω
      · simp only [Yg, h, ↓reduceIte]
    · by_cases h : τ ω = ⊤
      · simp only [Yg, h, ↓reduceIte]
        exact hsol.cont ω t ht (by rw [h]; exact WithTop.coe_lt_top _)
      · simp only [Yg, h, ↓reduceIte]
        exact continuousOn_const
    · filter_upwards [hsol.eq, htop] with ω h1 h2 t ht _
      simp only [Yg, h2, ↓reduceIte]
      exact h1 t ht (by rw [h2]; exact WithTop.coe_lt_top _)
  have hfree : ∀ᵐ ω ∂P, ∀ t : ℝ, 0 ≤ t → Yg t ω ∈ liftedFree d N := by
    filter_upwards [htop] with ω h t ht
    simp only [Yg, h, ↓reduceIte]
    exact hmem ω t ht (by rw [h]; exact WithTop.coe_lt_top _)
  have hS := isStrongSolution_of_sde P ℱ D W hW W' hBF hWW' Y₀ Yg hsolTop hfree T
  refine ⟨_, { hS with init := ?_ }⟩
  filter_upwards [hS.init, hY₀ae] with ω h1 h2
  rw [h1]
  exact h2

end HRS
